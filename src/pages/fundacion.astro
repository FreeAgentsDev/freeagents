---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DynamicBackground from '../components/DynamicBackground.astro';
---

<Layout title="Fundación FreeAgents - Impulsando el Talento Tech del Futuro" description="Conoce la Fundación FreeAgents: programas de mentoría, capacitación y oportunidades para desarrolladores. Construyendo el futuro del talento tecnológico.">
  <Header />
  
  <main class="pt-20 relative min-h-screen overflow-hidden">
    <!-- Fondo Dinámico Potente para Toda la Vista -->
    <div class="fixed inset-0 -z-10">
      <DynamicBackground type="neural" color="purple" />
      <DynamicBackground type="particles" color="pink" />
      <DynamicBackground type="circuits" color="purple" />
      
      <!-- Gradientes Animados Múltiples -->
      <div class="absolute inset-0">
        <div class="absolute top-0 left-0 w-full h-full bg-gradient-to-br from-purple-900/30 via-pink-900/20 to-blue-900/30 animate-pulse"></div>
        <div class="absolute top-1/4 right-1/4 w-96 h-96 bg-neon-purple/20 rounded-full blur-3xl animate-pulse"></div>
        <div class="absolute bottom-1/4 left-1/4 w-96 h-96 bg-neon-pink/20 rounded-full blur-3xl animate-pulse" style="animation-delay: 1s;"></div>
        <div class="absolute top-1/2 right-1/3 w-96 h-96 bg-neon-blue/15 rounded-full blur-3xl animate-pulse" style="animation-delay: 0.5s;"></div>
      </div>
      
      <!-- Grid Pattern Overlay -->
      <div class="absolute inset-0 opacity-10" style="background-image: linear-gradient(rgba(139, 92, 246, 0.2) 1px, transparent 1px), linear-gradient(90deg, rgba(236, 72, 153, 0.2) 1px, transparent 1px); background-size: 50px 50px; animation: grid-move 20s linear infinite;"></div>
    </div>

    <!-- Hero Section Única con Animaciones Premium -->
    <section class="relative min-h-[70vh] flex items-center justify-center overflow-hidden">
      
      <!-- Floating Elements -->
      <div class="absolute inset-0 pointer-events-none">
        <div class="absolute top-20 left-10 w-3 h-3 bg-neon-purple rounded-full animate-float opacity-60"></div>
        <div class="absolute top-40 right-20 w-2 h-2 bg-neon-pink rounded-full animate-float opacity-60" style="animation-delay: 0.7s;"></div>
        <div class="absolute bottom-32 left-1/4 w-4 h-4 bg-neon-blue rounded-full animate-float opacity-60" style="animation-delay: 1.4s;"></div>
        <div class="absolute bottom-20 right-1/3 w-2 h-2 bg-neon-green rounded-full animate-float opacity-60" style="animation-delay: 2.1s;"></div>
      </div>

      <div class="relative z-10 container mx-auto px-6 py-12">
        <div class="max-w-7xl mx-auto">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
            <!-- Hero Image a la izquierda -->
            <div class="order-2 lg:order-1 relative flex justify-center lg:justify-start">
              <div class="relative group">
                <!-- Glow Effects Múltiples -->
                <div class="absolute -inset-4 bg-gradient-to-r from-neon-purple/40 via-neon-pink/40 to-neon-blue/40 rounded-3xl blur-2xl opacity-50 group-hover:opacity-75 transition-opacity duration-500 animate-pulse"></div>
                <div class="absolute -inset-2 bg-gradient-to-r from-neon-purple/20 to-neon-pink/20 rounded-3xl blur-xl"></div>
                
                <!-- Main Image Container con Glassmorphism -->
                <div class="relative bg-gradient-to-br from-gray-800/80 via-purple-900/20 to-gray-900/80 backdrop-blur-xl rounded-3xl p-10 border border-purple-500/30 shadow-2xl group-hover:border-purple-400/50 transition-all duration-500">
                  <!-- Decorative Grid Pattern -->
                  <div class="absolute inset-0 opacity-10" style="background-image: linear-gradient(rgba(139, 92, 246, 0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(139, 92, 246, 0.1) 1px, transparent 1px); background-size: 20px 20px;"></div>
                  
                  <div class="relative">
                    <img 
                      src="/freeagentsfoundation.png" 
                      alt="Fundación FreeAgents" 
                      class="h-96 w-auto mx-auto rounded-2xl drop-shadow-2xl group-hover:scale-105 transition-transform duration-500"
                    >
                    
                    <!-- Floating Badges -->
                    <div class="absolute -top-6 -right-6 bg-gradient-to-r from-neon-purple to-neon-pink px-4 py-2 rounded-full shadow-xl">
                      <span class="text-white font-bold text-xs">IMPACTO SOCIAL</span>
                    </div>
                    <div class="absolute -bottom-6 -left-6 bg-gradient-to-r from-neon-blue to-neon-green px-4 py-2 rounded-full shadow-xl">
                      <span class="text-white font-bold text-xs">TALENTO TECH</span>
                    </div>
                  </div>
                  
                  <!-- Animated Orbs -->
                  <div class="absolute top-4 right-4 w-3 h-3 bg-neon-purple rounded-full animate-ping"></div>
                  <div class="absolute bottom-4 left-4 w-2 h-2 bg-neon-pink rounded-full animate-ping" style="animation-delay: 1s;"></div>
                </div>
              </div>
            </div>
            
            <!-- Content a la derecha -->
            <div class="order-1 lg:order-2 text-center lg:text-left space-y-4">
              <!-- Badge Animado -->
              <div class="inline-flex items-center gap-3 px-6 py-3 bg-gradient-to-r from-neon-purple/20 to-neon-pink/20 backdrop-blur-md border border-neon-purple/40 rounded-full mb-4 animate-fade-in shadow-lg shadow-neon-purple/20">
                <div class="w-2 h-2 bg-neon-purple rounded-full animate-pulse"></div>
                <span class="text-neon-purple font-bold text-sm tracking-wide">FUNDACIÓN FREEAGENTS</span>
                <div class="w-2 h-2 bg-neon-pink rounded-full animate-pulse" style="animation-delay: 0.5s;"></div>
              </div>

              <!-- Main Headline con Efecto -->
              <h1 class="font-display text-5xl md:text-6xl lg:text-7xl font-bold mb-4 leading-tight">
                <span class="block text-white mb-1 animate-slide-up" data-es="Transformamos" data-en="We Transform">Transformamos</span>
                <span class="block bg-gradient-to-r from-neon-purple via-neon-pink to-neon-blue bg-clip-text text-transparent animate-slide-up" style="animation-delay: 0.1s;" data-es="Vidas a Través" data-en="Lives Through">
                  Vidas a Través
                </span>
                <span class="block text-white animate-slide-up" style="animation-delay: 0.2s;" data-es="de la Tecnología" data-en="Technology">de la Tecnología</span>
              </h1>

              <!-- Subheadline -->
              <p class="text-xl md:text-2xl text-gray-300 mb-3 leading-normal animate-slide-up" style="animation-delay: 0.3s;" data-es="Más que una fundación, somos un movimiento que forma el futuro del talento tech." data-en="More than a foundation, we are a movement that shapes the future of tech talent.">
                Más que una fundación, somos un <strong class="text-neon-purple">movimiento</strong> que 
                <strong class="text-neon-pink">forma el futuro</strong> del talento tech.
              </p>

              <p class="text-base text-gray-400 mb-6 leading-normal animate-slide-up" style="animation-delay: 0.4s;">
                Programas de mentoría, capacitación y oportunidades reales para desarrolladores que quieren cambiar su carrera.
              </p>

              <!-- CTAs Premium -->
              <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start animate-slide-up" style="animation-delay: 0.5s;">
                <a 
                  href="/contacto" 
                  class="group relative overflow-hidden bg-gradient-to-r from-neon-purple to-neon-pink px-10 py-5 rounded-full text-white font-bold text-lg shadow-2xl shadow-neon-purple/30 hover:shadow-neon-purple/50 transition-all duration-300 hover:scale-105"
                >
                  <span class="relative z-10 flex items-center gap-2">
                    <svg class="w-5 h-5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                    </svg>
                    Aplicar como Talento
                  </span>
                  <div class="absolute inset-0 bg-gradient-to-r from-neon-pink to-neon-purple opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                </a>
                <a 
                  href="/contacto" 
                  class="group relative overflow-hidden border-2 border-neon-purple px-10 py-5 rounded-full text-neon-purple font-bold text-lg backdrop-blur-sm bg-neon-purple/5 hover:bg-neon-purple hover:text-white transition-all duration-300 hover:scale-105 hover:shadow-xl hover:shadow-neon-purple/30"
                >
                  <span class="relative z-10 flex items-center gap-2">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                    </svg>
                    Únete como Mentor
                  </span>
                </a>
              </div>

              <!-- Trust Badges -->
              <div class="flex flex-wrap gap-6 justify-center lg:justify-start pt-4 animate-fade-in" style="animation-delay: 0.6s;">
                <div class="flex items-center gap-2 text-sm text-gray-400">
                  <svg class="w-5 h-5 text-neon-purple" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                  </svg>
                  <span>100% Gratuito</span>
                </div>
                <div class="flex items-center gap-2 text-sm text-gray-400">
                  <svg class="w-5 h-5 text-neon-pink" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                  </svg>
                  <span>Proyectos Reales</span>
                </div>
                <div class="flex items-center gap-2 text-sm text-gray-400">
                  <svg class="w-5 h-5 text-neon-blue" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                  </svg>
                  <span>Mentoría Personalizada</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Misión y Visión con Efectos Premium -->
    <section class="relative py-16 overflow-hidden">
      
      <div class="container mx-auto px-6 relative z-10">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-12">
            <div class="inline-block px-6 py-3 bg-gradient-to-r from-neon-purple/20 to-neon-pink/20 backdrop-blur-md border border-neon-purple/30 rounded-full mb-8 animate-fade-in">
              <span class="text-neon-purple font-bold text-sm tracking-wide">MISIÓN Y VISIÓN</span>
            </div>
              <h2 class="font-display text-5xl md:text-6xl font-bold mb-6">
              <span class="bg-gradient-to-r from-neon-purple via-neon-pink to-neon-blue bg-clip-text text-transparent animate-slide-up">
                Democratizando Oportunidades Tech
              </span>
            </h2>
            <p class="text-xl md:text-2xl text-gray-300 leading-relaxed max-w-3xl mx-auto animate-slide-up" style="animation-delay: 0.1s;">
              Creamos un puente entre el <strong class="text-neon-purple">talento emergente</strong> y las 
              <strong class="text-neon-pink">necesidades reales del mercado</strong>, democratizando el acceso a oportunidades de calidad.
            </p>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mt-12">
            <!-- Por qué Existe -->
            <div class="relative group animate-slide-up" style="animation-delay: 0.2s;">
              <div class="absolute -inset-1 bg-gradient-to-r from-neon-purple/20 to-neon-pink/20 rounded-3xl blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
              
              <div class="relative bg-gradient-to-br from-gray-900/90 via-purple-900/20 to-gray-800/90 backdrop-blur-xl rounded-3xl p-8 border border-purple-500/30 shadow-2xl group-hover:border-purple-400/50 transition-all duration-500 h-full">
                <div class="flex items-center gap-4 mb-6">
                  <div class="w-14 h-14 bg-gradient-to-r from-neon-purple to-neon-pink rounded-2xl flex items-center justify-center shadow-lg shadow-neon-purple/30">
                    <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
                    </svg>
                  </div>
                  <h3 class="font-display text-3xl font-bold text-white">¿Por qué Existe?</h3>
                </div>
                
                <div class="space-y-4">
                  <div class="group/item relative bg-gray-800/50 rounded-xl p-4 border border-gray-700/50 hover:border-neon-purple/50 transition-all duration-300 hover:bg-gray-800/70">
                    <div class="flex items-start gap-3">
                      <div class="w-12 h-12 bg-gradient-to-r from-neon-purple to-neon-pink rounded-xl flex items-center justify-center flex-shrink-0 group-hover/item:scale-110 transition-transform shadow-lg">
                        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                        </svg>
                      </div>
                      <div class="flex-1">
                        <h4 class="font-semibold text-white mb-1.5">Brecha de Talento</h4>
                        <p class="text-gray-400 text-sm leading-relaxed">
                          La industria tech necesita más desarrolladores calificados, pero muchos talentos no tienen 
                          acceso a oportunidades de calidad para desarrollar sus habilidades.
                        </p>
                      </div>
                    </div>
                  </div>

                  <div class="group/item relative bg-gray-800/50 rounded-xl p-4 border border-gray-700/50 hover:border-neon-pink/50 transition-all duration-300 hover:bg-gray-800/70">
                    <div class="flex items-start gap-3">
                      <div class="w-12 h-12 bg-gradient-to-r from-neon-pink to-neon-blue rounded-xl flex items-center justify-center flex-shrink-0 group-hover/item:scale-110 transition-transform shadow-lg">
                        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                        </svg>
                      </div>
                      <div class="flex-1">
                        <h4 class="font-semibold text-white mb-1.5">Experiencia Práctica</h4>
                        <p class="text-gray-400 text-sm leading-relaxed">
                          Los bootcamps y cursos enseñan teoría, pero falta experiencia en proyectos reales. 
                          Nosotros proporcionamos esa experiencia práctica invaluable.
                        </p>
                      </div>
                    </div>
                  </div>

                  <div class="group/item relative bg-gray-800/50 rounded-xl p-4 border border-gray-700/50 hover:border-neon-blue/50 transition-all duration-300 hover:bg-gray-800/70">
                    <div class="flex items-start gap-3">
                      <div class="w-12 h-12 bg-gradient-to-r from-neon-blue to-neon-green rounded-xl flex items-center justify-center flex-shrink-0 group-hover/item:scale-110 transition-transform shadow-lg">
                        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                        </svg>
                      </div>
                      <div class="flex-1">
                        <h4 class="font-semibold text-white mb-1.5">Mentoría de Calidad</h4>
                        <p class="text-gray-400 text-sm leading-relaxed">
                          Conectamos a desarrolladores emergentes con profesionales   que los guían 
                          en su crecimiento profesional y técnico.
                        </p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Visión Card Premium -->
            <div class="relative group animate-slide-up" style="animation-delay: 0.3s;">
              <div class="absolute -inset-1 bg-gradient-to-r from-neon-pink/20 to-neon-blue/20 rounded-3xl blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
              
              <div class="relative bg-gradient-to-br from-gray-900/90 via-purple-900/20 to-gray-800/90 backdrop-blur-xl rounded-3xl p-8 border border-purple-500/30 shadow-2xl group-hover:border-purple-400/50 transition-all duration-500 h-full flex flex-col">
                <div class="flex items-center gap-4 mb-6">
                  <div class="w-14 h-14 bg-gradient-to-r from-neon-pink to-neon-blue rounded-2xl flex items-center justify-center shadow-lg shadow-neon-pink/30">
                    <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                    </svg>
                  </div>
                  <h4 class="font-display text-3xl font-bold text-white">Nuestra Visión</h4>
                </div>
                
                <p class="text-lg text-gray-300 mb-6 leading-relaxed flex-1">
                  Ser el puente que conecte el talento emergente con oportunidades reales, 
                  creando un ecosistema donde la <strong class="text-neon-pink">innovación</strong> y el 
                  <strong class="text-neon-blue">crecimiento profesional</strong> se alimenten mutuamente.
                </p>
                
                <div class="space-y-3">
                  <div class="flex items-center gap-3 p-3 bg-gray-800/50 rounded-xl hover:bg-gray-800/70 transition-colors group/item">
                    <div class="w-3 h-3 bg-neon-purple rounded-full group-hover/item:scale-125 transition-transform shadow-lg shadow-neon-purple/50"></div>
                    <span class="text-gray-300 font-medium text-sm">Democratizar oportunidades tech</span>
                  </div>
                  <div class="flex items-center gap-3 p-3 bg-gray-800/50 rounded-xl hover:bg-gray-800/70 transition-colors group/item">
                    <div class="w-3 h-3 bg-neon-pink rounded-full group-hover/item:scale-125 transition-transform shadow-lg shadow-neon-pink/50"></div>
                    <span class="text-gray-300 font-medium text-sm">Elevar estándares de la industria</span>
                  </div>
                  <div class="flex items-center gap-3 p-3 bg-gray-800/50 rounded-xl hover:bg-gray-800/70 transition-colors group/item">
                    <div class="w-3 h-3 bg-neon-blue rounded-full group-hover/item:scale-125 transition-transform shadow-lg shadow-neon-blue/50"></div>
                    <span class="text-gray-300 font-medium text-sm">Crear impacto social positivo</span>
                  </div>
                  <div class="flex items-center gap-3 p-3 bg-gray-800/50 rounded-xl hover:bg-gray-800/70 transition-colors group/item">
                    <div class="w-3 h-3 bg-neon-green rounded-full group-hover/item:scale-125 transition-transform shadow-lg shadow-neon-green/50"></div>
                    <span class="text-gray-300 font-medium text-sm">Fomentar innovación continua</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Qué Hacemos - Programas con Efectos Premium -->
    <section class="relative py-16 overflow-hidden">
      
      <div class="container mx-auto px-6 relative z-10">
        <div class="text-center mb-20">
          <div class="inline-block px-6 py-3 bg-gradient-to-r from-neon-blue/20 to-neon-purple/20 backdrop-blur-md border border-neon-blue/30 rounded-full mb-8 animate-fade-in">
            <span class="text-neon-blue font-bold text-sm tracking-wide">NUESTROS PROGRAMAS</span>
          </div>
          
              <h2 class="font-display text-5xl md:text-6xl font-bold mb-6">
            <span class="bg-gradient-to-r from-neon-blue via-neon-purple to-neon-pink bg-clip-text text-transparent animate-slide-up">
              Caminos para Crecer
            </span>
          </h2>
          <p class="text-xl md:text-2xl text-gray-300 max-w-3xl mx-auto animate-slide-up" style="animation-delay: 0.1s;">
            Múltiples caminos para que el talento emergente <strong class="text-neon-blue">crezca</strong> y 
            <strong class="text-neon-purple">contribuya</strong> a proyectos reales.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12 max-w-7xl mx-auto">
          <!-- Programa de Mentoría Premium -->
          <div class="group relative animate-slide-up h-full flex flex-col" style="animation-delay: 0.2s;">
            <div class="absolute -inset-0.5 bg-gradient-to-r from-neon-purple to-neon-pink rounded-3xl opacity-0 group-hover:opacity-20 blur-xl transition-opacity duration-500"></div>
            
            <div class="relative bg-gradient-to-br from-gray-800/90 via-purple-900/10 to-gray-800/90 backdrop-blur-sm rounded-3xl p-6 border border-gray-700/50 group-hover:border-neon-purple/50 transition-all duration-500 shadow-xl group-hover:shadow-2xl group-hover:shadow-neon-purple/20 group-hover:-translate-y-2 flex flex-col h-full">
              <div class="w-16 h-16 bg-gradient-to-r from-neon-purple to-neon-pink rounded-2xl flex items-center justify-center mb-4 group-hover:scale-110 transition-all duration-500 shadow-lg shadow-neon-purple/30">
                <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
