    transform: translateZ(0);
    backface-visibility: hidden;
    perspective: 1000px;
    will-change: transform, opacity;
  }
  
  /* Optimizar contenedores de fondo */
  [class*="bg-gradient"],
  [class*="blur-"] {
    will-change: transform, opacity;
    transform: translateZ(0);
  }
  
  /* Reducir repaints en animaciones */
  @media (prefers-reduced-motion: reduce) {
