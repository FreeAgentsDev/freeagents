---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DynamicBackground from '../components/DynamicBackground.astro';
import ScrollProgress from '../components/ui/ScrollProgress.astro';
import OptimizedImage from '../components/ui/OptimizedImage.astro';

const siteUrl = Astro.site?.href || "https://freeagents.dev";
const currentUrl = new URL(Astro.url.pathname, siteUrl).href;
---

<Layout 
  title="Tecnología con Propósito | FreeAgents - Software que Resuelve" 
  description="Desarrollamos software con propósito. Cada proyecto impulsa tu negocio y forma el futuro del talento tech. Sin ruido. Solo resultados. Desarrollo a la medida, e-commerce, apps y automatización con IA."
  keywords="desarrollo de software, tecnología con propósito, software a la medida, desarrollo web, e-commerce, apps móviles, automatización IA, desarrollo Colombia"
  image="/logofreeagents1.png"
  type="website"
  canonical={currentUrl}
>
  <Header />
  <ScrollProgress />
  
  <main class="pt-20 relative min-h-screen overflow-hidden">
    <!-- Fondo Dinámico Optimizado para Performance -->
    <div class="fixed inset-0 -z-10 will-change-transform">
      <!-- Capas de Fondos Dinámicos Reducidas (Optimizado) -->
      <DynamicBackground type="particles" color="blue" />
      <DynamicBackground type="circuits" color="cyan" />
      <DynamicBackground type="hologram" color="cyan" />
      
      <!-- Gradientes Animados Optimizados -->
      <div class="absolute inset-0 will-change-opacity">
        <div class="absolute top-0 left-0 w-full h-full bg-gradient-to-br from-cyan-900/12 via-teal-900/8 to-blue-900/12"></div>
        <div class="absolute top-1/4 left-1/4 w-[500px] h-[500px] bg-neon-cyan/6 rounded-full blur-3xl"></div>
        <div class="absolute bottom-1/4 right-1/4 w-[500px] h-[500px] bg-neon-teal/6 rounded-full blur-3xl"></div>
        <div class="absolute top-1/2 right-1/3 w-[400px] h-[400px] bg-neon-blue/5 rounded-full blur-3xl"></div>
      </div>
      
      <!-- Grid Pattern Overlay Optimizado -->
      <div class="absolute inset-0 opacity-4 will-change-transform" style="background-image: linear-gradient(rgba(0, 212, 255, 0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(20, 184, 166, 0.1) 1px, transparent 1px); background-size: 50px 50px;"></div>
      
      <!-- Efectos de Luz Adicionales -->
      <div class="absolute inset-0 pointer-events-none">
        <div class="absolute top-0 left-0 w-full h-1/2 bg-gradient-to-b from-cyan-500/4 to-transparent"></div>
        <div class="absolute bottom-0 right-0 w-full h-1/2 bg-gradient-to-t from-teal-500/4 to-transparent"></div>
      </div>
    </div>
    <!-- Hero Section Única - Software Factory -->
    <section class="relative min-h-[90vh] flex items-center justify-center overflow-hidden">

      <div class="relative z-10 container mx-auto px-6 py-20">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center max-w-7xl mx-auto">
          <!-- Content -->
          <div class="text-center lg:text-left">
            <!-- Badge Purpose-Driven -->
            <div class="inline-flex items-center gap-2 px-4 py-2 bg-neon-cyan/10 border border-neon-cyan/30 rounded-full mb-8 animate-fade-in">
              <svg class="w-5 h-5 text-neon-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
              <span class="text-neon-cyan font-semibold" data-es="Tecnología con Propósito" data-en="Purpose-Driven Technology">Tecnología con Propósito</span>
            </div>

            <!-- Main Headline - Con diferenciación clara -->
            <h1 class="font-display text-5xl md:text-7xl font-bold mb-8 leading-tight animate-slide-up">
              <span class="text-white drop-shadow-[0_0_20px_rgba(0,212,255,0.5)]" data-es="Tecnología que Resuelve," data-en="Technology that Solves,">Tecnología que Resuelve,</span>
              <br>
              <span class="bg-gradient-to-r from-neon-cyan via-neon-teal to-neon-blue bg-clip-text text-transparent drop-shadow-[0_0_30px_rgba(0,212,255,0.6)]" data-es="No que Vende" data-en="Not that Sells">
                No que Vende
              </span>
            </h1>

            <!-- Subheadline - Con propósito explícito -->
            <p class="text-xl md:text-2xl text-gray-100 mb-4 leading-relaxed animate-slide-up drop-shadow-[0_2px_10px_rgba(0,0,0,0.5)]" style="animation-delay: 0.1s;">
              <span data-es="Desarrollamos software con " data-en="We develop software with ">Desarrollamos software con </span><strong class="text-neon-cyan drop-shadow-[0_0_10px_rgba(0,212,255,0.6)]"><span data-es="propósito" data-en="purpose">propósito</span></strong><span data-es=". Cada proyecto impulsa tu negocio y forma el " data-en=". Each project drives your business and shapes the ">. Cada proyecto impulsa tu negocio y forma el </span><strong class="text-neon-teal drop-shadow-[0_0_10px_rgba(20,184,166,0.6)]"><span data-es="futuro del talento tech" data-en="future of tech talent">futuro del talento tech</span></strong><span data-es=". Sin ruido. Solo resultados." data-en=". No noise. Just results.">. Sin ruido. Solo resultados.</span>
            </p>

            <!-- Outcomes Bullets -->
            <div class="space-y-3 mb-8 animate-slide-up drop-shadow-[0_2px_8px_rgba(0,0,0,0.5)]" style="animation-delay: 0.2s;">
              <div class="flex items-start gap-3">
                <svg class="w-6 h-6 text-neon-cyan flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-200" data-es="Software que escala con tu negocio, no contra él" data-en="Software that scales with your business, not against it">Software que escala con tu negocio, no contra él</span>
              </div>
              <div class="flex items-start gap-3">
                <svg class="w-6 h-6 text-neon-teal flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-200" data-es="Equipos que combinan experiencia con talento emergente" data-en="Teams that combine experience with emerging talent">Equipos que combinan experiencia con talento emergente</span>
              </div>
              <div class="flex items-start gap-3">
                <svg class="w-6 h-6 text-neon-blue flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-200" data-es="Cada proyecto contribuye al desarrollo de la próxima generación tech" data-en="Each project contributes to developing the next generation of tech">Cada proyecto contribuye al desarrollo de la próxima generación tech</span>
              </div>
              <div class="flex items-start gap-3">
                <svg class="w-6 h-6 text-neon-green flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-200" data-es="Sin promesas vacías. Solo código que funciona." data-en="No empty promises. Just code that works.">Sin promesas vacías. Solo código que funciona.</span>
              </div>
            </div>

            <!-- CTAs Principales - Mejorados -->
            <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start items-center mb-8 animate-slide-up" style="animation-delay: 0.3s;">
              <a 
                href="/contacto" 
                class="group bg-gradient-to-r from-neon-cyan to-neon-teal px-10 py-5 rounded-full text-white font-bold text-lg hover:shadow-2xl hover:shadow-neon-cyan/30 transition-all duration-300 hover:scale-105 flex items-center gap-2"
              >
                <span data-es="Hablar con un Experto" data-en="Talk to an Expert">Hablar con un Experto</span>
                <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                </svg>
              </a>
              <a 
                href="/portafolio" 
                class="relative border-2 border-neon-teal px-10 py-5 rounded-full text-neon-teal font-bold text-lg bg-neon-teal/10 backdrop-blur-sm hover:bg-neon-teal hover:text-white transition-all duration-300 hover:scale-105 hover:shadow-2xl hover:shadow-neon-teal/40 drop-shadow-[0_0_15px_rgba(20,184,166,0.4)]"
              >
                <span class="relative z-10" data-es="Ver Proyectos Reales" data-en="View Real Projects">Ver Proyectos Reales</span>
                <div class="absolute inset-0 rounded-full bg-neon-teal/20 blur-xl opacity-50"></div>
              </a>
            </div>

            <!-- Trust Indicators - Mejorados con contexto -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-6 animate-fade-in" style="animation-delay: 0.4s;">
              <div class="text-center lg:text-left">
                <div class="text-3xl md:text-4xl font-bold text-neon-cyan mb-2 drop-shadow-[0_0_15px_rgba(0,212,255,0.6)]">+50</div>
                <div class="text-sm text-gray-200 drop-shadow-[0_2px_5px_rgba(0,0,0,0.5)]" data-es="Proyectos Entregados" data-en="Projects Delivered">Proyectos Entregados</div>
              </div>
              <div class="text-center lg:text-left">
                <div class="text-3xl md:text-4xl font-bold text-neon-teal mb-2 drop-shadow-[0_0_15px_rgba(20,184,166,0.6)]">50+</div>
                <div class="text-sm text-gray-200 drop-shadow-[0_2px_5px_rgba(0,0,0,0.5)]" data-es="Talentos Formados" data-en="Talents Trained">Talentos Formados</div>
              </div>
              <div class="text-center lg:text-left">
                <div class="text-3xl md:text-4xl font-bold text-neon-blue mb-2 drop-shadow-[0_0_15px_rgba(14,165,233,0.6)]">100%</div>
                <div class="text-sm text-gray-200 drop-shadow-[0_2px_5px_rgba(0,0,0,0.5)]" data-es="Calidad Asegurada" data-en="Quality Assured">Calidad Asegurada</div>
              </div>
              <div class="text-center lg:text-left">
                <div class="text-3xl md:text-4xl font-bold text-neon-green mb-2 drop-shadow-[0_0_15px_rgba(16,185,129,0.6)]">24/7</div>
                <div class="text-sm text-gray-200 drop-shadow-[0_2px_5px_rgba(0,0,0,0.5)]" data-es="Soporte Continuo" data-en="Continuous Support">Soporte Continuo</div>
              </div>
            </div>
          </div>

          <!-- Hero Image -->
          <div class="relative flex justify-center lg:justify-end">
            <div class="relative">
              <!-- Glow effect behind image -->
              <div class="absolute inset-0 bg-gradient-to-r from-neon-cyan/20 to-neon-teal/20 rounded-3xl blur-2xl transform scale-110"></div>
              
              <!-- Main image container -->
              <div class="relative bg-gradient-to-br from-gray-800/50 to-gray-900/50 backdrop-blur-sm rounded-3xl p-8 border border-gray-700/50">
                <OptimizedImage 
                  src="/elongreen.png" 
                  alt="Desarrollo de software a la medida - FreeAgents Software Factory especializada en desarrollo de páginas web y aplicaciones" 
                  class="h-80 rounded-3xl w-auto mx-auto drop-shadow-2xl"
                  style="animation: float-smooth 4s ease-in-out infinite; will-change: transform; transform: translateZ(0); backface-visibility: hidden;"
                  priority={true}
                  loading="eager"
                  width={600}
                  height={320}
                />
                
                <!-- Decorative elements -->
                <div class="absolute -top-4 -right-4 w-8 h-8 bg-neon-cyan rounded-full animate-pulse"></div>
                <div class="absolute -bottom-4 -left-4 w-6 h-6 bg-neon-teal rounded-full animate-pulse" style="animation-delay: 0.5s;"></div>
                <div class="absolute top-1/2 -left-6 w-4 h-4 bg-neon-blue rounded-full animate-pulse" style="animation-delay: 1s;"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Por Qué Somos Diferentes -->
    <section class="py-24 relative overflow-hidden">
      <div class="container mx-auto px-6 relative z-10">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-16">
            <div class="inline-block px-4 py-2 bg-neon-purple/10 border border-neon-purple/30 rounded-full mb-6">
              <span class="text-neon-purple font-semibold text-sm" data-es="Diferenciación" data-en="Differentiation">Diferenciación</span>
            </div>
            
            <h2 class="font-display text-4xl md:text-5xl font-bold mb-6 text-white drop-shadow-[0_0_20px_rgba(0,212,255,0.5)]">
              <span data-es="No Somos una Agencia." data-en="We're Not an Agency.">No Somos una Agencia.</span>
              <br>
              <span class="bg-gradient-to-r from-neon-purple to-neon-pink bg-clip-text text-transparent drop-shadow-[0_0_25px_rgba(139,92,246,0.6)]" data-es="Somos un Movimiento." data-en="We're a Movement.">Somos un Movimiento.</span>
            </h2>
            
            <p class="text-xl text-gray-100 max-w-3xl mx-auto drop-shadow-[0_2px_10px_rgba(0,0,0,0.5)]">
              <span data-es="FreeAgents nació de una " data-en="FreeAgents was born from a ">FreeAgents nació de una </span><strong class="text-neon-purple"><span data-es="convicción" data-en="conviction">convicción</span></strong><span data-es=": la tecnología debe servir a un " data-en=": technology must serve a greater ">: la tecnología debe servir a un </span><strong class="text-neon-pink"><span data-es="propósito mayor" data-en="purpose">propósito mayor</span></strong><span data-es=". Cada proyecto que desarrollamos impulsa negocios reales y forma el talento que transformará la industria." data-en=". Every project we develop drives real businesses and shapes the talent that will transform the industry.">. Cada proyecto que desarrollamos impulsa negocios reales y forma el talento que transformará la industria.</span>
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            <!-- Diferenciador 1: Fundación -->
            <div class="bg-gray-900/60 backdrop-blur-sm rounded-2xl p-8 border border-gray-700 hover:border-neon-purple/50 transition-all duration-300 hover:shadow-xl hover:shadow-neon-purple/10 hover:-translate-y-2">
              <div class="w-16 h-16 bg-gradient-to-r from-neon-purple to-neon-pink rounded-xl flex items-center justify-center mb-6">
                <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                </svg>
              </div>
              <h3 class="font-display text-2xl font-bold text-white mb-4 drop-shadow-[0_2px_8px_rgba(0,0,0,0.5)]" data-es="Fundación como Motor" data-en="Foundation as Engine">Fundación como Motor</h3>
              <p class="text-gray-200 mb-4 leading-relaxed drop-shadow-[0_2px_5px_rgba(0,0,0,0.5)]">
                <span data-es="No es responsabilidad social: es nuestro " data-en="It's not social responsibility: it's our ">No es responsabilidad social: es nuestro </span><strong class="text-neon-purple"><span data-es="motor de innovación" data-en="innovation engine">motor de innovación</span></strong><span data-es=". Cada proyecto forma desarrolladores junior que aportan perspectivas frescas y energía." data-en=". Every project trains junior developers who bring fresh perspectives and energy.">. Cada proyecto forma desarrolladores junior que aportan perspectivas frescas y energía.</span>
              </p>
              <div class="text-sm text-neon-purple font-semibold" data-es="50+ talentos formados" data-en="50+ talents trained">50+ talentos formados</div>
            </div>

            <!-- Diferenciador 2: Equipo Híbrido -->
            <div class="bg-gray-900/60 backdrop-blur-sm rounded-2xl p-8 border border-gray-700 hover:border-neon-cyan/50 transition-all duration-300 hover:shadow-xl hover:shadow-neon-cyan/10 hover:-translate-y-2">
              <div class="w-16 h-16 bg-gradient-to-r from-neon-cyan to-neon-blue rounded-xl flex items-center justify-center mb-6">
                <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
                </svg>
              </div>
              <h3 class="font-display text-2xl font-bold text-white mb-4 drop-shadow-[0_2px_8px_rgba(0,0,0,0.5)]" data-es="Equipo Híbrido" data-en="Hybrid Team">Equipo Híbrido</h3>
              <p class="text-gray-200 mb-4 leading-relaxed drop-shadow-[0_2px_5px_rgba(0,0,0,0.5)]">
                <span data-es="Combinamos " data-en="We combine ">Combinamos </span><strong class="text-neon-cyan"><span data-es="experiencia senior" data-en="senior experience">experiencia senior</span></strong><span data-es=" con " data-en=" with "> con </span><strong class="text-neon-blue"><span data-es="talento emergente" data-en="emerging talent">talento emergente</span></strong><span data-es=". Resultado: soluciones innovadoras con calidad enterprise garantizada por mentores experimentados." data-en=". Result: innovative solutions with enterprise quality guaranteed by experienced mentors.">. Resultado: soluciones innovadoras con calidad enterprise garantizada por mentores experimentados.</span>
              </p>
              <div class="text-sm text-neon-cyan font-semibold" data-es="100% calidad asegurada" data-en="100% quality assured">100% calidad asegurada</div>
            </div>

            <!-- Diferenciador 3: Propósito sobre Ruido -->
            <div class="bg-gray-900/60 backdrop-blur-sm rounded-2xl p-8 border border-gray-700 hover:border-neon-teal/50 transition-all duration-300 hover:shadow-xl hover:shadow-neon-teal/10 hover:-translate-y-2">
              <div class="w-16 h-16 bg-gradient-to-r from-neon-teal to-neon-green rounded-xl flex items-center justify-center mb-6">
                <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                </svg>
              </div>
              <h3 class="font-display text-2xl font-bold text-white mb-4 drop-shadow-[0_2px_8px_rgba(0,0,0,0.5)]" data-es="Convicción sobre Ruido" data-en="Conviction over Noise">Convicción sobre Ruido</h3>
              <p class="text-gray-200 mb-4 leading-relaxed drop-shadow-[0_2px_5px_rgba(0,0,0,0.5)]">
                <span data-es="No hacemos " data-en="We don't do ">No hacemos </span><strong class="text-neon-teal"><span data-es="marketing vacío" data-en="empty marketing">marketing vacío</span></strong><span data-es=". Comunicamos claramente qué hacemos, cómo lo hacemos y por qué importa. Sin promesas exageradas, solo resultados reales." data-en=". We communicate clearly what we do, how we do it, and why it matters. No exaggerated promises, just real results.">. Comunicamos claramente qué hacemos, cómo lo hacemos y por qué importa. Sin promesas exageradas, solo resultados reales.</span>
              </p>
              <div class="text-sm text-neon-teal font-semibold" data-es="Transparencia total" data-en="Total transparency">Transparencia total</div>
            </div>
          </div>

          <div class="text-center mt-12">
            <a href="/fundacion" class="inline-flex items-center gap-2 px-8 py-4 border-2 border-neon-purple text-neon-purple font-semibold rounded-full bg-neon-purple/15 backdrop-blur-sm hover:bg-neon-purple hover:text-white transition-all duration-300 hover:shadow-2xl hover:shadow-neon-purple/40">
              <span data-es="Conocer la Fundación" data-en="Learn About the Foundation">Conocer la Fundación</span>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ¿Qué Hacemos? - Servicios -->
    <section class="py-24 relative overflow-hidden">
      
      <div class="container mx-auto px-6 relative z-10">
        <div class="text-center mb-16">
          <div class="inline-block px-4 py-2 bg-neon-teal/10 border border-neon-teal/30 rounded-full mb-6">
            <span class="text-neon-teal font-semibold text-sm" data-es="Nuestros Servicios" data-en="Our Services">Nuestros Servicios</span>
          </div>
          
          <h2 class="font-display text-4xl md:text-5xl font-bold mb-6 text-white drop-shadow-[0_0_20px_rgba(0,212,255,0.5)]">
            <span data-es="Soluciones que Resuelven" data-en="Solutions that Solve">Soluciones que Resuelven</span>
            <br>
            <span class="bg-gradient-to-r from-neon-teal to-neon-blue bg-clip-text text-transparent drop-shadow-[0_0_25px_rgba(20,184,166,0.6)]" data-es="Problemas Reales" data-en="Real Problems">Problemas Reales</span>
          </h2>
          
          <p class="text-xl text-gray-100 max-w-3xl mx-auto drop-shadow-[0_2px_10px_rgba(0,0,0,0.5)]">
