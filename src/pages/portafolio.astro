---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
---

<Layout title="Portafolio - FreeAgents" description="Descubre nuestros proyectos más exitosos. Casos reales de emprendedores que han transformado sus negocios con nuestras soluciones tecnológicas.">
  <Header />
  
  <div class="pt-10 min-h-screen">
    <!-- Hero Section -->
    <Hero 
      title="Nuestro Portafolio"
      subtitle="Proyectos que Impulsan el Crecimiento"
      description="Cada solución que creamos para nuestros emprendedores se basa en una sólida arquitectura y los materiales tecnológicos adecuados. Explora ejemplos de cómo combinamos plantillas probadas y Landings a la la medida para diseñar y escalar tu negocio digital."
      ctaText="Iniciar Mi Proyecto"
      ctaLink="/contacto"
      secondaryCtaText="Ver Servicios"
      secondaryCtaLink="/servicios"
      backgroundImage="/portfoliofrea.png"
    />

    <!-- Filtros -->
    <section class="py-12 bg-gray-800">
      <div class="container mx-auto px-6">
        <div class="flex flex-wrap justify-center gap-4">
          <button class="filter-btn active px-6 py-3 rounded-full bg-gradient-to-r from-neon-blue to-neon-purple text-white font-semibold transition-all duration-300" data-filter="all">
            Todos los Proyectos
          </button>
          <button class="filter-btn px-6 py-3 rounded-full border-2 border-neon-blue text-neon-blue hover:bg-neon-blue hover:text-white transition-all duration-300" data-filter="desarrollo">
            Landign page a tu medida
          </button>
          <button class="filter-btn px-6 py-3 rounded-full border-2 border-neon-purple text-neon-purple hover:bg-neon-purple hover:text-white transition-all duration-300" data-filter="apps">
            Apps Móviles
          </button>
          <button class="filter-btn px-6 py-3 rounded-full border-2 border-neon-green text-neon-green hover:bg-neon-green hover:text-white transition-all duration-300" data-filter="ecommerce">
            E-commerce
          </button>
        </div>
      </div>
    </section>

    <!-- Proyectos Grid -->
    <section class="py-20 bg-gray-900">
      <div class="container mx-auto px-6">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="projects-grid">
          <ProjectCard
            title="Datanova"
            description="Data Nova es un ejemplo de las bases de landing page modernas y potentes que FreeAgents usa. Podemos adaptarla con tus logos, textos y funcionalidades para que cause impacto y convierta visitantes en clientes."
            media={[
              { type: 'image', src: '/datanova/datanova1.png', alt: 'Datanova' },
              { type: 'image', src: '/datanova/datanova2.png', alt: 'Datanova' },
              { type: 'image', src: '/datanova/datanova3.png', alt: 'Datanova' },
              { type: 'image', src: '/datanova/datanova4.png', alt: 'Datanova' },
              { type: 'image', src: '/datanova/datanova5.png', alt: 'Datanova' }
            ]}
            imageAlt="Datanova"
            techs={[{name: 'Astro', colorClass: 'bg-neon-blue/20 text-neon-blue'}, {name: 'Node.js', colorClass: 'bg-neon-purple/20 text-neon-purple'}, {name: 'Tailwind CSS', colorClass: 'bg-neon-green/20 text-neon-green'}]}
            badge="Landings a la Medida"
            badgeColorClass="bg-neon-blue/20 text-neon-blue"
            category="desarrollo"
            metric="Diseño profesional"
            metricLabel=""
            detailsUrl=""
            demoUrl="https://data-nova.vercel.app"
          />
          <ProjectCard
            title="Munchies"
            description="Medusa DTC Starter es la base ideal para tu tienda online Directo al Consumidor. Esta plantilla de e-commerce de código abierto, construida con Medusa y Next.js, te ofrece una solución potente y flexible para vender directamente a tus clientes. Podemos transformar esta sólida base en TU tienda online personalizada, reflejando fielmente tu marca y visión."
            media={[
              { type: 'video', src: '/munchies/munchies.mp4' },
            ]}
            imageAlt="Munchies App"
            techs={[{name: 'NextJS', colorClass: 'bg-neon-purple/20 text-neon-purple'}, {name: 'Tailwind', colorClass: 'bg-neon-pink/20 text-neon-pink'}, {name: 'Pagos en linea', colorClass: 'bg-neon-blue/20 text-neon-blue'}]}
            badge="E-commerce"
            badgeColorClass="bg-neon-purple/20 text-neon-purple"
            category="ecommerce"
            metric="100% personalizable"
            metricLabel=""
            detailsUrl=""
            demoUrl='https://munchies-tinloof.vercel.app'
          />
          <ProjectCard
            title="Fitness App"
            description="La base perfecta para tu aplicación móvil de bienestar. Este ejemplo de Flutter ofrece una estructura robusta para apps de fitness modernas. Podemos transformar esta sólida base en TU aplicación personalizada, con tus logos, funciones específicas y una experiencia de usuario única."
            media={[
              { type: 'image', src: '/fitness/fit1.png', alt: 'Fitness App' },
              { type: 'image', src: '/fitness/fit2.png', alt: 'Fitness App' }
              ]}
            imageAlt="Fitness App"
            techs={[{name: 'Flutter', colorClass: 'bg-neon-purple/20 text-neon-purple'}, {name: 'Firebase', colorClass: 'bg-neon-pink/20 text-neon-pink'}, {name: 'Subscripcion', colorClass: 'bg-neon-blue/20 text-neon-blue'}]}
            badge="App Móvil"
            badgeColorClass="bg-neon-purple/20 text-neon-purple"
            category="apps"
            metric="Ideal para adptar a tu gimnasio"
            metricLabel=""
            detailsUrl=""
          />
          <ProjectCard
            title="Horizon"
            description="Horizon es una base excelente para tu sitio web, perfecta para blogs, portfolios o presencias online minimalistas. Este tema demuestra cómo FreeAgents puede ofrecerte una solución elegante y optimizada para tus necesidades. Podemos transformar esta base en TU sitio web personalizado, reflejando fielmente tu marca y visión."
            media={[
              { type: 'image', src: '/horizon/hori1.png', alt: 'Horizon' },
              { type: 'image', src: '/horizon/hori2.png', alt: 'Horizon' },
              { type: 'image', src: '/horizon/hori3.png', alt: 'Horizon' },
              { type: 'image', src: '/horizon/hori4.png', alt: 'Horizon' },
              { type: 'image', src: '/horizon/hori5.png', alt: 'Horizon' }
              ]}
            imageAlt="Fashion Store"
            techs={[{name: 'Shopify Plus', colorClass: 'bg-neon-green/20 text-neon-green'}, {name: 'AR.js', colorClass: 'bg-neon-blue/20 text-neon-blue'}, {name: 'TensorFlow', colorClass: 'bg-neon-purple/20 text-neon-purple'}]}
            badge="Portafolio"
            badgeColorClass="bg-neon-green/20 text-neon-green"
            category="desarrollo"
            metric="Da confianza y claridad"
            metricLabel=""
            detailsUrl=""
            demoUrl='https://horizon.cosmicthemes.com'
          />
          <ProjectCard
            title="ScrewFast"
            description="Screwfast es la base que tu negocio necesita. Esta plantilla de Astro ofrece un portafolio o blog de alto rendimiento y SEO, ideal para destacar tu contenido. Te mostramos cómo podemos transformar esta sólida base en TU sitio web personalizado, reflejando fielmente tu marca y visión."
            media={[
              { type: 'image', src: '/screwfast/screw1.png', alt: 'Screwfast' },
              { type: 'image', src: '/screwfast/screw2.png', alt: 'Screwfast' },
              { type: 'image', src: '/screwfast/screw3.png', alt: 'Screwfast' },
              { type: 'image', src: '/screwfast/screw4.png', alt: 'Screwfast' },
              { type: 'image', src: '/screwfast/screw5.png', alt: 'Screwfast' }
            ]}
            imageAlt="Screwfast"
            techs={[{name: 'Astro', colorClass: 'bg-neon-blue/20 text-neon-blue'}, {name: 'React', colorClass: 'bg-neon-green/20 text-neon-green'}, {name: 'Tailwind CSS', colorClass: 'bg-neon-purple/20 text-neon-purple'}]}
            badge="Landings a la Medida"
            badgeColorClass="bg-neon-blue/20 text-neon-blue"
            category="desarrollo"
            metric="SEO optimizado"
            metricLabel=""
            detailsUrl=""
            demoUrl='https://screwfast.uk'
          />
          <ProjectCard
            title="Medusa Next.js Ecommerce Store Starter"
            description="Medusa Next.js es la base ideal para tu tienda online Directo al Consumidor (DTC). Este template de e-commerce de código abierto, combinando Medusa y Next.js, te ofrece una solución potente y flexible para vender directamente a tus clientes. Podemos transformar esta sólida base en TU tienda online personalizada, reflejando fielmente tu marca y visión."
            media={[
              { type: 'image', src: '/medusanext/medusa1.png', alt: 'medusa' },
              { type: 'image', src: '/medusanext/medusa2.png', alt: 'medusa' },
              { type: 'image', src: '/medusanext/medusa3.png', alt: 'medusa' }
              ]}
            imageAlt="medusa"
            techs={[{name: 'MedusaJS', colorClass: 'bg-neon-purple/20 text-neon-purple'}, {name: 'NextJS', colorClass: 'bg-neon-blue/20 text-neon-blue'}, {name: 'Tailwin dCSS', colorClass: 'bg-neon-green/20 text-neon-green'}]}
            badge="Ecommerce"
            badgeColorClass="bg-neon-purple/20 text-neon-purple"
            category="ecommerce"
            metric="4.8★"
            metricLabel="Una alternativa economica a Shopify"
            detailsUrl=""
            demoUrl='https://next.medusajs.com/us'
          />
        </div>
      </div>
    </section>

    <!-- Estadísticas -->
    <section class="py-20 bg-gray-800">
      <div class="container mx-auto px-6">
        <div class="text-center mb-16">
          <h2 class="font-display text-4xl md:text-5xl font-bold mb-6">
            <span class="bg-gradient-to-r from-neon-blue to-neon-purple bg-clip-text text-transparent">
              Nuestro Impacto
            </span>
          </h2>
          <p class="text-xl text-gray-400 max-w-3xl mx-auto">
            Cualidades que se reflejan en el éxito de nuestros clientes y el crecimiento de sus negocios.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
          <div class="text-center">
            <div class="w-20 h-20 bg-gradient-to-r from-neon-blue to-neon-purple rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path>
              </svg>
            </div>
            <div class="text-4xl font-bold text-neon-blue mb-2">Herramientas verificadas</div>
          </div>

          <div class="text-center">
            <div class="w-20 h-20 bg-gradient-to-r from-neon-purple to-neon-pink rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
              </svg>
            </div>
            <div class="text-4xl font-bold text-neon-purple mb-2">Escalamiento automatico</div>
          </div>

          <div class="text-center">
            <div class="w-20 h-20 bg-gradient-to-r from-neon-green to-neon-blue rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
              </svg>
            </div>
            <div class="text-4xl font-bold text-neon-green mb-2">Atrae mas clientes</div>
          </div>

          <div class="text-center">
            <div class="w-20 h-20 bg-gradient-to-r from-neon-pink to-neon-purple rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <div class="text-4xl font-bold text-neon-pink mb-2">Posicionate en el mundo digital</div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-20 bg-gradient-to-r from-gray-900 via-gray-800 to-gray-900">
      <div class="container mx-auto px-6 text-center">
        <h2 class="font-display text-4xl md:text-5xl font-bold mb-6">
          <span class="bg-gradient-to-r from-neon-blue to-neon-purple bg-clip-text text-transparent">
            ¿Listo para Transformar tu Negocio?
          </span>
        </h2>
        <p class="text-xl text-gray-400 mb-10 max-w-2xl mx-auto">
          Cuéntanos tu visión y te ayudaremos a convertirla en una realidad digital impactante.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/contacto" class="bg-gradient-to-r from-neon-blue to-neon-purple px-8 py-4 rounded-full text-white font-semibold text-lg hover:shadow-lg hover:shadow-neon-blue/25 transition-all duration-300 hover:scale-105">
            Comenzar Mi Proyecto
          </a>
          <a href="/servicios" class="border-2 border-neon-purple px-8 py-4 rounded-full text-neon-purple font-semibold text-lg hover:bg-neon-purple hover:text-white transition-all duration-300 hover:scale-105">
            Explorar Servicios
          </a>
        </div>
      </div>
    </section>

  </div>
  <Footer />
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const filterButtons = document.querySelectorAll('.filter-btn');
    const projectCards = document.querySelectorAll('.project-card');

    filterButtons.forEach(button => {
      button.addEventListener('click', () => {
        const filter = button.getAttribute('data-filter');
        filterButtons.forEach(btn => btn.classList.remove('active', 'bg-gradient-to-r', 'from-neon-blue', 'to-neon-purple', 'text-white'));
        button.classList.add('active', 'bg-gradient-to-r', 'from-neon-blue', 'to-neon-purple', 'text-white');
        projectCards.forEach(card => {
          const htmlCard = card as HTMLElement;
          if (filter === 'all' || htmlCard.getAttribute('data-category') === filter) {
            htmlCard.style.display = 'block';
            htmlCard.style.animation = 'fadeIn 0.5s ease-in-out';
          } else {
            htmlCard.style.display = 'none';
          }
        });
      });
    });
  });
</script>

<style>
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>