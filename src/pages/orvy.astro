---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DynamicBackground from '../components/DynamicBackground.astro';

const siteUrl = Astro.site?.href || "https://freeagents.dev";
const currentUrl = `${siteUrl}/orvy`;

// No mostrar OrviChat en esta página ya que es la vista completa
---

<Layout 
  title="Orvi - Tu Consultor Virtual | FreeAgents" 
  description="Chatea con Orvi, tu consultor virtual de FreeAgents. Entiende qué necesita tu negocio y encuentra la mejor solución tecnológica para ti."
  keywords="orvi, asistente virtual, consultor IA, chatbot, ayuda virtual, consultoría tecnológica"
  canonical={currentUrl}
  showOrviChat={false}
>
  <Header />
  
  <main class="pt-20 relative min-h-screen overflow-hidden" id="orvy-main" style="scroll-margin-top: 0;">
    <!-- Fondo Dinámico -->
    <div class="fixed inset-0 -z-10">
      <DynamicBackground type="circuits" color="purple" />
      <DynamicBackground type="neural" color="pink" />
      <DynamicBackground type="particles" color="purple" />
      
      <div class="absolute inset-0">
        <div class="absolute top-0 left-0 w-full h-full bg-gradient-to-br from-purple-900/30 via-pink-900/20 to-purple-900/30 animate-pulse"></div>
      </div>
      
      <div class="absolute inset-0 opacity-10" style="background-image: linear-gradient(rgba(168, 85, 247, 0.2) 1px, transparent 1px), linear-gradient(90deg, rgba(168, 85, 247, 0.2) 1px, transparent 1px); background-size: 50px 50px; animation: grid-move 20s linear infinite;"></div>
    </div>

    <!-- Vista completa del chat -->
    <section class="relative py-8 px-4 sm:px-6 lg:px-8" id="orvy-chat-section">
      <div class="max-w-4xl mx-auto">
        <!-- Header de la página -->
        <div class="text-center mb-8">
          <h1 class="text-4xl sm:text-5xl font-bold mb-4 bg-gradient-to-r from-neon-cyan via-neon-teal to-neon-blue bg-clip-text text-transparent drop-shadow-[0_0_20px_rgba(0,212,255,0.5)]">
            Orvi - Tu Consultor Virtual
          </h1>
          <p class="text-gray-300 text-lg drop-shadow-[0_2px_8px_rgba(0,0,0,0.5)]">
            Chatea con Orvi y descubre la mejor solución tecnológica para tu negocio
          </p>
        </div>

        <!-- Chat completo profesional con estilo de la página de inicio -->
        <div id="orvy-chat-container" class="relative bg-gradient-to-br from-gray-900/95 via-gray-800/90 to-gray-900/95 backdrop-blur-xl border-2 border-neon-cyan/40 rounded-3xl shadow-2xl overflow-hidden orvy-ai-container">
          <!-- Efectos de IA profesionales: Patrones -->
          <div class="absolute inset-0 rounded-3xl bg-gradient-to-r from-neon-cyan/20 via-neon-teal/20 to-neon-cyan/20 orvy-panel-glow pointer-events-none"></div>
          <div class="absolute inset-0 rounded-3xl bg-gradient-to-br from-neon-cyan/10 via-transparent to-neon-teal/10 orvy-panel-glow-secondary pointer-events-none"></div>
          <div class="absolute inset-0 rounded-3xl opacity-5 orvy-neural-pattern pointer-events-none" style="background-image: linear-gradient(rgba(0, 212, 255, 0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(20, 184, 166, 0.1) 1px, transparent 1px); background-size: 20px 20px; animation: neural-pulse 4s ease-in-out infinite;"></div>
          
          <!-- Header del chat profesional -->
          <div class="relative flex items-center justify-between px-6 py-5 border-b border-neon-cyan/30 bg-gradient-to-r from-gray-800/80 via-gray-800/60 to-gray-800/80 backdrop-blur-sm">
            <!-- Efecto de data stream sutil -->
            <div class="absolute inset-0 bg-gradient-to-r from-transparent via-neon-cyan/5 to-transparent orvy-data-stream pointer-events-none"></div>
            <div class="flex items-center gap-4 relative z-10">
              <div class="relative w-12 h-12 rounded-full flex items-center justify-center overflow-hidden flex-shrink-0 ring-2 ring-neon-cyan/50 ring-neon-teal/30 orvy-avatar-glow">
                <div class="absolute inset-0 bg-gradient-to-br from-neon-cyan/30 to-neon-teal/30 rounded-full animate-pulse-slow"></div>
                <div class="absolute inset-0 bg-gradient-to-tr from-transparent via-white/20 to-transparent rounded-full orvy-avatar-shine"></div>
                <img 
                  src="/orby.png" 
                  alt="Orvi - Asistente IA" 
                  class="w-full h-full object-cover rounded-full orby-avatar relative z-10"
                  loading="eager"
                />
                <!-- Indicador de IA activa -->
                <div class="absolute -bottom-0.5 -right-0.5 w-3 h-3 bg-green-400 rounded-full border-2 border-gray-900 animate-pulse shadow-lg shadow-green-400/50"></div>
              </div>
              <div class="flex flex-col">
                <span class="text-xl font-bold text-white bg-gradient-to-r from-neon-cyan via-neon-teal to-neon-cyan bg-clip-text text-transparent animate-gradient-x drop-shadow-[0_0_10px_rgba(0,212,255,0.5)]">Orvi</span>
                <span class="text-sm text-gray-300 font-medium flex items-center gap-1">
                  <span class="w-1.5 h-1.5 bg-green-400 rounded-full animate-pulse shadow-sm shadow-green-400/50"></span>
                  Asistente IA • En línea
                </span>
              </div>
            </div>
            <div class="flex items-center gap-2 relative z-10">
              <button
                id="orvy-expand"
                class="p-2 rounded-xl hover:bg-neon-cyan/20 text-gray-400 hover:text-neon-cyan transition-all hover:scale-110"
                aria-label="Expandir chat"
                title="Expandir chat"
              >
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" />
                </svg>
              </button>
              <a
                href="/"
                class="p-2 rounded-xl hover:bg-neon-cyan/20 text-gray-400 hover:text-neon-cyan transition-all hover:scale-110"
                aria-label="Volver al inicio"
                title="Volver al inicio"
              >
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                </svg>
              </a>
              <button
                id="orvy-close"
                class="p-2 rounded-xl hover:bg-neon-cyan/20 text-gray-400 hover:text-neon-cyan transition-all hover:scale-110 hover:rotate-90"
                aria-label="Cerrar chat"
                title="Cerrar chat"
              >
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
              </button>
            </div>
          </div>

          <!-- Área de mensajes con efectos de IA -->
          <div
            id="orvy-messages"
            class="relative h-[60vh] min-h-[400px] overflow-y-auto px-6 py-6 space-y-4 custom-scrollbar orvy-messages-container"
          >
            <!-- Mensaje inicial con animación especial -->
            <div class="flex items-start gap-4 orvi-welcome-message">
              <div class="w-10 h-10 rounded-full flex items-center justify-center overflow-hidden flex-shrink-0 ring-2 ring-neon-cyan/30">
                <div class="absolute inset-0 bg-gradient-to-br from-neon-cyan/20 to-neon-teal/20 rounded-full"></div>
                <img 
                  src="/orby.png" 
                  alt="Orvi - Asistente IA" 
                  class="w-full h-full object-cover rounded-full orby-avatar relative z-10"
                  loading="eager"
                />
              </div>
              <div class="relative max-w-[85%] rounded-2xl bg-gradient-to-br from-gray-800/80 via-gray-800/70 to-gray-800/80 backdrop-blur-md border border-neon-cyan/30 px-5 py-4 text-base leading-relaxed shadow-xl overflow-hidden orvy-message-bubble">
                <!-- Efecto de glow profesional en el mensaje -->
                <div class="absolute inset-0 rounded-2xl bg-gradient-to-r from-neon-cyan/10 via-neon-teal/10 to-neon-cyan/10 blur-xl opacity-60 pointer-events-none"></div>
                
                <p class="text-gray-100 relative z-10 drop-shadow-[0_2px_4px_rgba(0,0,0,0.3)]">
                  <span class="orvi-greeting-text inline-block">
                    ¡Hola! 👋 Soy <span class="font-bold text-transparent bg-clip-text bg-gradient-to-r from-neon-cyan via-neon-teal to-neon-cyan animate-gradient-x drop-shadow-[0_0_10px_rgba(0,212,255,0.5)]">Orvi</span>, tu consultor de FreeAgents.
                  </span>
                </p>
                <p class="mt-3 text-gray-200 orvi-welcome-text relative z-10 drop-shadow-[0_2px_4px_rgba(0,0,0,0.3)]">
                  Estoy aquí para entender qué necesita tu negocio y ayudarte a encontrar la mejor solución. ¿Qué desafío o proyecto tienes en mente?
                </p>
                <!-- Efecto de brillo animado sutil -->
                <div class="absolute inset-0 rounded-2xl bg-gradient-to-r from-transparent via-white/5 to-transparent -translate-x-full orvi-message-shine pointer-events-none"></div>
              </div>
            </div>
          </div>

          <!-- Input profesional con estilo de la página de inicio -->
          <form id="orvy-form" class="relative border-t border-neon-cyan/30 px-6 py-4 flex items-center gap-3 bg-gradient-to-r from-gray-900/80 via-gray-800/60 to-gray-900/80 backdrop-blur-sm">
            <!-- Efecto de data stream sutil -->
            <div class="absolute inset-0 bg-gradient-to-r from-transparent via-neon-cyan/3 to-transparent orvy-input-stream pointer-events-none"></div>
            
            <input
              id="orvy-input"
              type="text"
              required
              autocomplete="off"
              placeholder="Escribe tu mensaje..."
              aria-label="Campo de texto para escribir tu pregunta a Orvi"
              aria-required="true"
              class="relative z-10 flex-1 bg-gray-800/80 border-2 border-neon-cyan/30 rounded-xl px-5 py-3 text-base text-gray-100 placeholder-gray-400 focus:outline-none focus:border-neon-cyan/60 focus:bg-gray-800/90 focus:ring-2 focus:ring-neon-cyan/30 focus:shadow-lg focus:shadow-neon-cyan/20 transition-all orvy-input-glow"
            />
            <button
              type="submit"
              id="orvy-send"
              aria-label="Enviar mensaje a Orvi"
              class="relative z-10 flex items-center justify-center w-12 h-12 rounded-xl bg-gradient-to-br from-neon-cyan to-neon-teal hover:from-neon-cyan/90 hover:to-neon-teal/90 text-white shadow-lg hover:shadow-neon-cyan/50 transition-all disabled:opacity-50 disabled:cursor-not-allowed focus:outline-none focus:ring-2 focus:ring-neon-cyan hover:scale-110 active:scale-95 orvy-send-glow"
            >
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
              </svg>
            </button>
          </form>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  (function () {
    // Prevenir scroll suave en esta página
    const html = document.documentElement;
    const originalScrollBehavior = html.style.scrollBehavior;
    html.style.scrollBehavior = 'auto';
    
    // Función para forzar scroll al top
    const forceScrollToTop = () => {
      window.scrollTo(0, 0);
      document.documentElement.scrollTop = 0;
      document.body.scrollTop = 0;
      if (window.pageYOffset !== 0) {
        window.scrollTo(0, 0);
      }
    };
    
    // Prevenir scroll inmediatamente
    forceScrollToTop();
    
    // Prevenir scroll cuando el DOM esté listo
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        forceScrollToTop();
        // Prevenir scroll después de un pequeño delay
        setTimeout(forceScrollToTop, 0);
        setTimeout(forceScrollToTop, 10);
        setTimeout(forceScrollToTop, 50);
      });
    } else {
      forceScrollToTop();
      setTimeout(forceScrollToTop, 0);
      setTimeout(forceScrollToTop, 10);
      setTimeout(forceScrollToTop, 50);
    }
    
    // Prevenir scroll cuando la página se carga completamente
    window.addEventListener('load', () => {
      forceScrollToTop();
      setTimeout(forceScrollToTop, 0);
      setTimeout(forceScrollToTop, 100);
      setTimeout(forceScrollToTop, 200);
    });
    
    // Prevenir scroll en eventos de Astro (SPA navigation)
    document.addEventListener('astro:page-load', () => {
      forceScrollToTop();
      setTimeout(forceScrollToTop, 0);
      setTimeout(forceScrollToTop, 10);
      setTimeout(forceScrollToTop, 50);
      setTimeout(forceScrollToTop, 100);
      setTimeout(forceScrollToTop, 200);
    });
    
    document.addEventListener('astro:after-swap', () => {
      forceScrollToTop();
      setTimeout(forceScrollToTop, 0);
      setTimeout(forceScrollToTop, 10);
      setTimeout(forceScrollToTop, 50);
      setTimeout(forceScrollToTop, 100);
      setTimeout(forceScrollToTop, 200);
    });
    
    // Prevenir scroll en cada frame por un momento
    let frameCount = 0;
    const preventScrollFrames = () => {
      if (frameCount < 20) {
        forceScrollToTop();
        frameCount++;
        requestAnimationFrame(preventScrollFrames);
      } else {
        // Restaurar scroll suave después de asegurar posición
        html.style.scrollBehavior = originalScrollBehavior || '';
      }
    };
    requestAnimationFrame(preventScrollFrames);
    
    // Remover cualquier hash de la URL que pueda causar scroll
    if (window.location.hash) {
      history.replaceState(null, '', window.location.pathname);
    }
    
    // Prevenir scroll cuando se hace focus en elementos (especialmente el input)
    const preventScrollOnFocus = (e: FocusEvent) => {
      const target = e.target as HTMLElement;
      if (target && (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA')) {
        // Prevenir scroll al hacer focus
        setTimeout(() => {
          forceScrollToTop();
        }, 0);
      }
    };
    document.addEventListener('focusin', preventScrollOnFocus);
    
    const messages = document.getElementById('orvy-messages');
    const form = document.getElementById('orvy-form');
    const input = document.getElementById('orvy-input');
    const sendBtn = document.getElementById('orvy-send');
    const closeBtn = document.getElementById('orvy-close');
    const expandBtn = document.getElementById('orvy-expand');
    // Buscar el contenedor del chat
    const chatContainer = document.getElementById('orvy-chat-container') as HTMLElement;
    
    let isExpanded = false;
    
    // Funcionalidad del botón de cerrar
    closeBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      // Cerrar la página y volver al inicio
      window.location.href = '/';
    });
    
    // Funcionalidad del botón de expandir
    expandBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      if (!chatContainer) return;
      
      isExpanded = !isExpanded;
      const chatSection = document.getElementById('orvy-chat-section') as HTMLElement;
      
      if (isExpanded) {
        // Expandir: hacer fullscreen
        chatContainer.style.position = 'fixed';
        chatContainer.style.top = '0';
        chatContainer.style.left = '0';
        chatContainer.style.right = '0';
        chatContainer.style.bottom = '0';
        chatContainer.style.zIndex = '9999';
        chatContainer.style.borderRadius = '0';
        chatContainer.style.margin = '0';
        if (chatSection) {
          chatSection.style.padding = '0';
          chatSection.style.height = '100vh';
        }
        expandBtn.setAttribute('aria-label', 'Restaurar tamaño');
        expandBtn.setAttribute('title', 'Restaurar tamaño');
        // Cambiar icono a restaurar
        const svg = expandBtn.querySelector('svg');
        if (svg) {
          svg.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 9V4.5M9 9H4.5M9 9L3.75 3.75M9 15v4.5M9 15H4.5M9 15l-5.25 5.25M15 9h4.5M15 9V4.5M15 9l5.25-5.25M15 15h4.5M15 15v4.5m0-4.5l5.25 5.25" />';
        }
      } else {
        // Restaurar: volver al tamaño normal
        chatContainer.style.position = '';
        chatContainer.style.top = '';
        chatContainer.style.left = '';
        chatContainer.style.right = '';
        chatContainer.style.bottom = '';
        chatContainer.style.zIndex = '';
        chatContainer.style.borderRadius = '';
        chatContainer.style.margin = '';
        if (chatSection) {
          chatSection.style.padding = '';
          chatSection.style.height = '';
        }
        expandBtn.setAttribute('aria-label', 'Expandir chat');
        expandBtn.setAttribute('title', 'Expandir chat');
        // Cambiar icono a expandir
        const svg = expandBtn.querySelector('svg');
        if (svg) {
          svg.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" />';
        }
      }
    });

    function appendMessage(text, from) {
      if (!messages) return;
      const wrapper = document.createElement('div');
      wrapper.className = 'flex items-start gap-4 ' + (from === 'user' ? 'justify-end' : '');

      if (from === 'user') {
        const bubble = document.createElement('div');
        bubble.className =
          'relative max-w-[85%] rounded-2xl bg-gradient-to-br from-neon-cyan/40 to-neon-teal/40 border border-neon-cyan/40 px-5 py-4 text-base text-white leading-relaxed shadow-xl animate-message-in orvy-user-message';
        // Efecto de glow profesional en mensajes del usuario
        const glow = document.createElement('div');
        glow.className = 'absolute inset-0 rounded-2xl bg-gradient-to-r from-neon-cyan/15 via-neon-teal/15 to-neon-cyan/15 blur-xl opacity-60 pointer-events-none';
        bubble.appendChild(glow);
        const textNode = document.createElement('span');
        textNode.className = 'relative z-10 drop-shadow-[0_2px_4px_rgba(0,0,0,0.3)]';
        textNode.textContent = text;
        bubble.appendChild(textNode);
        wrapper.appendChild(bubble);
      } else {
        const avatar = document.createElement('div');
        avatar.className =
          'w-10 h-10 rounded-full flex items-center justify-center overflow-hidden flex-shrink-0 ring-2 ring-neon-cyan/40';
        const avatarGlow = document.createElement('div');
        avatarGlow.className = 'absolute inset-0 bg-gradient-to-br from-neon-cyan/20 to-neon-teal/20 rounded-full';
        avatar.appendChild(avatarGlow);
        const img = document.createElement('img');
        img.src = '/orby.png';
        img.alt = 'Orvi - Asistente IA';
        img.className = 'w-full h-full object-cover rounded-full orby-avatar relative z-10';
        avatar.appendChild(img);

        const bubble = document.createElement('div');
        bubble.className =
          'relative max-w-[85%] rounded-2xl bg-gradient-to-br from-gray-800/80 via-gray-800/70 to-gray-800/80 backdrop-blur-md border border-neon-cyan/30 px-5 py-4 text-base text-gray-200 leading-relaxed whitespace-pre-wrap shadow-xl animate-message-in orvy-message-bubble';
        // Efecto de glow profesional en mensajes de Orvi
        const glow = document.createElement('div');
        glow.className = 'absolute inset-0 rounded-2xl bg-gradient-to-r from-neon-cyan/10 via-neon-teal/10 to-neon-cyan/10 blur-xl opacity-60 pointer-events-none';
        bubble.appendChild(glow);
        const textNode = document.createElement('span');
        textNode.className = 'relative z-10 drop-shadow-[0_2px_4px_rgba(0,0,0,0.3)]';
        textNode.textContent = text;
        bubble.appendChild(textNode);

        wrapper.appendChild(avatar);
        wrapper.appendChild(bubble);
      }

      messages.appendChild(wrapper);
      messages.scrollTop = messages.scrollHeight;
    }

    async function sendMessage(message: string) {
      if (!sendBtn || !messages) return;
      sendBtn.disabled = true;
      const typingId = 'orvy-typing';

      const typing = document.createElement('div');
      typing.id = typingId;
      typing.className = 'flex items-start gap-4';
      typing.innerHTML = `
        <div class="w-10 h-10  flex items-center justify-center overflow-hidden flex-shrink-0 ring-2 ring-neon-cyan/30">
          <img src="/orby.png" alt="Orvi - Asistente IA" class="w-full h-full object-cover rounded-full orby-avatar" />
        </div>
        <div class="max-w-[85%] rounded-2xl bg-gradient-to-br from-gray-800/60 via-gray-800/50 to-gray-800/60 backdrop-blur-sm border border-neon-cyan/20 px-5 py-4 text-base text-gray-300">
          <span class="inline-flex gap-1.5 items-center">
            <span class="w-2 h-2 bg-gray-400 animate-pulse"></span>
            <span class="w-2 h-2 rounded-full bg-gray-400/70 animate-pulse" style="animation-delay: 0.15s;"></span>
            <span class="w-2 h-2 rounded-full bg-gray-400/50 animate-pulse" style="animation-delay: 0.3s;"></span>
          </span>
        </div>
      `;
      messages.appendChild(typing);
      messages.scrollTop = messages.scrollHeight;

      try {
        const lang = (localStorage.getItem('language') || 'es');
        const res = await fetch('/api/orvi', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            message,
            pageUrl: '/orvy',
            language: lang,
          }),
        });

        let data = {};
        try {
          data = await res.json();
        } catch (err) {
          console.error('[Orvy] No se pudo parsear la respuesta JSON:', err);
        }

        const typingEl = document.getElementById(typingId);
        if (typingEl) typingEl.remove();

        if (!res.ok || !data?.reply) {
          let errorText =
            (data && data.error) ||
            'Ahora mismo no puedo responder correctamente. Intenta de nuevo en unos segundos o contáctanos por la página de contacto.';

          if (data && data.providerMessage) {
            errorText += '\n\nDetalle técnico:\n' + data.providerMessage;
          }

          appendMessage(errorText, 'orvi');
        } else {
          appendMessage(data.reply, 'orvi');
        }
      } catch (e) {
        console.error('Orvy error', e);
        document.getElementById(typingId)?.remove();
        appendMessage(
          'Hubo un problema al conectar con Orvi. Por favor, intenta de nuevo más tarde o usa el formulario de contacto.',
          'orvi'
        );
      } finally {
        sendBtn.disabled = false;
      }
    }

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!input) return;
      const value = input.value.trim();
      if (!value) return;

      appendMessage(value, 'user');
      input.value = '';
      sendMessage(value);
    });

    // Focus en el input al cargar (sin causar scroll)
    if (input) {
      setTimeout(() => {
        // Guardar posición de scroll antes de hacer focus
        const scrollY = window.scrollY;
        // Usar preventScroll si está disponible (navegadores modernos)
        if ('preventScroll' in (input as any).focus) {
          (input as any).focus({ preventScroll: true });
        } else {
          input.focus();
        }
        // Asegurar que se mantenga en el top después del focus
        requestAnimationFrame(() => {
          window.scrollTo(0, 0);
          document.documentElement.scrollTop = 0;
          document.body.scrollTop = 0;
        });
        // Forzar scroll al top después de un pequeño delay
        setTimeout(forceScrollToTop, 0);
        setTimeout(forceScrollToTop, 10);
      }, 500);
    }
  })();
</script>

