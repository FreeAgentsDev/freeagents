---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DynamicBackground from '../components/DynamicBackground.astro';
---

<Layout title="No Somos una Agencia. Somos un Movimiento | FreeAgents" description="FreeAgents nació de una convicción: la tecnología debe servir a un propósito mayor. Cada proyecto impulsa negocios reales y forma el talento que transformará la industria.">
  <Header />
  
  <main class="pt-20 relative min-h-screen overflow-hidden">
    <!-- Fondo Dinámico Potente para Toda la Vista -->
    <div class="fixed inset-0 -z-10">
      <DynamicBackground type="matrix" color="purple" />
      <DynamicBackground type="circuits" color="pink" />
      <DynamicBackground type="neural" color="blue" />
      
      <!-- Gradientes Animados Múltiples -->
      <div class="absolute inset-0">
        <div class="absolute top-0 left-0 w-full h-full bg-gradient-to-br from-purple-900/30 via-pink-900/20 to-blue-900/30 animate-pulse"></div>
        <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-neon-purple/20 rounded-full blur-3xl animate-pulse"></div>
        <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-neon-pink/20 rounded-full blur-3xl animate-pulse" style="animation-delay: 1s;"></div>
        <div class="absolute top-1/2 right-1/4 w-96 h-96 bg-neon-blue/15 rounded-full blur-3xl animate-pulse" style="animation-delay: 0.5s;"></div>
        <div class="absolute bottom-1/4 left-1/3 w-96 h-96 bg-neon-purple/15 rounded-full blur-3xl animate-pulse" style="animation-delay: 1.5s;"></div>
      </div>
      
      <!-- Grid Pattern Overlay -->
      <div class="absolute inset-0 opacity-10" style="background-image: linear-gradient(rgba(139, 92, 246, 0.2) 1px, transparent 1px), linear-gradient(90deg, rgba(139, 92, 246, 0.2) 1px, transparent 1px); background-size: 50px 50px; animation: grid-move 20s linear infinite;"></div>
    </div>

    <!-- Hero Section Única -->
    <section class="relative py-24 overflow-hidden">
      <div class="container mx-auto px-6 relative z-10">
      
      <div class="container mx-auto px-6 relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center max-w-6xl mx-auto">
          <!-- Hero Image a la izquierda -->
          <div class="order-2 lg:order-1 relative flex justify-center lg:justify-start">
            <div class="relative">
              <div class="absolute inset-0 bg-gradient-to-r from-neon-purple/20 to-neon-pink/20 rounded-3xl blur-2xl transform scale-110"></div>
              <div class="relative bg-gradient-to-br from-gray-800/50 to-gray-900/50 backdrop-blur-sm rounded-3xl p-8 border border-gray-700/50">
                <img 
                  src="/elonmiguesword.png" 
                  alt="FreeAgents Equipo" 
                  class="h-80 rounded-3xl w-auto mx-auto drop-shadow-2xl"
                >
                <div class="absolute -top-4 -right-4 w-8 h-8 bg-neon-purple rounded-full animate-pulse"></div>
                <div class="absolute -bottom-4 -left-4 w-6 h-6 bg-neon-pink rounded-full animate-pulse" style="animation-delay: 0.5s;"></div>
              </div>
            </div>
          </div>
          
          <!-- Content a la derecha -->
          <div class="order-1 lg:order-2 text-center lg:text-left">
            <div class="inline-block px-4 py-2 bg-neon-purple/10 border border-neon-purple/30 rounded-full mb-8">
              <span class="text-neon-purple font-semibold text-sm" data-es="Nuestro Equipo" data-en="Our Team">Nuestro Equipo</span>
            </div>
            
            <h1 class="font-display text-5xl md:text-6xl font-bold mb-6 text-white">
              <span data-es="No Somos una Agencia." data-en="We're Not an Agency.">No Somos una Agencia.</span>
              <br>
              <span class="bg-gradient-to-r from-neon-purple to-neon-pink bg-clip-text text-transparent" data-es="Somos un Movimiento." data-en="We're a Movement.">
                Somos un Movimiento.
              </span>
            </h1>
            
            <p class="text-xl text-gray-300 mb-4" data-es="FreeAgents nació de una convicción: la tecnología debe servir a un propósito mayor. Cada proyecto que desarrollamos impulsa negocios reales y forma el talento que transformará la industria." data-en="FreeAgents was born from a conviction: technology must serve a greater purpose. Every project we develop drives real businesses and shapes the talent that will transform the industry.">
              FreeAgents nació de una <strong class="text-neon-purple">convicción</strong>: la tecnología debe servir a un <strong class="text-neon-pink">propósito mayor</strong>. 
              Cada proyecto que desarrollamos impulsa negocios reales y forma el talento que transformará la industria.
            </p>
            
            <p class="text-lg text-gray-400 mb-8" data-es="No solo construimos código: formamos desarrolladores, impulsamos negocios y creamos impacto social. Cada línea de código que escribimos tiene un propósito." data-en="We don't just build code: we train developers, drive businesses and create social impact. Every line of code we write has a purpose.">
              No solo construimos código: formamos desarrolladores, impulsamos negocios y creamos impacto social. Cada línea de código que escribimos tiene un propósito.
            </p>

            <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
              <a 
                href="/contacto" 
                class="bg-gradient-to-r from-neon-purple to-neon-pink px-10 py-5 rounded-full text-white font-bold text-lg hover:shadow-2xl hover:shadow-neon-purple/30 transition-all duration-300 hover:scale-105"
              >
                <span data-es="Conocer Nuestra Historia" data-en="Learn Our Story">Conocer Nuestra Historia</span>
              </a>
              <a 
                href="/fundacion" 
                class="border-2 border-neon-pink px-10 py-5 rounded-full text-neon-pink font-bold text-lg hover:bg-neon-pink hover:text-white transition-all duration-300 hover:scale-105"
              >
                <span data-es="Ver el Impacto de la Fundación" data-en="See Foundation Impact">Ver el Impacto de la Fundación</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Nuestra Misión -->
    <section class="py-20 relative">
      <div class="container mx-auto px-6 relative z-10">
        <div class="max-w-4xl mx-auto text-center mb-16">
            <div class="inline-block px-4 py-2 bg-neon-blue/10 border border-neon-blue/30 rounded-full mb-6">
              <span class="text-neon-blue font-semibold text-sm">Nuestra Misión</span>
            </div>
            
            <h2 class="font-display text-4xl md:text-5xl font-bold mb-6 text-white">
            <span class="bg-gradient-to-r from-neon-blue to-neon-purple bg-clip-text text-transparent" data-es="Nuestra Misión" data-en="Our Mission">
              Nuestra Misión
            </span>
          </h2>
          <p class="text-xl text-gray-400 leading-relaxed" data-es="Transformamos ideas en soluciones tecnológicas exitosas mientras cultivamos el talento que definirá el futuro de la industria tech. Cada proyecto es una oportunidad de crecimiento, tanto para nuestros clientes como para nuestra comunidad de desarrolladores." data-en="We transform ideas into successful technological solutions while cultivating the talent that will define the future of the tech industry. Every project is an opportunity for growth, both for our clients and for our community of developers.">
            Transformamos ideas en soluciones tecnológicas exitosas mientras cultivamos el <strong class="text-neon-blue">talento que definirá el futuro</strong> de la industria tech. 
            Cada proyecto es una oportunidad de crecimiento, tanto para nuestros clientes como para nuestra comunidad de desarrolladores.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
          <!-- Imagen/Valores a la izquierda -->
          <div class="order-2 md:order-1 relative">
            <div class="bg-gray-900/60 backdrop-blur-sm rounded-2xl p-8 border border-gray-700/50">
              <h4 class="font-display text-2xl font-bold text-white mb-6">Nuestros Valores</h4>
              <div class="space-y-4">
                <div class="flex items-center space-x-3">
                  <div class="w-3 h-3 bg-neon-blue rounded-full"></div>
                  <span class="text-gray-300 font-medium">Excelencia Técnica</span>
                </div>
                <div class="flex items-center space-x-3">
                  <div class="w-3 h-3 bg-neon-purple rounded-full"></div>
                  <span class="text-gray-300 font-medium">Desarrollo del Talento</span>
                </div>
                <div class="flex items-center space-x-3">
                  <div class="w-3 h-3 bg-neon-green rounded-full"></div>
                  <span class="text-gray-300 font-medium">Responsabilidad Social</span>
                </div>
                <div class="flex items-center space-x-3">
                  <div class="w-3 h-3 bg-neon-pink rounded-full"></div>
                  <span class="text-gray-300 font-medium">Innovación Continua</span>
                </div>
                <div class="flex items-center space-x-3">
                  <div class="w-3 h-3 bg-neon-blue rounded-full"></div>
                  <span class="text-gray-300 font-medium">Transparencia</span>
                </div>
                <div class="flex items-center space-x-3">
                  <div class="w-3 h-3 bg-neon-purple rounded-full"></div>
                  <span class="text-gray-300 font-medium">Colaboración</span>
                </div>
              </div>
            </div>
          </div>
          
          <!-- Contenido a la derecha -->
          <div class="order-1 md:order-2">
              <h3 class="font-display text-3xl font-bold text-white mb-6" data-es="¿Por qué FreeAgents?" data-en="Why FreeAgents?">¿Por qué FreeAgents?</h3>
            <div class="space-y-6">
              <div class="flex items-start space-x-4">
                <div class="w-12 h-12 bg-gradient-to-r from-neon-blue to-neon-purple rounded-xl flex items-center justify-center flex-shrink-0">
                  <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                  </svg>
                </div>
                <div>
                  <h4 class="font-semibold text-white mb-2" data-es="Equipo que Combina Experiencia con Talento Emergente" data-en="Team that Combines Experience with Emerging Talent">Equipo que Combina Experiencia con Talento Emergente</h4>
                  <p class="text-gray-400" data-es="Nuestro modelo único combina experiencia senior con talento emergente. Resultado: soluciones innovadoras con calidad enterprise garantizada por mentores experimentados." data-en="Our unique model combines senior experience with emerging talent. Result: innovative solutions with enterprise quality guaranteed by experienced mentors.">
                    Nuestro modelo único combina <strong class="text-neon-blue">experiencia senior</strong> con <strong class="text-neon-purple">talento emergente</strong>. Resultado: soluciones innovadoras con calidad enterprise garantizada por mentores experimentados.
                  </p>
                </div>
              </div>

              <div class="flex items-start space-x-4">
                <div class="w-12 h-12 bg-gradient-to-r from-neon-purple to-neon-pink rounded-xl flex items-center justify-center flex-shrink-0">
                  <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                  </svg>
                </div>
                <div>
                  <h4 class="font-semibold text-white mb-2" data-es="Cada Proyecto Contribuye al Desarrollo del Talento Tech" data-en="Every Project Contributes to Tech Talent Development">Cada Proyecto Contribuye al Desarrollo del Talento Tech</h4>
                  <p class="text-gray-400" data-es="A través de la Fundación FreeAgents, cada proyecto forma desarrolladores junior en proyectos reales. Tu inversión no solo impulsa tu negocio, sino que también crea impacto social medible." data-en="Through the FreeAgents Foundation, every project trains junior developers on real projects. Your investment not only drives your business, but also creates measurable social impact.">
                    A través de la <strong class="text-neon-purple">Fundación FreeAgents</strong>, cada proyecto forma desarrolladores junior en proyectos reales. Tu inversión no solo impulsa tu negocio, sino que también crea impacto social medible.
                  </p>
                </div>
              </div>

              <div class="flex items-start space-x-4">
                <div class="w-12 h-12 bg-gradient-to-r from-neon-green to-neon-blue rounded-xl flex items-center justify-center flex-shrink-0">
                  <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path>
                  </svg>
                </div>
                <div>
                  <h4 class="font-semibold text-white mb-2" data-es="Metodologías Probadas, Comunicación Transparente" data-en="Proven Methodologies, Transparent Communication">Metodologías Probadas, Comunicación Transparente</h4>
                  <p class="text-gray-400" data-es="Nuestro modelo de mentoría asegura que cada línea de código cumpla con los más altos estándares de calidad. Comunicación clara en cada etapa, sin jerga técnica innecesaria." data-en="Our mentorship model ensures that every line of code meets the highest quality standards. Clear communication at every stage, without unnecessary technical jargon.">
                    Nuestro modelo de mentoría asegura que cada línea de código cumpla con los <strong class="text-neon-green">más altos estándares de calidad</strong>. Comunicación clara en cada etapa, sin jerga técnica innecesaria.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- El Equipo -->
    <section class="py-20 relative">
      <div class="container mx-auto px-6 relative z-10">
        <div class="text-center mb-16">
          <h2 class="font-display text-4xl md:text-5xl font-bold mb-6">
            <span class="bg-gradient-to-r from-neon-blue to-neon-purple bg-clip-text text-transparent">
              Nuestro Equipo
            </span>
          </h2>
          <p class="text-xl text-gray-400 max-w-3xl mx-auto">
            Un equipo diverso de profesionales apasionados por la tecnología y comprometidos con la excelencia.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
          <!-- Fundador 1 -->
          <div class="bg-gray-800/60 backdrop-blur-sm rounded-2xl p-8 border border-gray-700/50 text-center group hover:border-neon-blue/50 transition-all duration-300">
            <div class="w-24 h-24 bg-gradient-to-r from-neon-blue to-neon-purple rounded-full flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform duration-300">
              <img src="/pfp/migue.png" alt="CEO" class="h-16 w-16 rounded-full">
            </div>
            <h3 class="font-display text-xl font-bold text-white mb-2">Miguel Gallego</h3>
            <p class="text-neon-blue font-semibold mb-4">Fundador y Frontend dev</p>
            <p class="text-gray-400 mb-6">
              Entusiasta detrás de la Fundación FreeAgents con experiencia trabajando para diversas empresas como fulltime y freelance.
            </p>
            <div class="flex justify-center space-x-4">
              <a href="https://www.linkedin.com/in/miguel-angel-gallego-alvarez-71398625b/" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-neon-blue transition-colors duration-300">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
              </a>
              <a href="https://github.com/m1gue21" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-neon-blue transition-colors duration-300">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 0.297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.387.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.416-4.042-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.084-.729.084-.729 1.205.084 1.84 1.236 1.84 1.236 1.07 1.834 2.809 1.304 3.495.997.108-.775.418-1.305.762-1.605-2.665-.305-5.466-1.334-5.466-5.931 0-1.31.469-2.381 1.236-3.221-.124-.303-.535-1.523.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.553 3.297-1.23 3.297-1.23.653 1.653.242 2.873.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.803 5.624-5.475 5.921.43.372.823 1.102.823 2.222 0 1.606-.014 2.898-.014 3.293 0 .322.216.694.825.576C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
                </svg>
              </a>
            </div>
          </div>

          <!-- juandagallego-->
          <div class="bg-gray-800/60 backdrop-blur-sm rounded-2xl p-8 border border-gray-700/50 text-center group hover:border-neon-purple/50 transition-all duration-300">
            <div class="w-24 h-24 bg-gradient-to-r from-neon-purple to-neon-pink rounded-full flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform duration-300">
              <img src="/pfp/juan.png" alt="CTO" class="h-16 w-16 rounded-full">
            </div>
            <h3 class="font-display text-xl font-bold text-white mb-2">Juan David Gallego</h3>
            <p class="text-neon-purple font-semibold mb-4">Mentor y Fullstack Dev</p>
            <p class="text-gray-400 mb-6">
              Desarrollador con varios años de experiencia en el campo del desarrollo y la gestion de proyectos.
            </p>
            <div class="flex justify-center space-x-4">
              <a href="https://www.linkedin.com/in/juanda-dev/" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-neon-purple transition-colors duration-300">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
              </a>
              <a href="https://github.com/Galleguista" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-neon-blue transition-colors duration-300">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 0.297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.387.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.416-4.042-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.084-.729.084-.729 1.205.084 1.84 1.236 1.84 1.236 1.07 1.834 2.809 1.304 3.495.997.108-.775.418-1.305.762-1.605-2.665-.305-5.466-1.334-5.466-5.931 0-1.31.469-2.381 1.236-3.221-.124-.303-.535-1.523.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.553 3.297-1.23 3.297-1.23.653 1.653.242 2.873.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.803 5.624-5.475 5.921.43.372.823 1.102.823 2.222 0 1.606-.014 2.898-.014 3.293 0 .322.216.694.825.576C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
                </svg>
              </a>
            </div>
          </div>

          <!-- Jerónimo Mayorca -->
          <div class="bg-gray-800/60 backdrop-blur-sm rounded-2xl p-8 border border-gray-700/50 text-center group hover:border-neon-green/50 transition-all duration-300">
            <div class="w-24 h-24 bg-gradient-to-r from-neon-green to-neon-blue rounded-full flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform duration-300">
              <img src="/pfp/mayorca.png" alt="Jerónimo Mayorca - Developer" class="h-16 w-16 rounded-full object-cover">
            </div>
            <h3 class="font-display text-xl font-bold text-white mb-2">Jerónimo Mayorca</h3>
            <p class="text-neon-green font-semibold mb-4">Developer</p>
            <p class="text-gray-400 mb-6">
              Desarrollador apasionado por la tecnología, comprometido con la excelencia y la innovación.
            </p>
            <div class="flex justify-center space-x-4">
              <a href="#" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-neon-green transition-colors duration-300">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
