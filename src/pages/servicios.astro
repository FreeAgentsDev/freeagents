---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DynamicBackground from '../components/DynamicBackground.astro';
---

<Layout title="Servicios - FreeAgents | Software Factory" description="Desarrollo a la medida, apps móviles y e-commerce. Soluciones tecnológicas profesionales construidas con metodologías ágiles y equipo especializado.">
  <Header />
  
  <main class="pt-20 relative min-h-screen overflow-hidden">
    <!-- Fondo Dinámico Potente para Toda la Vista -->
    <div class="fixed inset-0 -z-10">
      <DynamicBackground type="circuits" color="cyan" />
      <DynamicBackground type="neural" color="teal" />
      <DynamicBackground type="particles" color="cyan" />
      
      <!-- Gradientes Animados Múltiples -->
      <div class="absolute inset-0">
        <div class="absolute top-0 left-0 w-full h-full bg-gradient-to-br from-cyan-900/30 via-teal-900/20 to-blue-900/30 animate-pulse"></div>
        <div class="absolute top-1/4 right-1/4 w-96 h-96 bg-neon-cyan/20 rounded-full blur-3xl animate-pulse"></div>
        <div class="absolute bottom-1/4 left-1/4 w-96 h-96 bg-neon-teal/20 rounded-full blur-3xl animate-pulse" style="animation-delay: 1s;"></div>
        <div class="absolute top-1/2 left-1/2 w-96 h-96 bg-neon-blue/15 rounded-full blur-3xl animate-pulse" style="animation-delay: 0.5s;"></div>
      </div>
      
      <!-- Grid Pattern Overlay -->
      <div class="absolute inset-0 opacity-10" style="background-image: linear-gradient(rgba(0, 212, 255, 0.2) 1px, transparent 1px), linear-gradient(90deg, rgba(0, 212, 255, 0.2) 1px, transparent 1px); background-size: 50px 50px; animation: grid-move 20s linear infinite;"></div>
    </div>

    <!-- Hero Section Única -->
    <section class="relative py-24 overflow-hidden">
      
      <div class="container mx-auto px-6 relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center max-w-6xl mx-auto">
          <!-- Hero Image a la izquierda -->
          <div class="order-2 lg:order-1 relative flex justify-center lg:justify-start">
            <div class="relative">
              <!-- Glow effect behind image -->
              <div class="absolute inset-0 bg-gradient-to-r from-neon-cyan/20 to-neon-teal/20 rounded-3xl blur-2xl transform scale-110"></div>
              
              <!-- Main image container -->
              <div class="relative bg-gradient-to-br from-gray-800/50 to-gray-900/50 backdrop-blur-sm rounded-3xl p-8 border border-gray-700/50">
                <img 
                  src="/servicesfreeagents.png" 
                  alt="FreeAgents Servicios" 
                  class="h-80 rounded-3xl w-auto mx-auto animate-float drop-shadow-2xl"
                >
                
                <!-- Decorative elements -->
                <div class="absolute -top-4 -right-4 w-8 h-8 bg-neon-cyan rounded-full animate-pulse"></div>
                <div class="absolute -bottom-4 -left-4 w-6 h-6 bg-neon-teal rounded-full animate-pulse" style="animation-delay: 0.5s;"></div>
              </div>
            </div>
          </div>
          
          <!-- Content a la derecha -->
          <div class="order-1 lg:order-2 text-center lg:text-left">
            <div class="inline-block px-4 py-2 bg-neon-cyan/10 border border-neon-cyan/30 rounded-full mb-8">
              <span class="text-neon-cyan font-semibold text-sm" data-es="Nuestros Servicios" data-en="Our Services">Nuestros Servicios</span>
            </div>
            
            <h1 class="font-display text-5xl md:text-6xl font-bold mb-6 text-white">
              <span data-es="Soluciones Tecnológicas" data-en="Technological Solutions">Soluciones Tecnológicas</span>
              <br>
              <span class="bg-gradient-to-r from-neon-cyan to-neon-teal bg-clip-text text-transparent" data-es="a la Medida" data-en="Custom Made">
                a la Medida
              </span>
            </h1>
            
            <p class="text-xl text-gray-300 mb-4" data-es="Como Software Factory, construimos soluciones que se adaptan perfectamente a las necesidades de tu negocio." data-en="As a Software Factory, we build solutions that perfectly adapt to your business needs.">
              Como <strong class="text-neon-cyan">Software Factory</strong>, construimos soluciones que se adaptan perfectamente 
              a las necesidades de tu negocio.
            </p>
            
            <p class="text-lg text-gray-400 mb-8" data-es="Equipo especializado, metodologías profesionales y tecnologías de vanguardia para cada proyecto." data-en="Specialized team, professional methodologies and cutting-edge technologies for each project.">
              Equipo especializado, metodologías profesionales y tecnologías de vanguardia para cada proyecto.
            </p>

            <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
              <a 
                href="/contacto" 
                class="bg-gradient-to-r from-neon-cyan to-neon-teal px-10 py-5 rounded-full text-white font-bold text-lg hover:shadow-2xl hover:shadow-neon-cyan/30 transition-all duration-300 hover:scale-105"
              >
                <span data-es="Solicitar Cotización" data-en="Request Quote">Solicitar Cotización</span>
              </a>
              <a 
                href="/portafolio" 
                class="border-2 border-neon-teal px-10 py-5 rounded-full text-neon-teal font-bold text-lg hover:bg-neon-teal hover:text-white transition-all duration-300 hover:scale-105"
              >
                <span data-es="Ver Proyectos" data-en="View Projects">Ver Proyectos</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Desarrollo a la Medida -->
    <section class="py-20 relative">
      <div class="container mx-auto px-6 relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <!-- Imagen a la izquierda -->
          <div class="order-2 lg:order-1 relative">
            <div class="bg-gray-900/60 backdrop-blur-sm rounded-2xl p-8 border border-gray-700/50">
              <h3 class="font-display text-2xl font-bold text-white mb-6">Ejemplos de Proyectos</h3>
              <div class="space-y-6">
                <div class="border-l-4 border-neon-blue pl-4">
                  <h4 class="font-semibold text-white mb-2">Sistema de Gestión Empresarial</h4>
                  <p class="text-gray-400 text-sm">CRM + ERP integrado para empresa de logística con 10,000+ usuarios activos</p>
                </div>
                <div class="border-l-4 border-neon-purple pl-4">
                  <h4 class="font-semibold text-white mb-2">Plataforma de Análisis de Datos</h4>
                  <p class="text-gray-400 text-sm">Dashboard con IA predictiva para empresa fintech, procesando miles transacciones diarias</p>
                </div>
                <div class="border-l-4 border-neon-green pl-4">
                  <h4 class="font-semibold text-white mb-2">Sistema de Automatización</h4>
                  <p class="text-gray-400 text-sm">Workflow personalizado y planificado especificamente para la reducción el tiempo de procesos manuales</p>
                </div>
              </div>
            </div>
          </div>
          
          <!-- Contenido a la derecha -->
          <div class="order-1 lg:order-2">
            <div class="mb-8">
              <div class="w-20 h-20 bg-gradient-to-r from-neon-blue to-neon-purple rounded-2xl flex items-center justify-center mb-6">
                <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
                </svg>
              </div>
              <h2 class="font-display text-4xl md:text-5xl font-bold mb-6">
                <span class="bg-gradient-to-r from-neon-blue to-neon-purple bg-clip-text text-transparent" data-es="Desarrollo a la Medida" data-en="Custom Development">
                  Desarrollo a la Medida
                </span>
              </h2>
              <p class="text-xl text-gray-400 mb-8" data-es="Creamos soluciones únicas que se adaptan perfectamente a las necesidades específicas de tu emprendimiento. Cada línea de código está pensada para impulsar tu crecimiento." data-en="We create unique solutions that perfectly adapt to the specific needs of your venture. Every line of code is designed to drive your growth.">
                Creamos soluciones únicas que se adaptan perfectamente a las necesidades específicas de tu emprendimiento. Cada línea de código está pensada para impulsar tu crecimiento.
              </p>
            </div>

            <div class="space-y-6 mb-8">
              <div class="flex items-start space-x-4">
                <div class="w-8 h-8 bg-neon-blue/20 rounded-lg flex items-center justify-center flex-shrink-0 mt-1">
                  <svg class="w-5 h-5 text-neon-blue" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                </div>
                <div>
                  <h3 class="font-semibold text-white mb-2">Sistemas Web Personalizados</h3>
                  <p class="text-gray-400">Plataformas robustas diseñadas específicamente para tu modelo de negocio y procesos únicos.</p>
                </div>
              </div>

              <div class="flex items-start space-x-4">
                <div class="w-8 h-8 bg-neon-blue/20 rounded-lg flex items-center justify-center flex-shrink-0 mt-1">
                  <svg class="w-5 h-5 text-neon-blue" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                </div>
                <div>
                  <h3 class="font-semibold text-white mb-2">APIs y Microservicios</h3>
                  <p class="text-gray-400">Arquitecturas escalables que permiten integración fluida con otros sistemas y futuras expansiones.</p>
                </div>
              </div>

              <div class="flex items-start space-x-4">
                <div class="w-8 h-8 bg-neon-blue/20 rounded-lg flex items-center justify-center flex-shrink-0 mt-1">
                  <svg class="w-5 h-5 text-neon-blue" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                </div>
                <div>
                  <h3 class="font-semibold text-white mb-2">Integración de Sistemas</h3>
                  <p class="text-gray-400">Conectamos tus herramientas existentes para crear un ecosistema tecnológico cohesivo.</p>
                </div>
              </div>
            </div>

            <div class="bg-gradient-to-r from-neon-blue/10 to-neon-purple/10 border border-neon-blue/30 rounded-2xl p-6 mb-8">
              <h4 class="font-semibold text-white mb-3">💡 Respaldado por Talento en Evolución</h4>
              <p class="text-gray-300">
                Nuestro equipo de desarrollo se nutre constantemente del talento cultivado en la Fundación FreeAgents, 
                asegurando que cada proyecto incorpore las últimas innovaciones y enfoques frescos del desarrollo de software.
              </p>
            </div>

            <a href="/contacto" class="bg-gradient-to-r from-neon-blue to-neon-purple px-8 py-4 rounded-full text-white font-semibold text-lg hover:shadow-lg hover:shadow-neon-blue/25 transition-all duration-300 hover:scale-105 inline-block">
              Hablar con un Experto
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Apps para Emprendedores -->
    <section class="py-20 relative">
      <div class="container mx-auto px-6 relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div class="order-2 lg:order-1 relative">
            <div class="bg-gray-800/60 backdrop-blur-sm rounded-2xl p-8 border border-gray-700/50">
              <h3 class="font-display text-2xl font-bold text-white mb-6">Tipos de Apps que Desarrollamos</h3>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="bg-gray-900 p-4 rounded-xl border border-gray-600">
                  <div class="w-12 h-12 bg-gradient-to-r from-neon-purple to-neon-pink rounded-lg flex items-center justify-center mb-3">
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
                    </svg>
                  </div>
                  <h4 class="font-semibold text-white mb-2">Apps Nativas</h4>
                  <p class="text-gray-400 text-sm">iOS y Android con rendimiento óptimo</p>
                </div>
                <div class="bg-gray-900 p-4 rounded-xl border border-gray-600">
                  <div class="w-12 h-12 bg-gradient-to-r from-neon-blue to-neon-green rounded-lg flex items-center justify-center mb-3">
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9v-9m0-9v9"></path>
                    </svg>
                  </div>
                  <h4 class="font-semibold text-white mb-2">PWAs</h4>
                  <p class="text-gray-400 text-sm">Progressive Web Apps multiplataforma</p>
                </div>
                <div class="bg-gray-900 p-4 rounded-xl border border-gray-600">
                  <div class="w-12 h-12 bg-gradient-to-r from-neon-green to-neon-blue rounded-lg flex items-center justify-center mb-3">
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
                    </svg>
                  </div>
                  <h4 class="font-semibold text-white mb-2">Apps IoT</h4>
                  <p class="text-gray-400 text-sm">Conectividad con dispositivos inteligentes</p>
                </div>
                <div class="bg-gray-900 p-4 rounded-xl border border-gray-600">
                  <div class="w-12 h-12 bg-gradient-to-r from-neon-pink to-neon-purple rounded-lg flex items-center justify-center mb-3">
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                    </svg>
                  </div>
                  <h4 class="font-semibold text-white mb-2">Apps en Tiempo Real</h4>
                  <p class="text-gray-400 text-sm">Chat, notificaciones y actualizaciones live</p>
                </div>
              </div>
            </div>
          </div>

          <div class="order-1 lg:order-2">
            <div class="mb-8">
              <div class="w-20 h-20 bg-gradient-to-r from-neon-purple to-neon-pink rounded-2xl flex items-center justify-center mb-6">
                <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
                </svg>
              </div>
              <h2 class="font-display text-4xl md:text-5xl font-bold mb-6">
                <span class="bg-gradient-to-r from-neon-purple to-neon-pink bg-clip-text text-transparent">
                  Apps para Emprendedores
                </span>
              </h2>
              <p class="text-xl text-gray-400 mb-8">
                Desarrollamos aplicaciones que conectan tu negocio con tus clientes de manera intuitiva y eficiente. 
                Cada app está diseñada para maximizar el engagement y optimizar la experiencia de usuario.
              </p>
            </div>

            <div class="space-y-6 mb-8">
              <div class="flex items-start space-x-4">
                <div class="w-8 h-8 bg-neon-purple/20 rounded-lg flex items-center justify-center flex-shrink-0 mt-1">
                  <svg class="w-5 h-5 text-neon-purple" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                </div>
                <div>
                  <h3 class="font-semibold text-white mb-2">UX/UI Centrado en Conversión</h3>
                  <p class="text-gray-400">Diseños que no solo se ven bien, sino que convierten usuarios en clientes leales.</p>
                </div>
              </div>

              <div class="flex items-start space-x-4">
                <div class="w-8 h-8 bg-neon-purple/20 rounded-lg flex items-center justify-center flex-shrink-0 mt-1">
                  <svg class="w-5 h-5 text-neon-purple" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                </div>
                <div>
                  <h3 class="font-semibold text-white mb-2">Integración con Ecosistemas</h3>
                  <p class="text-gray-400">Conectamos tu app con redes sociales, sistemas de pago y herramientas de marketing.</p>
                </div>
              </div>

              <div class="flex items-start space-x-4">
                <div class="w-8 h-8 bg-neon-purple/20 rounded-lg flex items-center justify-center flex-shrink-0 mt-1">
                  <svg class="w-5 h-5 text-neon-purple" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                </div>
                <div>
                  <h3 class="font-semibold text-white mb-2">Analytics y Optimización</h3>
                  <p class="text-gray-400">Métricas detalladas para entender el comportamiento de tus usuarios y optimizar continuamente.</p>
                </div>
              </div>
            </div>

            <div class="bg-gradient-to-r from-neon-purple/10 to-neon-pink/10 border border-neon-purple/30 rounded-2xl p-6 mb-8">
              <h4 class="font-semibold text-white mb-3">🚀 Innovación Constante</h4>
              <p class="text-gray-300">
                Nuestro equipo de desarrollo móvil se mantiene actualizado con las últimas tendencias gracias a los 
                programas de formación continua de la Fundación, garantizando apps de vanguardia.
              </p>
            </div>

            <a href="/contacto" class="bg-gradient-to-r from-neon-purple to-neon-pink px-8 py-4 rounded-full text-white font-semibold text-lg hover:shadow-lg hover:shadow-neon-purple/25 transition-all duration-300 hover:scale-105 inline-block">
              Solicitar Cotización
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- E-commerce -->
    <section class="py-20 relative">
      <div class="container mx-auto px-6 relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <!-- Imagen a la izquierda -->
          <div class="order-2 lg:order-1 relative">
            <div class="bg-gray-900/60 backdrop-blur-sm rounded-2xl p-8 border border-gray-700/50">
              <h3 class="font-display text-2xl font-bold text-white mb-6">Funcionalidades Avanzadas</h3>
              <div class="space-y-4">
                <div class="flex items-center justify-between p-4 bg-gray-800 rounded-xl">
                  <span class="text-white font-medium">Catálogo Inteligente</span>
                  <div class="w-3 h-3 bg-neon-green rounded-full"></div>
                </div>
                <div class="flex items-center justify-between p-4 bg-gray-800 rounded-xl">
                  <span class="text-white font-medium">Checkout Optimizado</span>
                  <div class="w-3 h-3 bg-neon-blue rounded-full"></div>
                </div>
                <div class="flex items-center justify-between p-4 bg-gray-800 rounded-xl">
                  <span class="text-white font-medium">Multi-idioma y Multi-moneda</span>
                  <div class="w-3 h-3 bg-neon-purple rounded-full"></div>
                </div>
                <div class="flex items-center justify-between p-4 bg-gray-800 rounded-xl">
                  <span class="text-white font-medium">SEO Avanzado</span>
                  <div class="w-3 h-3 bg-neon-pink rounded-full"></div>
                </div>
                <div class="flex items-center justify-between p-4 bg-gray-800 rounded-xl">
                  <span class="text-white font-medium">Analytics en Tiempo Real</span>
                  <div class="w-3 h-3 bg-neon-green rounded-full"></div>
                </div>
                <div class="flex items-center justify-between p-4 bg-gray-800 rounded-xl">
                  <span class="text-white font-medium">Integración con ERP/CRM</span>
                  <div class="w-3 h-3 bg-neon-blue rounded-full"></div>
                </div>
              </div>

              <div class="mt-8 p-6 bg-gradient-to-r from-gray-800 to-gray-700 rounded-xl">
                <h4 class="font-semibold text-white mb-3">📊 Casos de Éxito</h4>
                <div class="text-sm text-gray-300 space-y-2">
                  <p>• Tienda de moda: +300% conversión en 6 meses</p>
                  <p>• Marketplace B2B: 50,000+ productos gestionados</p>
                  <p>• E-commerce internacional: 15 países, 8 idiomas</p>
                </div>
              </div>
            </div>
          </div>
          
          <!-- Contenido a la derecha -->
          <div class="order-1 lg:order-2">
            <div class="mb-8">
              <div class="w-20 h-20 bg-gradient-to-r from-neon-green to-neon-blue rounded-2xl flex items-center justify-center mb-6">
                <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
                </svg>
              </div>
              <h2 class="font-display text-4xl md:text-5xl font-bold mb-6">
                <span class="bg-gradient-to-r from-neon-green to-neon-blue bg-clip-text text-transparent">
                  E-commerce Avanzado
                </span>
              </h2>
              <p class="text-xl text-gray-400 mb-8">
                Construimos tiendas online que no solo venden productos, sino que crean experiencias de compra 
                memorables que fidelizan clientes y maximizan conversiones.
              </p>
            </div>

            <div class="space-y-6 mb-8">
              <div class="flex items-start space-x-4">
                <div class="w-8 h-8 bg-neon-green/20 rounded-lg flex items-center justify-center flex-shrink-0 mt-1">
                  <svg class="w-5 h-5 text-neon-green" fill="currentColor" viewBox="0 0 20 20">
