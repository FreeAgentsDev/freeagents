---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DynamicBackground from '../components/DynamicBackground.astro';
---

<Layout title="Servicios - FreeAgents | Software Factory" description="Desarrollo a la medida, apps móviles y e-commerce. Soluciones tecnológicas profesionales construidas con metodologías ágiles y equipo especializado.">
  <Header />
  
  <main class="pt-20 relative min-h-screen overflow-hidden">
    <!-- Fondo Dinámico -->
    <div class="fixed inset-0 -z-10">
      <DynamicBackground type="circuits" color="cyan" />
      <DynamicBackground type="neural" color="teal" />
      <DynamicBackground type="particles" color="cyan" />
      
      <div class="absolute inset-0">
        <div class="absolute top-0 left-0 w-full h-full bg-gradient-to-br from-cyan-900/30 via-teal-900/20 to-blue-900/30 animate-pulse"></div>
        <div class="absolute top-1/4 right-1/4 w-96 h-96 bg-neon-cyan/20 rounded-full blur-3xl animate-pulse"></div>
        <div class="absolute bottom-1/4 left-1/4 w-96 h-96 bg-neon-teal/20 rounded-full blur-3xl animate-pulse" style="animation-delay: 1s;"></div>
      </div>
      
      <div class="absolute inset-0 opacity-10" style="background-image: linear-gradient(rgba(0, 212, 255, 0.2) 1px, transparent 1px), linear-gradient(90deg, rgba(0, 212, 255, 0.2) 1px, transparent 1px); background-size: 50px 50px; animation: grid-move 20s linear infinite;"></div>
    </div>

    <!-- Hero Section -->
    <section class="relative py-20 overflow-hidden">
      <div class="container mx-auto px-6 relative z-10">
        <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <!-- Columna texto -->
          <div class="text-center lg:text-left">
            <div class="inline-block px-4 py-2 bg-neon-cyan/10 border border-neon-cyan/30 rounded-full mb-6">
              <span class="text-neon-cyan font-semibold text-sm" data-es="Nuestros Servicios" data-en="Our Services">Nuestros Servicios</span>
            </div>
            
            <h1 class="font-display text-5xl md:text-6xl font-bold mb-6 text-white">
              <span data-es="Soluciones Tecnológicas" data-en="Technological Solutions">Soluciones Tecnológicas</span>
              <br>
              <span class="bg-gradient-to-r from-neon-cyan to-neon-teal bg-clip-text text-transparent" data-es="a la Medida" data-en="Custom Made">a la Medida</span>
            </h1>
            
            <p class="text-xl text-gray-300 mb-6 max-w-xl" data-es="Transforma tu negocio con tecnología que realmente funciona. Software personalizado que se adapta a TI, no al revés." data-en="Transform your business with technology that actually works. Custom software that adapts to YOU, not the other way around.">
              Transforma tu negocio con tecnología que <strong class="text-neon-cyan">realmente funciona</strong>. Software personalizado que se adapta a <strong class="text-neon-cyan">TI</strong>, no al revés.
            </p>

            <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
              <a href="/contacto" class="bg-gradient-to-r from-neon-cyan to-neon-teal px-10 py-5 rounded-full text-white font-bold text-lg hover:shadow-2xl hover:shadow-neon-cyan/30 transition-all duration-300 hover:scale-105">
                <span data-es="Solicitar Cotización" data-en="Request Quote">Solicitar Cotización</span>
              </a>
              <a href="/portafolio" class="border-2 border-neon-teal px-10 py-5 rounded-full text-neon-teal font-bold text-lg hover:bg-neon-teal hover:text-white transition-all duration-300 hover:scale-105">
                <span data-es="Ver Proyectos" data-en="View Projects">Ver Proyectos</span>
              </a>
            </div>
          </div>

          <!-- Columna imagen -->
          <div class="relative flex justify-center lg:justify-end">
            <div class="relative">
              <div class="absolute inset-0 bg-gradient-to-r from-neon-cyan/20 to-neon-teal/20 rounded-3xl blur-2xl transform scale-110"></div>
              <div class="relative bg-gradient-to-br from-gray-800/50 to-gray-900/50 backdrop-blur-sm rounded-3xl p-6 border border-gray-700/50">
                <img 
                  src="/servicesfreeagents.png" 
                  alt="Servicios de FreeAgents" 
                  class="h-72 md:h-80 rounded-2xl w-auto mx-auto drop-shadow-2xl"
                  loading="lazy"
                >
                <div class="absolute -top-4 -right-4 w-8 h-8 bg-neon-cyan rounded-full animate-pulse"></div>
                <div class="absolute -bottom-4 -left-4 w-6 h-6 bg-neon-teal rounded-full animate-pulse" style="animation-delay: 0.5s;"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Servicios Principales - Grid Compacto -->
    <section class="py-16 relative">
      <div class="container mx-auto px-6 relative z-10">
        <div class="max-w-7xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-bold text-center mb-12 text-white">
            <span class="bg-gradient-to-r from-neon-blue to-neon-purple bg-clip-text text-transparent" data-es="Nuestros Servicios" data-en="Our Services">Nuestros Servicios</span>
          </h2>
          
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <!-- Desarrollo a la Medida -->
            <div class="group bg-gray-900/60 backdrop-blur-sm rounded-2xl p-6 border border-gray-700/50 hover:border-neon-blue/50 transition-all duration-300 hover:scale-105">
              <div class="w-16 h-16 bg-gradient-to-r from-neon-blue to-neon-purple rounded-xl flex items-center justify-center mb-4">
                <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
                </svg>
              </div>
              <h3 class="text-xl font-bold text-white mb-2" data-es="Desarrollo a la Medida" data-en="Custom Development">Desarrollo a la Medida</h3>
              <p class="text-gray-400 mb-4 text-sm" data-es="Sistemas únicos diseñados exclusivamente para tu negocio. Más eficiente, más competitivo y más rentable." data-en="Unique systems designed exclusively for your business. More efficient, more competitive and more profitable.">
                Sistemas únicos diseñados exclusivamente para tu negocio. Más eficiente, más competitivo y más rentable.
              </p>
              <div class="flex items-center justify-between mb-4">
                <div>
                  <p class="text-2xl font-bold text-neon-blue">$1,200 USD</p>
                  <p class="text-gray-400 text-sm">$5.000.000 COP</p>
                </div>
              </div>
              <a href="/contacto" class="block w-full text-center bg-gradient-to-r from-neon-blue/20 to-neon-purple/20 border border-neon-blue/30 rounded-lg py-2 text-white font-semibold hover:from-neon-blue/30 hover:to-neon-purple/30 transition-all">
                <span data-es="Más Info" data-en="More Info">Más Info</span>
              </a>
            </div>

            <!-- E-commerce -->
            <div class="group bg-gray-900/60 backdrop-blur-sm rounded-2xl p-6 border border-gray-700/50 hover:border-neon-green/50 transition-all duration-300 hover:scale-105">
              <div class="w-16 h-16 bg-gradient-to-r from-neon-green to-neon-blue rounded-xl flex items-center justify-center mb-4">
                <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
                </svg>
              </div>
              <h3 class="text-xl font-bold text-white mb-2" data-es="E-commerce Profesional" data-en="Professional E-commerce">E-commerce Profesional</h3>
              <p class="text-gray-400 mb-4 text-sm" data-es="Tu máquina de ventas 24/7. Convierte visitantes en clientes y escala sin límites." data-en="Your 24/7 sales machine. Converts visitors into customers and scales without limits.">
                Tu máquina de ventas 24/7. Convierte visitantes en clientes y escala sin límites.
              </p>
              <div class="mb-4">
                <p class="text-gray-300 text-sm mb-2" data-es="Desde:" data-en="From:">Desde:</p>
                <p class="text-2xl font-bold text-neon-green">$800 USD</p>
                <p class="text-gray-400 text-sm">$3.300.000 COP</p>
              </div>
              <a href="/contacto" class="block w-full text-center bg-gradient-to-r from-neon-green/20 to-neon-blue/20 border border-neon-green/30 rounded-lg py-2 text-white font-semibold hover:from-neon-green/30 hover:to-neon-blue/30 transition-all">
                <span data-es="Ver Planes" data-en="View Plans">Ver Planes</span>
              </a>
            </div>

            <!-- Apps Móviles -->
            <div class="group bg-gray-900/60 backdrop-blur-sm rounded-2xl p-6 border border-gray-700/50 hover:border-neon-purple/50 transition-all duration-300 hover:scale-105">
              <div class="w-16 h-16 bg-gradient-to-r from-neon-purple to-neon-pink rounded-xl flex items-center justify-center mb-4">
                <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
                </svg>
              </div>
              <h3 class="text-xl font-bold text-white mb-2" data-es="Apps Móviles" data-en="Mobile Apps">Apps Móviles</h3>
              <p class="text-gray-400 mb-4 text-sm" data-es="Apps que convierten usuarios en clientes leales. Diseño optimizado para ventas y fidelización." data-en="Apps that convert users into loyal customers. Design optimized for sales and loyalty.">
                Apps que convierten usuarios en clientes leales. Diseño optimizado para ventas y fidelización.
              </p>
              <div class="mb-4">
                <p class="text-gray-300 text-sm mb-2" data-es="Desde:" data-en="From:">Desde:</p>
                <p class="text-2xl font-bold text-neon-purple">$350 USD</p>
                <p class="text-gray-400 text-sm">$1.400.000 COP</p>
              </div>
              <a href="/contacto" class="block w-full text-center bg-gradient-to-r from-neon-purple/20 to-neon-pink/20 border border-neon-purple/30 rounded-lg py-2 text-white font-semibold hover:from-neon-purple/30 hover:to-neon-pink/30 transition-all">
                <span data-es="Más Info" data-en="More Info">Más Info</span>
              </a>
            </div>

            <!-- Apps Restaurantes -->
            <div class="group bg-gray-900/60 backdrop-blur-sm rounded-2xl p-6 border border-gray-700/50 hover:border-neon-teal/50 transition-all duration-300 hover:scale-105">
              <div class="w-16 h-16 bg-gradient-to-r from-neon-teal to-neon-green rounded-xl flex items-center justify-center mb-4">
                <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"></path>
                </svg>
              </div>
              <h3 class="text-xl font-bold text-white mb-2" data-es="Apps para Restaurantes" data-en="Restaurant Apps">Apps para Restaurantes</h3>
              <p class="text-gray-400 mb-4 text-sm" data-es="Digitalización completa: menús QR, pedidos sin intermediarios, cocina organizada. Aumenta ventas y reduce costos." data-en="Complete digitization: QR menus, orders without intermediaries, organized kitchen. Increase sales and reduce costs.">
                Digitalización completa: menús QR, pedidos sin intermediarios, cocina organizada. Aumenta ventas y reduce costos.
              </p>
              <div class="mb-4">
                <p class="text-gray-300 text-sm mb-2" data-es="Desde:" data-en="From:">Desde:</p>
                <p class="text-2xl font-bold text-neon-teal">$350 USD</p>
                <p class="text-gray-400 text-sm">$1.400.000 COP</p>
              </div>
              <a href="/contacto" class="block w-full text-center bg-gradient-to-r from-neon-teal/20 to-neon-green/20 border border-neon-teal/30 rounded-lg py-2 text-white font-semibold hover:from-neon-teal/30 hover:to-neon-green/30 transition-all">
                <span data-es="Ver Planes" data-en="View Plans">Ver Planes</span>
              </a>
            </div>

            <!-- Automatización IA -->
            <div class="group bg-gray-900/60 backdrop-blur-sm rounded-2xl p-6 border border-gray-700/50 hover:border-neon-pink/50 transition-all duration-300 hover:scale-105">
              <div class="w-16 h-16 bg-gradient-to-r from-neon-pink to-neon-purple rounded-xl flex items-center justify-center mb-4">
                <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
                </svg>
              </div>
              <h3 class="text-xl font-bold text-white mb-2" data-es="Automatización con IA" data-en="AI Automation">Automatización con IA</h3>
              <p class="text-gray-400 mb-4 text-sm" data-es="Asistente que nunca duerme. Automatiza lo repetitivo para que te enfoques en hacer crecer tu negocio." data-en="Assistant that never sleeps. Automates repetitive tasks so you can focus on growing your business.">
                Asistente que nunca duerme. Automatiza lo repetitivo para que te enfoques en hacer crecer tu negocio.
              </p>
              <div class="mb-4">
                <p class="text-gray-300 text-sm mb-2" data-es="Desde:" data-en="From:">Desde:</p>
                <p class="text-2xl font-bold text-neon-pink">$150 USD</p>
                <p class="text-gray-400 text-sm">$600.000 COP</p>
              </div>
              <a href="/contacto" class="block w-full text-center bg-gradient-to-r from-neon-pink/20 to-neon-purple/20 border border-neon-pink/30 rounded-lg py-2 text-white font-semibold hover:from-neon-pink/30 hover:to-neon-purple/30 transition-all">
                <span data-es="Ver Planes" data-en="View Plans">Ver Planes</span>
              </a>
            </div>

            <!-- Productos Pre-Construidos -->
            <div class="group bg-gray-900/60 backdrop-blur-sm rounded-2xl p-6 border border-gray-700/50 hover:border-neon-cyan/50 transition-all duration-300 hover:scale-105">
              <div class="w-16 h-16 bg-gradient-to-r from-neon-cyan to-neon-teal rounded-xl flex items-center justify-center mb-4">
                <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                </svg>
              </div>
              <h3 class="text-xl font-bold text-white mb-2" data-es="Productos Rápidos" data-en="Quick Products">Productos Rápidos</h3>
              <p class="text-gray-400 mb-4 text-sm" data-es="Soluciones listas en 24h. Landing pages, mini-ecommerce y más. Rápidos, económicos y listos para usar." data-en="Ready solutions in 24h. Landing pages, mini-ecommerce and more. Fast, affordable and ready to use.">
                Soluciones listas en 24h. Landing pages, mini-ecommerce y más. Rápidos, económicos y listos para usar.
              </p>
              <div class="mb-4">
                <p class="text-gray-300 text-sm mb-2" data-es="Desde:" data-en="From:">Desde:</p>
                <p class="text-2xl font-bold text-neon-cyan">$60 USD</p>
                <p class="text-gray-400 text-sm">$250.000 COP</p>
              </div>
              <a href="/contacto" class="block w-full text-center bg-gradient-to-r from-neon-cyan/20 to-neon-teal/20 border border-neon-cyan/30 rounded-lg py-2 text-white font-semibold hover:from-neon-cyan/30 hover:to-neon-teal/30 transition-all">
                <span data-es="Ver Productos" data-en="View Products">Ver Productos</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Planes Detallados - E-commerce -->
    <section class="py-16 relative">
      <div class="container mx-auto px-6 relative z-10">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-12">
            <h2 class="text-3xl md:text-4xl font-bold text-white mb-4" data-es="Planes de E-commerce" data-en="E-commerce Plans">Planes de E-commerce</h2>
            <p class="text-gray-400" data-es="Elige el plan perfecto para tu tienda online" data-en="Choose the perfect plan for your online store">Elige el plan perfecto para tu tienda online</p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="bg-gray-800/60 backdrop-blur-sm rounded-2xl p-6 border border-gray-700/50">
              <h4 class="font-semibold text-white mb-4" data-es="Starter" data-en="Starter">Starter</h4>
              <div class="mb-6">
                <span class="text-3xl font-bold text-neon-green">$800</span>
                <span class="text-gray-400"> USD</span>
                <p class="text-gray-400 text-sm mt-2">$3.300.000 COP</p>
              </div>
              <ul class="space-y-3 mb-6">
                <li class="flex items-start space-x-2">
                  <svg class="w-5 h-5 text-neon-green flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-gray-300 text-sm" data-es="E-commerce básico" data-en="Basic e-commerce">E-commerce básico</span>
                </li>
                <li class="flex items-start space-x-2">
                  <svg class="w-5 h-5 text-neon-green flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-gray-300 text-sm" data-es="Integración de pagos" data-en="Payment integration">Integración de pagos</span>
                </li>
                <li class="flex items-start space-x-2">
                  <svg class="w-5 h-5 text-neon-green flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-gray-300 text-sm" data-es="Gestión de inventario" data-en="Inventory management">Gestión de inventario</span>
                </li>
              </ul>
              <a href="/contacto" class="block w-full text-center bg-gray-700/50 border border-gray-600 rounded-lg py-2 text-white font-semibold hover:bg-gray-700 transition-all">
                <span data-es="Solicitar" data-en="Request">Solicitar</span>
              </a>
            </div>

            <div class="bg-gradient-to-br from-neon-green/20 to-neon-blue/20 backdrop-blur-sm rounded-2xl p-6 border-2 border-neon-green relative">
              <div class="absolute -top-3 left-1/2 transform -translate-x-1/2">
                <span class="bg-neon-green px-3 py-1 rounded-full text-white text-xs font-semibold" data-es="Recomendado" data-en="Recommended">Recomendado</span>
              </div>
              <h4 class="font-semibold text-white mb-4" data-es="Pro" data-en="Pro">Pro</h4>
              <div class="mb-6">
                <span class="text-3xl font-bold text-white">$1,300</span>
                <span class="text-gray-300"> USD</span>
                <p class="text-gray-300 text-sm mt-2">$5.400.000 COP</p>
              </div>
              <ul class="space-y-3 mb-6">
                <li class="flex items-start space-x-2">
                  <svg class="w-5 h-5 text-neon-green flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-gray-200 text-sm" data-es="Todo lo de Starter" data-en="Everything from Starter">Todo lo de Starter</span>
                </li>
                <li class="flex items-start space-x-2">
                  <svg class="w-5 h-5 text-neon-green flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-gray-200 text-sm" data-es="Optimización avanzada" data-en="Advanced optimization">Optimización avanzada</span>
                </li>
                <li class="flex items-start space-x-2">
                  <svg class="w-5 h-5 text-neon-green flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-gray-200 text-sm" data-es="Estrategias de conversión" data-en="Conversion strategies">Estrategias de conversión</span>
                </li>
                <li class="flex items-start space-x-2">
                  <svg class="w-5 h-5 text-neon-green flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-gray-200 text-sm" data-es="Integración ERP" data-en="ERP integration">Integración ERP</span>
                </li>
              </ul>
              <a href="/contacto" class="block w-full text-center bg-gradient-to-r from-neon-green to-neon-blue rounded-lg py-2 text-white font-semibold hover:shadow-lg hover:shadow-neon-green/30 transition-all">
                <span data-es="Solicitar" data-en="Request">Solicitar</span>
              </a>
