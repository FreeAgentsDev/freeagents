---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DynamicBackground from '../../components/DynamicBackground.astro';
import { getServiceBySlug } from '../../config/services.ts';

const service = getServiceBySlug('ecommerce');
if (!service) {
  return Astro.redirect('/servicios');
}

const siteUrl = Astro.site?.href || "https://freeagents.dev";
const currentUrl = `${siteUrl}/servicios/${service.slug}`;
---

<Layout 
  title={service.seo.title}
  description={service.seo.description}
  keywords={service.seo.keywords}
  canonical={currentUrl}
  image="/servicesfreeagents.png"
>
  <Header />
  
  <main class="pt-20 relative min-h-screen overflow-hidden">
    <div class="fixed inset-0 -z-10">
      <DynamicBackground type="circuits" color="green" />
      <DynamicBackground type="particles" color="green" />
      <div class="absolute inset-0">
        <div class="absolute top-0 left-0 w-full h-full bg-gradient-to-br from-green-900/30 via-blue-900/20 to-cyan-900/30 animate-pulse"></div>
        <div class="absolute top-1/4 right-1/4 w-96 h-96 bg-neon-green/20 rounded-full blur-3xl animate-pulse"></div>
        <div class="absolute bottom-1/4 left-1/4 w-96 h-96 bg-neon-blue/20 rounded-full blur-3xl animate-pulse" style="animation-delay: 1s;"></div>
      </div>
      <div class="absolute inset-0 opacity-10" style="background-image: linear-gradient(rgba(16, 185, 129, 0.2) 1px, transparent 1px), linear-gradient(90deg, rgba(16, 185, 129, 0.2) 1px, transparent 1px); background-size: 50px 50px; animation: grid-move 20s linear infinite;"></div>
    </div>

    <section class="relative py-6">
      <div class="container mx-auto px-6 relative z-10">
        <nav class="flex items-center space-x-2 text-sm text-gray-400">
          <a href="/" class="hover:text-neon-green transition-colors">Inicio</a>
          <span>/</span>
          <a href="/servicios" class="hover:text-neon-green transition-colors" data-es="Servicios" data-en="Services">Servicios</a>
          <span>/</span>
          <span class="text-white">{service.name}</span>
        </nav>
      </div>
    </section>

    <section class="relative py-20 overflow-hidden">
      <div class="container mx-auto px-6 relative z-10">
        <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div class="text-center lg:text-left">
            <div class="inline-block px-4 py-2 bg-neon-green/10 border border-neon-green/30 rounded-full mb-6">
              <span class="text-neon-green font-semibold text-sm" data-es="E-commerce" data-en="E-commerce">E-commerce</span>
            </div>
            <h1 class="font-display text-5xl md:text-6xl font-bold mb-6 text-white">
              <span data-es={service.name} data-en={service.nameEn}>{service.name}</span>
            </h1>
            <p class="text-xl text-gray-300 mb-6 max-w-xl" data-es={service.fullDescription} data-en={service.fullDescriptionEn}>
              {service.fullDescription}
            </p>
            <div class="mb-8">
              <p class="text-lg text-gray-400 mb-4" data-es="Ideal para:" data-en="Ideal for:">Ideal para:</p>
              <p class="text-gray-300" data-es={service.idealFor} data-en={service.idealForEn}>{service.idealFor}</p>
            </div>
            <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
              <a href="/contacto" class="bg-gradient-to-r from-neon-green to-neon-blue px-10 py-5 rounded-full text-white font-bold text-lg hover:shadow-2xl hover:shadow-neon-green/30 transition-all duration-300 hover:scale-105">
                <span data-es="Solicitar Cotización" data-en="Request Quote">Solicitar Cotización</span>
              </a>
            </div>
          </div>
          <div class="relative flex justify-center lg:justify-end">
            <div class="relative">
              <div class="absolute inset-0 bg-gradient-to-r from-neon-green/20 to-neon-blue/20 rounded-3xl blur-2xl transform scale-110"></div>
              <div class="relative bg-gradient-to-br from-gray-800/50 to-gray-900/50 backdrop-blur-sm rounded-3xl p-6 border border-gray-700/50">
                <div class="w-64 h-64 bg-gradient-to-r from-neon-green to-neon-blue rounded-2xl flex items-center justify-center">
                  <svg class="w-32 h-32 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
                  </svg>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {service.plans && service.plans.length > 0 && (
      <section class="py-16 relative">
        <div class="container mx-auto px-6 relative z-10">
          <div class="max-w-6xl mx-auto">
            <h2 class="text-3xl md:text-4xl font-bold text-center mb-12 text-white" data-es="Planes Disponibles" data-en="Available Plans">Planes Disponibles</h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
              {service.plans.map((plan) => (
                <div class={`bg-gray-900/60 backdrop-blur-sm rounded-2xl p-6 border ${plan.recommended ? 'border-2 border-neon-green' : 'border-gray-700/50'} relative`}>
                  {plan.recommended && (
                    <div class="absolute -top-3 left-1/2 transform -translate-x-1/2">
                      <span class="bg-neon-green px-3 py-1 rounded-full text-white text-xs font-semibold" data-es="Recomendado" data-en="Recommended">Recomendado</span>
                    </div>
                  )}
                  <h3 class="font-semibold text-white mb-4 text-xl" data-es={plan.name} data-en={plan.nameEn}>{plan.name}</h3>
                  <div class="mb-6">
                    <span class="text-3xl font-bold text-neon-green">${plan.priceUSD.toLocaleString()}</span>
                    <span class="text-gray-400"> USD</span>
                    <p class="text-gray-400 text-sm mt-2">${plan.priceCOP.toLocaleString('es-CO')} COP</p>
                  </div>
                  <ul class="space-y-3 mb-6">
                    {plan.features.map((feature, idx) => (
                      <li class="flex items-start space-x-2">
                        <svg class="w-5 h-5 text-neon-green flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                        </svg>
                        <span class="text-gray-300 text-sm" data-es={feature} data-en={plan.featuresEn[idx]}>{feature}</span>
                      </li>
                    ))}
                  </ul>
                  <a href="/contacto" class={`block w-full text-center ${plan.recommended ? 'bg-gradient-to-r from-neon-green to-neon-blue' : 'bg-gray-700/50 border border-gray-600'} rounded-lg py-2 text-white font-semibold hover:shadow-lg transition-all`}>
                    <span data-es="Solicitar" data-en="Request">Solicitar</span>
                  </a>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>
    )}

    <section class="py-16 relative">
      <div class="container mx-auto px-6 relative z-10">
        <div class="max-w-6xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-bold text-center mb-12 text-white" data-es="Características" data-en="Features">Características</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {service.features.map((feature, index) => (
              <div class="bg-gray-900/60 backdrop-blur-sm rounded-2xl p-6 border border-gray-700/50">
                <div class="flex items-start space-x-4">
                  <div class="w-8 h-8 bg-gradient-to-r from-neon-green to-neon-blue rounded-lg flex items-center justify-center flex-shrink-0">
                    <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                    </svg>
                  </div>
                  <p class="text-gray-300" data-es={feature} data-en={service.featuresEn[index]}>{feature}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="py-20 relative">
      <div class="container mx-auto px-6 text-center relative z-10">
        <h2 class="font-display text-4xl md:text-5xl font-bold mb-6">
          <span class="bg-gradient-to-r from-neon-green to-neon-blue bg-clip-text text-transparent" data-es="¿Listo para Comenzar?" data-en="Ready to Start?">
            ¿Listo para Comenzar?
          </span>
        </h2>
        <p class="text-xl text-gray-400 mb-10 max-w-2xl mx-auto" data-es="Hablemos sobre tu tienda online y encontremos el plan perfecto para tu negocio." data-en="Let's talk about your online store and find the perfect plan for your business.">
          Hablemos sobre tu tienda online y encontremos el plan perfecto para tu negocio.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/contacto" class="bg-gradient-to-r from-neon-green to-neon-blue px-8 py-4 rounded-full text-white font-semibold text-lg hover:shadow-lg hover:shadow-neon-green/25 transition-all duration-300 hover:scale-105">
            <span data-es="Solicitar Cotización" data-en="Request Quote">Solicitar Cotización</span>
          </a>
          <a href="/servicios" class="border-2 border-neon-blue px-8 py-4 rounded-full text-neon-blue font-semibold text-lg hover:bg-neon-blue hover:text-white transition-all duration-300 hover:scale-105">
            <span data-es="Ver Todos los Servicios" data-en="View All Services">Ver Todos los Servicios</span>
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Service",
  "name": service.name,
  "description": service.seo.description,
  "provider": {
    "@type": "Organization",
    "name": "FreeAgents",
    "url": siteUrl
  },
  "areaServed": {
    "@type": "Country",
    "name": ["Colombia", "Latinoamérica"]
  },
  "offers": service.plans ? service.plans.map(plan => ({
    "@type": "Offer",
    "name": plan.name,
    "price": plan.priceUSD,
    "priceCurrency": "USD"
  })) : {
    "@type": "Offer",
    "price": service.priceFromUSD,
    "priceCurrency": "USD"
  },
  "serviceType": "E-commerce Development",
  "url": currentUrl
})} />

<style>
  @keyframes grid-move {
    0% { transform: translate(0, 0); }
    100% { transform: translate(50px, 50px); }
  }
</style>

