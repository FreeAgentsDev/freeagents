---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DynamicBackground from '../components/DynamicBackground.astro';
---

<Layout title="Precios y Planes - FreeAgents | Software Factory" description="Planes flexibles de desarrollo y mantenimiento. Inversión transparente que impulsa tu negocio con metodologías profesionales y equipo especializado.">
  <Header />
  
  <main class="pt-20 relative min-h-screen overflow-hidden">
    <!-- Fondo Dinámico Potente para Toda la Vista -->
    <div class="fixed inset-0 -z-10">
      <DynamicBackground type="particles" color="green" />
      <DynamicBackground type="circuits" color="blue" />
      <DynamicBackground type="hologram" color="green" />
      
      <!-- Gradientes Animados Múltiples -->
      <div class="absolute inset-0">
        <div class="absolute top-0 left-0 w-full h-full bg-gradient-to-br from-green-900/30 via-blue-900/20 to-cyan-900/30 animate-pulse"></div>
        <div class="absolute top-1/4 right-1/4 w-96 h-96 bg-neon-green/20 rounded-full blur-3xl animate-pulse"></div>
        <div class="absolute bottom-1/4 left-1/4 w-96 h-96 bg-neon-blue/20 rounded-full blur-3xl animate-pulse" style="animation-delay: 1s;"></div>
        <div class="absolute top-1/2 left-1/2 w-96 h-96 bg-neon-cyan/15 rounded-full blur-3xl animate-pulse" style="animation-delay: 0.5s;"></div>
      </div>
      
      <!-- Grid Pattern Overlay -->
      <div class="absolute inset-0 opacity-10" style="background-image: linear-gradient(rgba(16, 185, 129, 0.2) 1px, transparent 1px), linear-gradient(90deg, rgba(14, 165, 233, 0.2) 1px, transparent 1px); background-size: 50px 50px; animation: grid-move 20s linear infinite;"></div>
    </div>

    <!-- Hero Section Única -->
    <section class="relative py-24 overflow-hidden">
      
      <div class="container mx-auto px-6 relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center max-w-6xl mx-auto">
          <!-- Hero Image a la izquierda -->
          <div class="order-2 lg:order-1 relative flex justify-center lg:justify-start">
            <div class="relative">
              <div class="absolute inset-0 bg-gradient-to-r from-neon-green/20 to-neon-blue/20 rounded-3xl blur-2xl transform scale-110"></div>
              <div class="relative bg-gradient-to-br from-gray-800/50 to-gray-900/50 backdrop-blur-sm rounded-3xl p-8 border border-gray-700/50">
                <img 
                  src="/pricingfa.png" 
                  alt="FreeAgents Precios" 
                  class="h-80 rounded-3xl w-auto mx-auto animate-float drop-shadow-2xl"
                >
                <div class="absolute -top-4 -right-4 w-8 h-8 bg-neon-green rounded-full animate-pulse"></div>
                <div class="absolute -bottom-4 -left-4 w-6 h-6 bg-neon-blue rounded-full animate-pulse" style="animation-delay: 0.5s;"></div>
              </div>
            </div>
          </div>
          
          <!-- Content a la derecha -->
          <div class="order-1 lg:order-2 text-center lg:text-left">
            <div class="inline-block px-4 py-2 bg-neon-green/10 border border-neon-green/30 rounded-full mb-8">
              <span class="text-neon-green font-semibold text-sm">Precios y Planes</span>
            </div>
            
            <h1 class="font-display text-5xl md:text-6xl font-bold mb-6 text-white">
              Inversión Transparente
              <br>
              <span class="bg-gradient-to-r from-neon-green to-neon-blue bg-clip-text text-transparent">
                Resultados Garantizados
              </span>
            </h1>
            
            <p class="text-xl text-gray-300 mb-4">
              Planes flexibles que se adaptan a cada etapa de tu negocio. 
              <strong class="text-neon-green">Precios claros</strong>, 
              <strong class="text-neon-blue">sin sorpresas</strong> y 
              <strong class="text-neon-cyan">resultados medibles</strong>.
            </p>
            
            <p class="text-lg text-gray-400 mb-8">
              Tu inversión no solo potencia tu negocio, sino que también impulsa el futuro del talento tech.
            </p>

            <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
              <a 
                href="/contacto" 
                class="bg-gradient-to-r from-neon-green to-neon-blue px-10 py-5 rounded-full text-white font-bold text-lg hover:shadow-2xl hover:shadow-neon-green/30 transition-all duration-300 hover:scale-105"
              >
                Solicitar Cotización
              </a>
              <a 
                href="/servicios" 
                class="border-2 border-neon-blue px-10 py-5 rounded-full text-neon-blue font-bold text-lg hover:bg-neon-blue hover:text-white transition-all duration-300 hover:scale-105"
              >
                Ver Servicios
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Modelo de Suscripción -->
    <section class="py-20 relative">
      <div class="container mx-auto px-6 relative z-10">
        <div class="max-w-4xl mx-auto text-center mb-16">
          <h2 class="font-display text-4xl md:text-5xl font-bold mb-6">
            <span class="bg-gradient-to-r from-neon-blue to-neon-purple bg-clip-text text-transparent">
              ¿Cómo Funciona Nuestro Modelo?
            </span>
          </h2>
          <p class="text-xl text-gray-400 mb-8">
            Creemos en relaciones a largo plazo. Nuestro modelo de suscripción te permite acceder a desarrollo continuo, 
            soporte técnico y evolución constante de tu plataforma.
          </p>
          
          <div class="bg-gradient-to-r from-neon-purple/10 to-neon-pink/10 border border-neon-purple/30 rounded-2xl p-8">
            <h3 class="font-semibold text-white mb-4 text-2xl">💡 Impacto Social de tu Inversión</h3>
            <p class="text-gray-300 text-lg">
              Cada proyecto que desarrollamos con FreeAgents contribuye directamente al crecimiento de la 
              <strong class="text-neon-purple">Fundación FreeAgents</strong>. Tu inversión no solo impulsa tu negocio, 
              sino que también forma parte del desarrollo de una nueva generación de profesionales tech que 
              transformarán la industria.
            </p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="text-center">
            <div class="w-20 h-20 bg-gradient-to-r from-neon-blue to-neon-purple rounded-full flex items-center justify-center mx-auto mb-6">
              <span class="text-2xl font-bold text-white">1</span>
            </div>
            <h3 class="font-display text-xl font-bold text-white mb-4">Desarrollo Inicial</h3>
            <p class="text-gray-400">
              Creamos tu solución desde cero con un enfoque en escalabilidad y mantenibilidad a largo plazo.
            </p>
          </div>

          <div class="text-center">
            <div class="w-20 h-20 bg-gradient-to-r from-neon-purple to-neon-pink rounded-full flex items-center justify-center mx-auto mb-6">
              <span class="text-2xl font-bold text-white">2</span>
            </div>
            <h3 class="font-display text-xl font-bold text-white mb-4">Suscripción de Soporte</h3>
            <p class="text-gray-400">
              Mantenimiento continuo, actualizaciones de seguridad y nuevas funcionalidades según tu crecimiento.
            </p>
          </div>

          <div class="text-center">
            <div class="w-20 h-20 bg-gradient-to-r from-neon-pink to-neon-green rounded-full flex items-center justify-center mx-auto mb-6">
              <span class="text-2xl font-bold text-white">3</span>
            </div>
            <h3 class="font-display text-xl font-bold text-white mb-4">Evolución Constante</h3>
            <p class="text-gray-400">
              Tu plataforma crece y se adapta a las nuevas necesidades de tu negocio y del mercado.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Planes de Desarrollo -->
    <section class="py-20 relative">
      <div class="container mx-auto px-6 relative z-10">
        <div class="text-center mb-16">
          <h2 class="font-display text-4xl md:text-5xl font-bold mb-6">
            <span class="bg-gradient-to-r from-neon-blue to-neon-purple bg-clip-text text-transparent">
              Planes de Desarrollo
            </span>
          </h2>
          <p class="text-xl text-gray-400 max-w-3xl mx-auto">
            Elige el plan que mejor se adapte a tu etapa de emprendimiento y necesidades tecnológicas.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
          <!-- Plan Startup -->
          <div class="bg-gray-800/60 backdrop-blur-sm rounded-2xl p-8 border border-gray-700 hover:border-neon-blue/50 transition-all duration-300 relative">
            <div class="text-center mb-8">
              <h3 class="font-display text-2xl font-bold text-white mb-2">Startup</h3>
              <p class="text-gray-400 mb-6">Perfecto para validar tu idea</p>
              <div class="mb-6">
                <span class="text-4xl font-bold text-neon-blue">$800.000</span>
                <span class="text-gray-400"> - $1.599.000 </span>
              </div>
              <p class="text-sm text-gray-500">Proyecto inicial en 3 pagos mensuales</p>
            </div>

            <ul class="space-y-4 mb-8">
              <li class="flex items-center">
                <svg class="w-5 h-5 text-neon-blue mr-3" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-300">MVP o Landing Page</span>
              </li>
              <li class="flex items-center">
                <svg class="w-5 h-5 text-neon-blue mr-3" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-300">Diseño responsive</span>
              </li>
              <li class="flex items-center">
                <svg class="w-5 h-5 text-neon-blue mr-3" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-300">Hosting y dominio incluido</span>
              </li>
              <li class="flex items-center">
                <svg class="w-5 h-5 text-neon-blue mr-3" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-300">Analytics básico</span>
              </li>
              <li class="flex items-center">
                <svg class="w-5 h-5 text-neon-blue mr-3" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-300">Soporte por email</span>
              </li>
            </ul>

            <a href="/contacto" class="w-full bg-gradient-to-r from-neon-blue to-neon-purple px-6 py-3 rounded-full text-white font-semibold text-center block hover:shadow-lg hover:shadow-neon-blue/25 transition-all duration-300">
              Solicitar Cotización
            </a>
          </div>

          <!-- Plan Growth -->
          <div class="bg-gray-800/60 backdrop-blur-sm rounded-2xl p-8 border-2 border-neon-purple relative transform scale-105">
            <div class="absolute -top-4 left-1/2 transform -translate-x-1/2">
              <span class="bg-gradient-to-r whitespace-nowrap from-neon-purple to-neon-pink px-4 py-2 rounded-full text-white text-sm font-semibold">
                Más Popular
              </span>
            </div>
            
            <div class="text-center mb-8">
              <h3 class="font-display text-2xl font-bold text-white mb-2">Growth</h3>
              <p class="text-gray-400 mb-6">Para escalar tu negocio</p>
              <div class="mb-6">
                <span class="text-4xl font-bold text-neon-purple">$1,600,000</span>
                <span class="text-gray-400"> - $4,000,000</span>
              </div>
              <p class="text-sm text-gray-500">Proyecto completo + Creacion y manejo de redes sociales por 6 meses de pagos mensuales</p>
            </div>

            <ul class="space-y-4 mb-8">
              <li class="flex items-center">
                <svg class="w-5 h-5 text-neon-purple mr-3" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-300">App completa o E-commerce</span>
              </li>
              <li class="flex items-center">
                <svg class="w-5 h-5 text-neon-purple mr-3" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-300">Creacion y manejo de tus redes sociales</span>
              </li>
              <li class="flex items-center">
                <svg class="w-5 h-5 text-neon-purple mr-3" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-300">Asesoria de marketing y acceso a recursos para manejar tu publicidad</span>
              </li>
              <li class="flex items-center">
                <svg class="w-5 h-5 text-neon-green mr-3" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-300">Cuadro de planeacion mensual de contenido y reportes de marketing</span>
              </li>
              <li class="flex items-center">
                <svg class="w-5 h-5 text-neon-purple mr-3" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-300">Panel de administración</span>
              </li>
              <li class="flex items-center">
                <svg class="w-5 h-5 text-neon-purple mr-3" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-300">Integraciones API</span>
              </li>
              <li class="flex items-center">
                <svg class="w-5 h-5 text-neon-purple mr-3" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-300">Analytics avanzado</span>
              </li>
              <li class="flex items-center">
                <svg class="w-5 h-5 text-neon-purple mr-3" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-300">Soporte prioritario</span>
              </li>
              <li class="flex items-center">
                <svg class="w-5 h-5 text-neon-purple mr-3" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-300">Capacitación del equipo</span>
              </li>
            </ul>

            <a href="/contacto" class="w-full bg-gradient-to-r from-neon-purple to-neon-pink px-6 py-3 rounded-full text-white font-semibold text-center block hover:shadow-lg hover:shadow-neon-purple/25 transition-all duration-300">
              Agendar una Llamada
            </a>
          </div>

          <!-- Plan Enterprise -->
          <div class="bg-gray-800/60 backdrop-blur-sm rounded-2xl p-8 border border-gray-700 hover:border-neon-green/50 transition-all duration-300 relative">
            <div class="text-center mb-8">
              <h3 class="font-display text-2xl font-bold text-white mb-2">Enterprise</h3>
              <p class="text-gray-400 mb-6">Soluciones empresariales</p>
              <div class="mb-6">
                <span class="text-4xl font-bold text-neon-green">$4,500,000</span>
                <span class="text-gray-400">+</span>
              </div>
              <p class="text-sm text-gray-500">Proyecto personalizado + 8 meses de manejo en redes y publicidad</p>
            </div>

            <ul class="space-y-4 mb-8">
              <li class="flex items-center">
                <svg class="w-5 h-5 text-neon-green mr-3" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-300">Arquitectura personalizada</span>
              </li>
              <li class="flex items-center">
                <svg class="w-5 h-5 text-neon-green mr-3" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-300">Creacion o manejo de tu presencia en redes sociales Instagram, Facebok, Tik tok</span>
              </li>
              <li class="flex items-center">
                <svg class="w-5 h-5 text-neon-green mr-3" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-300">Cuadro de planeacion mensual de contenido y reportes de marketing</span>
              </li>
              <li class="flex items-center">
                <svg class="w-5 h-5 text-neon-green mr-3" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-300">Manejo de los anuncios en Meta y Tiktok Ads</span>
              </li>
              <li class="flex items-center">
                <svg class="w-5 h-5 text-neon-green mr-3" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-300">Múltiples plataformas</span>
              </li>
              <li class="flex items-center">
                <svg class="w-5 h-5 text-neon-green mr-3" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-300">Chatbots con Inteligencia Artificial para ayudar en tu negocio</span>
              </li>
              <li class="flex items-center">
                <svg class="w-5 h-5 text-neon-green mr-3" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-300">Escalabilidad enterprise</span>
              </li>
              <li class="flex items-center">
                <svg class="w-5 h-5 text-neon-green mr-3" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-300">Equipo dedicado</span>
              </li>
              <li class="flex items-center">
                <svg class="w-5 h-5 text-neon-green mr-3" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-gray-300">SLA garantizado</span>
