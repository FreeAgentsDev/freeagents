                  </li>
                  <li class="flex items-center">
                    <svg class="w-5 h-5 text-neon-blue mr-3" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                    </svg>
                    <span class="text-gray-300">Monitoreo básico</span>
                  </li>
                  <li class="flex items-center">
                    <svg class="w-5 h-5 text-neon-blue mr-3" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                    </svg>
                    <span class="text-gray-300">Soporte por email</span>
                  </li>
                  <li class="flex items-center">
                    <svg class="w-5 h-5 text-neon-blue mr-3" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                    </svg>
                    <span class="text-gray-300">2 horas desarrollo/mes</span>
                  </li>
                </ul>

                <a href="/contacto" class="w-full border-2 border-neon-blue px-6 py-3 rounded-full text-neon-blue font-semibold text-center block hover:bg-neon-blue hover:text-white transition-all duration-300">
                  Suscribirse
                </a>
              </div>

              <!-- Plan Profesional -->
              <div class="bg-gray-900 rounded-2xl p-8 border-2 border-neon-purple">
                <div class="text-center mb-8">
                  <h3 class="font-display text-2xl font-bold text-white mb-2">Profesional</h3>
                  <p class="text-gray-400 mb-6">Crecimiento continuo</p>
                  <div class="mb-6">
                    <span class="text-4xl font-bold text-neon-purple">$1,500</span>
                    <span class="text-gray-400">/mes</span>
                  </div>
                </div>

                <ul class="space-y-4 mb-8">
                  <li class="flex items-center">
                    <svg class="w-5 h-5 text-neon-purple mr-3" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                    </svg>
                    <span class="text-gray-300">Todo del plan Básico</span>
                  </li>
                  <li class="flex items-center">
                    <svg class="w-5 h-5 text-neon-purple mr-3" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                    </svg>
                    <span class="text-gray-300">Nuevas funcionalidades</span>
                  </li>
                  <li class="flex items-center">
                    <svg class="w-5 h-5 text-neon-purple mr-3" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                    </svg>
                    <span class="text-gray-300">Optimización de rendimiento</span>
                  </li>
                  <li class="flex items-center">
                    <svg class="w-5 h-5 text-neon-purple mr-3" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                    </svg>
                    <span class="text-gray-300">Soporte prioritario</span>
                  </li>
