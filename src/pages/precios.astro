            <a href="/contacto" class="w-full bg-gradient-to-r from-neon-green to-neon-blue px-6 py-3 rounded-full text-white font-semibold text-center block hover:shadow-lg hover:shadow-neon-green/25 transition-all duration-300">
              Consultar Proyecto
            </a>
          </div>
        </div>

        <!-- Planes de Suscripción -->
        <section class="py-20 bg-gray-800">
          <div class="container mx-auto px-6">
            <div class="text-center mb-16">
              <h2 class="font-display text-4xl md:text-5xl font-bold mb-6">
                <span class="bg-gradient-to-r from-neon-blue to-neon-purple bg-clip-text text-transparent">
                  Planes de Mantenimiento
                </span>
              </h2>
              <p class="text-xl text-gray-400 max-w-3xl mx-auto">
                Mantén tu plataforma actualizada, segura y en constante evolución con nuestros planes de suscripción mensual.
              </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
              <!-- Plan Básico -->
              <div class="bg-gray-900 rounded-2xl p-8 border border-gray-700">
                <div class="text-center mb-8">
                  <h3 class="font-display text-2xl font-bold text-white mb-2">Básico</h3>
                  <p class="text-gray-400 mb-6">Mantenimiento esencial</p>
                  <div class="mb-6">
                    <span class="text-4xl font-bold text-neon-blue">$500</span>
                    <span class="text-gray-400">/mes</span>
                  </div>
                </div>

                <ul class="space-y-4 mb-8">
                  <li class="flex items-center">
                    <svg class="w-5 h-5 text-neon-blue mr-3" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                    </svg>
