---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Contacto - FreeAgents" description="Hablemos de tu próximo proyecto. Contáctanos para desarrollo de software, apps, e-commerce o para unirte a la Fundación FreeAgents.">
  <Header />
  
  <div class="pt-10 min-h-screen">
    <!-- Hero Section -->
    <Hero 
      title="Hablemos"
      subtitle="De tu Próximo Proyecto"
      description="Estamos aquí para convertir tu visión en realidad. Ya sea un proyecto de desarrollo, una consulta sobre nuestros servicios, o interés en la Fundación, nos encantaría escucharte."
      ctaText="Enviar Mensaje"
      ctaLink="#contacto-form"
      secondaryCtaText="Ver Servicios"
      secondaryCtaLink="/servicios"
    />

    <!-- Formulario de Contacto -->
    <section id="contacto-form" class="py-20 bg-gray-800">
      <div class="container mx-auto px-6">
        <div class="max-w-6xl mx-auto">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
            <!-- Formulario -->
            <div class="bg-gray-900 rounded-2xl p-8 border border-gray-700">
              <h2 class="font-display text-3xl font-bold text-white mb-6">Cuéntanos sobre tu Proyecto</h2>
              <form class="space-y-6" id="contact-form">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                  <div>
                    <label for="nombre" class="block text-sm font-medium text-gray-300 mb-2">Nombre *</label>
                    <input 
                      type="text" 
                      id="nombre" 
                      name="nombre" 
                      required
                      class="w-full px-4 py-3 bg-gray-800 border border-gray-600 rounded-lg text-white placeholder-gray-400 focus:border-neon-blue focus:ring-1 focus:ring-neon-blue transition-colors duration-300"
                      placeholder="Tu nombre completo"
                    >
                  </div>
                  <div>
                    <label for="empresa" class="block text-sm font-medium text-gray-300 mb-2">Empresa</label>
                    <input 
                      type="text" 
                      id="empresa" 
                      name="empresa"
                      class="w-full px-4 py-3 bg-gray-800 border border-gray-600 rounded-lg text-white placeholder-gray-400 focus:border-neon-blue focus:ring-1 focus:ring-neon-blue transition-colors duration-300"
                      placeholder="Nombre de tu empresa"
                    >
                  </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                  <div>
                    <label for="email" class="block text-sm font-medium text-gray-300 mb-2">Email *</label>
                    <input 
                      type="email" 
                      id="email" 
                      name="email" 
                      required
                      class="w-full px-4 py-3 bg-gray-800 border border-gray-600 rounded-lg text-white placeholder-gray-400 focus:border-neon-blue focus:ring-1 focus:ring-neon-blue transition-colors duration-300"
                      placeholder="tu@email.com"
                    >
                  </div>
                  <div>
                    <label for="telefono" class="block text-sm font-medium text-gray-300 mb-2">Teléfono</label>
                    <input 
                      type="tel" 
                      id="telefono" 
                      name="telefono"
                      class="w-full px-4 py-3 bg-gray-800 border border-gray-600 rounded-lg text-white placeholder-gray-400 focus:border-neon-blue focus:ring-1 focus:ring-neon-blue transition-colors duration-300"
                      placeholder="+1 (555) 123-4567"
                    >
                  </div>
                </div>

                <div>
                  <label for="tipo-proyecto" class="block text-sm font-medium text-gray-300 mb-2">Tipo de Proyecto *</label>
                  <select 
                    id="tipo-proyecto" 
                    name="tipo-proyecto" 
                    required
                    class="w-full px-4 py-3 bg-gray-800 border border-gray-600 rounded-lg text-white focus:border-neon-blue focus:ring-1 focus:ring-neon-blue transition-colors duration-300"
                  >
                    <option value="">Selecciona una opción</option>
                    <option value="desarrollo-medida">Desarrollo a la Medida</option>
                    <option value="app-movil">Aplicación Móvil</option>
                    <option value="ecommerce">E-commerce</option>
                    <option value="consultoria">Consultoría Técnica</option>
                    <option value="fundacion-talento">Fundación - Aplicar como Talento</option>
                    <option value="fundacion-mentor">Fundación - Ser Mentor</option>
                    <option value="fundacion-aliado">Fundación - Ser Aliado</option>
                    <option value="otro">Otro</option>
                  </select>
                </div>

                <div>
                  <label for="presupuesto" class="block text-sm font-medium text-gray-300 mb-2">Presupuesto Estimado</label>
                  <select 
                    id="presupuesto" 
                    name="presupuesto"
                    class="w-full px-4 py-3 bg-gray-800 border border-gray-600 rounded-lg text-white focus:border-neon-blue focus:ring-1 focus:ring-neon-blue transition-colors duration-300"
                  >
                    <option value="">Selecciona un rango</option>
                    <option value="5k-15k">$5,000 - $15,000</option>
                    <option value="15k-50k">$15,000 - $50,000</option>
                    <option value="50k-100k">$50,000 - $100,000</option>
                    <option value="100k+">$100,000+</option>
                    <option value="no-definido">Aún no definido</option>
                  </select>
                </div>

                <div>
                  <label for="timeline" class="block text-sm font-medium text-gray-300 mb-2">Timeline Deseado</label>
                  <select 
                    id="timeline" 
                    name="timeline"
                    class="w-full px-4 py-3 bg-gray-800 border border-gray-600 rounded-lg text-white focus:border-neon-blue focus:ring-1 focus:ring-neon-blue transition-colors duration-300"
                  >
                    <option value="">Selecciona un timeline</option>
                    <option value="urgente">Lo antes posible (1-2 meses)</option>
                    <option value="normal">Normal (3-6 meses)</option>
                    <option value="flexible">Flexible (6+ meses)</option>
                    <option value="exploratorio">Solo explorando opciones</option>
                  </select>
                </div>

                <div>
                  <label for="mensaje" class="block text-sm font-medium text-gray-300 mb-2">Cuéntanos más sobre tu proyecto *</label>
                  <textarea 
                    id="mensaje" 
                    name="mensaje" 
                    rows="6" 
                    required
                    class="w-full px-4 py-3 bg-gray-800 border border-gray-600 rounded-lg text-white placeholder-gray-400 focus:border-neon-blue focus:ring-1 focus:ring-neon-blue transition-colors duration-300 resize-none"
                    placeholder="Describe tu proyecto, objetivos, funcionalidades deseadas, o cualquier información relevante que nos ayude a entender mejor tus necesidades..."
                  ></textarea>
                </div>

                <div class="flex items-start space-x-3">
                  <input 
                    type="checkbox" 
                    id="acepto-terminos" 
                    name="acepto-terminos" 
                    required
                    class="mt-1 w-4 h-4 text-neon-blue bg-gray-800 border-gray-600 rounded focus:ring-neon-blue focus:ring-2"
                  >
                  <label for="acepto-terminos" class="text-sm text-gray-300">
                    Acepto los <a href="#" class="text-neon-blue hover:text-neon-purple transition-colors duration-300">términos y condiciones</a> 
                    y la <a href="#" class="text-neon-blue hover:text-neon-purple transition-colors duration-300">política de privacidad</a> *
                  </label>
                </div>

                <div class="flex items-start space-x-3">
                  <input 
                    type="checkbox" 
                    id="newsletter" 
                    name="newsletter"
                    class="mt-1 w-4 h-4 text-neon-blue bg-gray-800 border-gray-600 rounded focus:ring-neon-blue focus:ring-2"
                  >
                  <label for="newsletter" class="text-sm text-gray-300">
                    Quiero recibir actualizaciones sobre FreeAgents y la Fundación
                  </label>
                </div>

                <button 
                  type="submit" 
                  class="w-full bg-gradient-to-r from-neon-blue to-neon-purple px-8 py-4 rounded-full text-white font-semibold text-lg hover:shadow-lg hover:shadow-neon-blue/25 transition-all duration-300 hover:scale-105"
                >
                  Enviar Mensaje
                </button>
              </form>
            </div>

            <!-- Información de Contacto -->
            <div class="space-y-8">
              <!-- Información General -->
              <div class="bg-gray-900 rounded-2xl p-8 border border-gray-700">
                <h3 class="font-display text-2xl font-bold text-white mb-6">Información de Contacto</h3>
                <div class="space-y-6">
                  <div class="flex items-start space-x-4">
                    <div class="w-12 h-12 bg-gradient-to-r from-neon-blue to-neon-purple rounded-xl flex items-center justify-center flex-shrink-0">
                      <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                      </svg>
                    </div>
                    <div>
                      <h4 class="font-semibold text-white mb-1">Email General</h4>
                      <p class="text-gray-400">hola@freeagents.dev</p>
                      <p class="text-gray-500 text-sm">Respuesta en 24 horas</p>
                    </div>
                  </div>

                  <div class="flex items-start space-x-4">
                    <div class="w-12 h-12 bg-gradient-to-r from-neon-purple to-neon-pink rounded-xl flex items-center justify-center flex-shrink-0">
                      <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2-2v2m8 0V6a2 2 0 012 2v6a2 2 0 01-2 2H8a2 2 0 01-2-2V8a2 2 0 012-2V6"></path>
                      </svg>
                    </div>
                    <div>
                      <h4 class="font-semibold text-white mb-1">Proyectos Empresariales</h4>
                      <p class="text-gray-400">proyectos@freeagents.dev</p>
                      <p class="text-gray-500 text-sm">Para proyectos +$50K</p>
                    </div>
                  </div>

                  <div class="flex items-start space-x-4">
                    <div class="w-12 h-12 bg-gradient-to-r from-neon-green to-neon-blue rounded-xl flex items-center justify-center flex-shrink-0">
                      <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                      </svg>
                    </div>
                    <div>
                      <h4 class="font-semibold text-white mb-1">Fundación FreeAgents</h4>
                      <p class="text-gray-400">fundacion@freeagents.dev</p>
                      <p class="text-gray-500 text-sm">Mentoría, talento y alianzas</p>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Redes Sociales -->
              <div class="bg-gray-900 rounded-2xl p-8 border border-gray-700">
                <h3 class="font-display text-2xl font-bold text-white mb-6">Síguenos</h3>
                <div class="flex space-x-4">
                  <a href="#" class="w-12 h-12 bg-gradient-to-r from-neon-blue to-neon-purple rounded-xl flex items-center justify-center hover:scale-110 transition-transform duration-300">
                    <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                    </svg>
                  </a>
                  <a href="#" class="w-12 h-12 bg-gradient-to-r from-neon-purple to-neon-pink rounded-xl flex items-center justify-center hover:scale-110 transition-transform duration-300">
                    <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"/>
                    </svg>
                  </a>
                  <a href="#" class="w-12 h-12 bg-gradient-to-r from-neon-green to-neon-blue rounded-xl flex items-center justify-center hover:scale-110 transition-transform duration-300">
                    <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.174-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911 1.024 0 1.518.769 1.518 1.688 0 1.029-.653 2.567-.992 3.992-.285 1.193.6 2.165 1.775 2.165 2.128 0 3.768-2.245 3.768-5.487 0-2.861-2.063-4.869-5.008-4.869-3.41 0-5.409 2.562-5.409 5.199 0 1.033.394 2.143.889 2.741.099.12.112.225.085.345-.09.375-.293 1.199-.334 1.363-.053.225-.172.271-.402.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.357-.629-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24.009 12.017 24.009c6.624 0 11.99-5.367 11.99-11.988C24.007 5.367 18.641.001 12.017.001z"/>
                    </svg>
                  </a>
                  <a href="#" class="w-12 h-12 bg-gradient-to-r from-neon-pink to-neon-purple rounded-xl flex items-center justify-center hover:scale-110 transition-transform duration-300">
                    <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.174-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911 1.024 0 1.518.769 1.518 1.688 0 1.029-.653 2.567-.992 3.992-.285 1.193.6 2.165 1.775 2.165 2.128 0 3.768-2.245 3.768-5.487 0-2.861-2.063-4.869-5.008-4.869-3.41 0-5.409 2.562-5.409 5.199 0 1.033.394 2.143.889 2.741.099.12.112.225.085.345-.09.375-.293 1.199-.334 1.363-.053.225-.172.271-.402.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.357-.629-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24.009 12.017 24.009c6.624 0 11.99-5.367 11.99-11.988C24.007 5.367 18.641.001 12.017.001z"/>
                    </svg>
                  </a>
                </div>
              </div>

              <!-- Horarios -->
              <div class="bg-gray-900 rounded-2xl p-8 border border-gray-700">
                <h3 class="font-display text-2xl font-bold text-white mb-6">Horarios de Atención</h3>
                <div class="space-y-3">
                  <div class="flex justify-between items-center">
                    <span class="text-gray-300">Lunes - Viernes</span>
                    <span class="text-neon-blue font-semibold">9:00 AM - 6:00 PM</span>
                  </div>
                  <div class="flex justify-between items-center">
                    <span class="text-gray-300">Sábados</span>
                    <span class="text-neon-purple font-semibold">10:00 AM - 2:00 PM</span>
                  </div>
                  <div class="flex justify-between items-center">
                    <span class="text-gray-300">Domingos</span>
                    <span class="text-gray-500">Cerrado</span>
                  </div>
                </div>
                <div class="mt-6 p-4 bg-gradient-to-r from-neon-blue/10 to-neon-purple/10 border border-neon-blue/30 rounded-xl">
                  <p class="text-gray-300 text-sm">
                    <strong class="text-neon-blue">Proyectos urgentes:</strong> Disponibilidad 24/7 para clientes Enterprise
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ Rápido -->
    <section class="py-20 bg-gray-900">
      <div class="container mx-auto px-6">
        <div class="text-center mb-16">
          <h2 class="font-display text-4xl md:text-5xl font-bold mb-6">
            <span class="bg-gradient-to-r from-neon-blue to-neon-purple bg-clip-text text-transparent">
              Preguntas Frecuentes
            </span>
          </h2>
          <p class="text-xl text-gray-400 max-w-3xl mx-auto">
            Respuestas rápidas a las consultas más comunes antes de contactarnos.
          </p>
        </div>

        <div class="max-w-4xl mx-auto">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div class="space-y-6">
              <div class="bg-gray-800 rounded-2xl p-6 border border-gray-700">
                <h3 class="font-semibold text-white mb-3">¿Cuánto tiempo toma recibir una respuesta?</h3>
                <p class="text-gray-400 text-sm">
                  Respondemos todos los mensajes en un máximo de 24 horas. Para proyectos urgentes, 
                  contacta directamente por teléfono.
                </p>
              </div>

              <div class="bg-gray-800 rounded-2xl p-6 border border-gray-700">
                <h3 class="font-semibold text-white mb-3">¿Ofrecen consultas gratuitas?</h3>
                <p class="text-gray-400 text-sm">
                  Sí, la primera consulta de 30 minutos es completamente gratuita para evaluar 
                  tu proyecto y determinar la mejor solución.
                </p>
              </div>

              <div class="bg-gray-800 rounded-2xl p-6 border border-gray-700">
                <h3 class="font-semibold text-white mb-3">¿Trabajan con startups pequeñas?</h3>
                <p class="text-gray-400 text-sm">
                  Absolutamente. Nos especializamos en emprendedores y tenemos planes flexibles 
                  para startups en diferentes etapas de crecimiento.
                </p>
              </div>
            </div>

            <div class="space-y-6">
              <div class="bg-gray-800 rounded-2xl p-6 border border-gray-700">
                <h3 class="font-semibold text-white mb-3">¿Cómo funciona el proceso de la Fundación?</h3>
                <p class="text-gray-400 text-sm">
                  Evaluamos cada aplicación individualmente. El proceso incluye entrevista técnica, 
                  evaluación de proyectos y matching con mentores apropiados.
                </p>
              </div>

              <div class="bg-gray-800 rounded-2xl p-6 border border-gray-700">
                <h3 class="font-semibold text-white mb-3">¿Manejan proyectos internacionales?</h3>
                <p class="text-gray-400 text-sm">
                  Sí, trabajamos con clientes en toda América Latina y Estados Unidos. 
                  Tenemos experiencia en proyectos remotos y equipos distribuidos.
                </p>
              </div>

              <div class="bg-gray-800 rounded-2xl p-6 border border-gray-700">
                <h3 class="font-semibold text-white mb-3">¿Qué incluye el mantenimiento?</h3>
                <p class="text-gray-400 text-sm">
                  Actualizaciones de seguridad, optimizaciones, nuevas funcionalidades menores, 
                  soporte técnico y monitoreo continuo según el plan elegido.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Final -->
    <section class="py-20 bg-gradient-to-r from-gray-900 via-gray-800 to-gray-900">
      <div class="container mx-auto px-6 text-center">
        <h2 class="font-display text-4xl md:text-5xl font-bold mb-6">
          <span class="bg-gradient-to-r from-neon-blue to-neon-purple bg-clip-text text-transparent">
            ¿Listo para Comenzar?
          </span>
        </h2>
        <p class="text-xl text-gray-400 mb-10 max-w-2xl mx-auto">
          No esperes más para transformar tu idea en realidad. Estamos aquí para acompañarte en cada paso del camino.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="#contacto-form" class="bg-gradient-to-r from-neon-blue to-neon-purple px-8 py-4 rounded-full text-white font-semibold text-lg hover:shadow-lg hover:shadow-neon-blue/25 transition-all duration-300 hover:scale-105">
            Enviar Mensaje Ahora
          </a>
          <a href="/precios" class="border-2 border-neon-purple px-8 py-4 rounded-full text-neon-purple font-semibold text-lg hover:bg-neon-purple hover:text-white transition-all duration-300 hover:scale-105">
            Ver Planes y Precios
          </a>
        </div>
      </div>
    </section>
  </div>
  <Footer />
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('contact-form');
    
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      
      // Aquí puedes agregar la lógica para enviar el formulario
      // Por ejemplo, usando fetch para enviar a un endpoint
      
      // Simulación de envío exitoso
      const submitButton = form.querySelector('button[type="submit"]');
      const originalText = submitButton?.textContent;
      
      if (submitButton) {
        submitButton.textContent = 'Enviando...';
        submitButton.disabled = true;
        
        setTimeout(() => {
          submitButton.textContent = '¡Mensaje Enviado!';
          submitButton.classList.remove('from-neon-blue', 'to-neon-purple');
          submitButton.classList.add('from-neon-green', 'to-neon-blue');
          
          setTimeout(() => {
            form.reset();
            submitButton.textContent = originalText;
            submitButton.disabled = false;
            submitButton.classList.remove('from-neon-green', 'to-neon-blue');
            submitButton.classList.add('from-neon-blue', 'to-neon-purple');
          }, 3000);
        }, 2000);
      }
    });

    // Smooth scroll para el enlace del CTA
    const ctaLinks = document.querySelectorAll('a[href="#contacto-form"]');
    ctaLinks.forEach(link => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        document.getElementById('contacto-form')?.scrollIntoView({
          behavior: 'smooth'
        });
      });
    });
  });
</script>