---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DynamicBackground from '../components/DynamicBackground.astro';
---

<Layout title="Contacto - FreeAgents" description="Hablemos de tu próximo proyecto. Contáctanos para desarrollo de software, apps, e-commerce o para unirte a la Fundación FreeAgents.">
  <Header />
  
  <main class="pt-20 relative min-h-screen overflow-hidden">
    <!-- Fondo Dinámico Potente para Toda la Vista -->
    <div class="fixed inset-0 -z-10">
      <DynamicBackground type="matrix" color="cyan" />
      <DynamicBackground type="particles" color="teal" />
      <DynamicBackground type="circuits" color="cyan" />
      
      <!-- Gradientes Animados Múltiples -->
      <div class="absolute inset-0">
        <div class="absolute top-0 left-0 w-full h-full bg-gradient-to-br from-cyan-900/30 via-teal-900/20 to-blue-900/30 animate-pulse"></div>
        <div class="absolute top-1/4 right-1/4 w-96 h-96 bg-neon-cyan/20 rounded-full blur-3xl animate-pulse"></div>
        <div class="absolute bottom-1/4 left-1/4 w-96 h-96 bg-neon-teal/20 rounded-full blur-3xl animate-pulse" style="animation-delay: 1s;"></div>
        <div class="absolute top-1/2 right-1/3 w-96 h-96 bg-neon-blue/15 rounded-full blur-3xl animate-pulse" style="animation-delay: 0.5s;"></div>
      </div>
      
      <!-- Grid Pattern Overlay -->
      <div class="absolute inset-0 opacity-10" style="background-image: linear-gradient(rgba(0, 212, 255, 0.2) 1px, transparent 1px), linear-gradient(90deg, rgba(20, 184, 166, 0.2) 1px, transparent 1px); background-size: 50px 50px; animation: grid-move 20s linear infinite;"></div>
    </div>

    <!-- Hero Section Única -->
    <section class="relative py-24 overflow-hidden">
      
      <div class="container mx-auto px-6 relative z-10">
        <div class="max-w-4xl mx-auto text-center">
          <div class="inline-block px-4 py-2 bg-neon-cyan/10 border border-neon-cyan/30 rounded-full mb-8">
            <span class="text-neon-cyan font-semibold text-sm">Contacto</span>
          </div>
          
          <h1 class="font-display text-5xl md:text-7xl font-bold mb-6 text-white">
            Hablemos de tu
            <br>
            <span class="bg-gradient-to-r from-neon-cyan to-neon-teal bg-clip-text text-transparent">
              Próximo Proyecto
            </span>
          </h1>
          
          <p class="text-xl text-gray-300 mb-4 max-w-3xl mx-auto">
            Estamos aquí para convertir tu visión en realidad. Agenda una <strong class="text-neon-cyan">llamada gratuita de 30 minutos</strong> 
            y descubre cómo podemos ayudarte.
          </p>
          
          <p class="text-lg text-gray-400 mb-12 max-w-2xl mx-auto">
            Sin compromiso. Solo una conversación honesta sobre tus necesidades tecnológicas.
          </p>

          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a 
              href="#contacto-form" 
              class="bg-gradient-to-r from-neon-cyan to-neon-teal px-10 py-5 rounded-full text-white font-bold text-lg hover:shadow-2xl hover:shadow-neon-cyan/30 transition-all duration-300 hover:scale-105"
            >
              Agendar Llamada Gratuita
            </a>
            <a 
              href="/servicios" 
              class="border-2 border-neon-teal px-10 py-5 rounded-full text-neon-teal font-bold text-lg hover:bg-neon-teal hover:text-white transition-all duration-300 hover:scale-105"
            >
              Ver Servicios
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Formulario de Contacto -->
    <section id="contacto-form" class="py-20 relative">
      <div class="container mx-auto px-6 relative z-10">
        <div class="max-w-7xl mx-auto">
          <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 items-start">
            <!-- Información de Contacto a la izquierda -->
            <div class="order-2 lg:order-1 space-y-8 lg:sticky lg:top-24">
              <!-- Información General -->
              <div class="bg-gray-900/60 backdrop-blur-sm rounded-2xl p-8 border border-gray-700">
                <h3 class="font-display text-2xl font-bold text-white mb-6">Información de Contacto</h3>
                <div class="space-y-6">
                  <div class="flex items-start space-x-4">
                    <div class="w-12 h-12 bg-gradient-to-r from-neon-blue to-neon-purple rounded-xl flex items-center justify-center flex-shrink-0">
                      <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                      </svg>
                    </div>
                    <div>
                      <h4 class="font-semibold text-white mb-1">Email General</h4>
                      <p class="text-gray-400">freeagentsdev@gmail.com</p>
                      <p class="text-gray-500 text-sm">Respuesta en 24 horas</p>
                    </div>
                  </div>

                  <div class="flex items-start space-x-4">
                    <div class="w-12 h-12 bg-gradient-to-r from-neon-purple to-neon-pink rounded-xl flex items-center justify-center flex-shrink-0">
                      <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2-2v2m8 0V6a2 2 0 012 2v6a2 2 0 01-2 2H8a2 2 0 01-2-2V8a2 2 0 012-2V6"></path>
                      </svg>
                    </div>
                    <div>
                      <h4 class="font-semibold text-white mb-1">Proyectos Empresariales</h4>
                      <p class="text-gray-400">freeagentsdev@gmail.com</p>
                      <p class="text-gray-500 text-sm">Para proyectos +$50K</p>
                    </div>
                  </div>

                  <div class="flex items-start space-x-4">
                    <div class="w-12 h-12 bg-gradient-to-r from-neon-green to-neon-blue rounded-xl flex items-center justify-center flex-shrink-0">
                      <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                      </svg>
                    </div>
                    <div>
                      <h4 class="font-semibold text-white mb-1">Fundación FreeAgents</h4>
                      <p class="text-gray-400">freeagentsdev@gmail.com</p>
                      <p class="text-gray-500 text-sm">Mentoría, talento y alianzas</p>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Redes Sociales -->
              <div class="bg-gray-900/60 backdrop-blur-sm rounded-2xl p-8 border border-gray-700">
                <h3 class="font-display text-2xl font-bold text-white mb-6">Síguenos</h3>
                <div class="flex space-x-4">
                  <!-- LinkedIn -->
                  <a href="https://www.linkedin.com/company/freeagentsdev/" target="_blank" class="w-12 h-12 bg-gradient-to-r from-neon-blue to-neon-purple rounded-xl flex items-center justify-center hover:scale-110 transition-transform duration-300" aria-label="LinkedIn">
                    <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M19 0h-14c-2.76 0-5 2.24-5 5v14c0 2.76 2.24 5 5 5h14c2.76 0 5-2.24 5-5v-14c0-2.76-2.24-5-5-5zm-11 19h-3v-9h3v9zm-1.5-10.28c-.97 0-1.75-.79-1.75-1.75s.78-1.75 1.75-1.75 1.75.79 1.75 1.75-.78 1.75-1.75 1.75zm13.5 10.28h-3v-4.5c0-1.08-.02-2.47-1.5-2.47-1.5 0-1.73 1.17-1.73 2.39v4.58h-3v-9h2.89v1.23h.04c.4-.75 1.38-1.54 2.84-1.54 3.04 0 3.6 2 3.6 4.59v5.72z"/>
                    </svg>
                  </a>
                  <!-- GitHub -->
                  <a href="https://github.com/FreeAgentsDev" target="_blank" class="w-12 h-12 bg-gradient-to-r from-neon-purple to-neon-pink rounded-xl flex items-center justify-center hover:scale-110 transition-transform duration-300" aria-label="GitHub">
                    <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M12 .5C5.73.5.5 5.73.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-2.02c-3.2.7-3.87-1.54-3.87-1.54-.53-1.34-1.3-1.7-1.3-1.7-1.06-.72.08-.729.08-.729 1.205.084 1.84 1.236 1.84 1.236 1.07 1.834 2.809 1.304 3.495.997.108-.775.418-1.305.762-1.605-2.665-.305-5.466-1.334-5.466-5.931 0-1.31.469-2.381 1.236-3.221-.124-.303-.535-1.523.117-3.176 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 2.9-.39c.98.01 1.97.13 2.9.39 2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.69 5.41-5.25 5.7.42.36.8 1.08.8 2.18v3.24c0 .31.21.67.8.56C20.71 21.39 24 17.08 24 12c0-6.27-5.23-11.5-12-11.5z"/>
                    </svg>
                  </a>
                  <!-- Instagram -->
                  <a href="https://www.instagram.com/freeagentsdev/" target="_blank" class="w-12 h-12 bg-gradient-to-r from-neon-green to-neon-blue rounded-xl flex items-center justify-center hover:scale-110 transition-transform duration-300" aria-label="Instagram">
                    <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M12 2.2c3.2 0 3.584.012 4.85.07 1.17.056 1.97.24 2.43.41.59.22 1.01.48 1.45.92.44.44.7.86.92 1.45.17.46.354 1.26.41 2.43.058 1.266.07 1.65.07 4.85s-.012 3.584-.07 4.85c-.056 1.17-.24 1.97-.41 2.43-.22.59-.48 1.01-.92 1.45-.44.44-.86.7-1.45.92-.46.17-1.26.354-2.43.41-1.266.058-1.65.07-4.85.07s-3.584-.012-4.85-.07c-1.17-.056-1.97-.24-2.43-.41-.59-.22-1.01-.48-1.45-.92-.44-.44-.7-.86-.92-1.45-.17-.46-.354-1.26-.41-2.43C2.212 15.784 2.2 15.4 2.2 12s.012-3.584.07-4.85c.056-1.17.24-1.97.41-2.43.22-.59.48-1.01.92-1.45.44-.44.86-.7 1.45-.92.46-.17 1.26-.354 2.43-.41C8.416 2.212 8.8 2.2 12 2.2zm0-2.2C8.736 0 8.332.012 7.052.07c-1.29.058-2.18.25-2.95.53-.8.29-1.48.68-2.15 1.35-.67.67-1.06 1.35-1.35 2.15-.28.77-.472 1.66-.53 2.95C.012 8.332 0 8.736 0 12c0 3.264.012 3.668.07 4.948.058 1.29.25 2.18.53 2.95.29.8.68 1.48 1.35 2.15.67.67 1.35 1.06 2.15 1.35.77.28 1.66.472 2.95.53C8.332 23.988 8.736 24 12 24c3.264 0 3.668-.012 4.948-.07 1.29-.058 2.18-.25 2.95-.53.8-.29 1.48-.68 2.15-1.35.67-.67 1.06-1.35 1.35-2.15.28-.77.472-1.66.53-2.95.058-1.28.07-1.684.07-4.948 0-3.264-.012-3.668-.07-4.948-.058-1.29-.25-2.18-.53-2.95-.29-.8-.68-1.48-1.35-2.15-.67-.67-1.35-1.06-2.15-1.35-.77-.28-1.66-.472-2.95-.53C15.668.012 15.264 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zm0 10.162a3.999 3.999 0 1 1 0-7.998 3.999 3.999 0 0 1 0 7.998zm7.844-10.406a1.44 1.44 0 1 1-2.88 0 1.44 1.44 0 0 1 2.88 0z"/>
                    </svg>
                  </a>
                  <!-- Facebook -->
                  <a href="https://www.facebook.com/profile.php?id=61577490723653" target="_blank" class="w-12 h-12 bg-gradient-to-r from-neon-pink to-neon-purple rounded-xl flex items-center justify-center hover:scale-110 transition-transform duration-300" aria-label="Facebook">
                    <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M22.675 0h-21.35C.595 0 0 .592 0 1.326v21.348C0 23.408.595 24 1.326 24H12.82v-9.294H9.692v-3.622h3.127V8.413c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.797.143v3.24l-1.918.001c-1.504 0-1.797.715-1.797 1.763v2.313h3.587l-.467 3.622h-3.12V24h6.116C23.406 24 24 23.408 24 22.674V1.326C24 .592 23.406 0 22.675 0"/>
                    </svg>
                  </a>
                </div>
              </div>

              <!-- Horarios -->
              <div class="bg-gray-900/60 backdrop-blur-sm rounded-2xl p-8 border border-gray-700">
                <h3 class="font-display text-2xl font-bold text-white mb-6">Horarios de Atención</h3>
                <div class="space-y-3">
                  <div class="flex justify-between items-center">
                    <span class="text-gray-300">Lunes - Viernes</span>
                    <span class="text-neon-blue font-semibold">9:00 AM - 6:00 PM</span>
                  </div>
                  <div class="flex justify-between items-center">
                    <span class="text-gray-300">Sábados</span>
                    <span class="text-neon-purple font-semibold">10:00 AM - 2:00 PM</span>
                  </div>
                  <div class="flex justify-between items-center">
                    <span class="text-gray-300">Domingos</span>
                    <span class="text-gray-500">Cerrado</span>
                  </div>
                </div>
                <div class="mt-6 p-4 bg-gradient-to-r from-neon-blue/10 to-neon-purple/10 border border-neon-blue/30 rounded-xl">
                  <p class="text-gray-300 text-sm">
                    <strong class="text-neon-blue">Proyectos urgentes:</strong> Disponibilidad 24/7 para clientes Enterprise
                  </p>
                </div>
              </div>
            </div>
            
            <!-- Formulario a la derecha -->
            <div class="order-1 lg:order-2 lg:col-span-2 bg-gray-900/60 backdrop-blur-sm rounded-2xl p-8 md:p-10 border border-gray-700 mx-auto w-full">
              <div class="mb-6">
                <div class="inline-block px-4 py-2 bg-neon-cyan/10 border border-neon-cyan/30 rounded-full mb-4">
                  <span class="text-neon-cyan font-semibold text-sm">Formulario de Contacto</span>
                </div>
                <h2 id="form-title" class="font-display text-3xl font-bold text-white mb-2">Cuéntanos sobre tu Proyecto</h2>
                <p class="text-gray-400">Completa el formulario y te responderemos en menos de 24 horas.</p>
              </div>
              <form id="contact-form" class="space-y-6">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                  <div>
                    <label for="nombre" class="block text-sm font-medium text-gray-300 mb-2">Nombre *</label>
                    <input 
                      type="text" 
                      id="nombre" 
                      name="nombre" 
                      required
                      class="w-full px-4 py-3 bg-gray-800 border border-gray-600 rounded-lg text-white placeholder-gray-400 focus:border-neon-blue focus:ring-1 focus:ring-neon-blue transition-colors duration-300"
                      placeholder="Tu nombre completo"
                    >
                  </div>
                  <div>
                    <label id="empresa-label" for="empresa" class="block text-sm font-medium text-gray-300 mb-2">Empresa</label>
                    <input 
                      type="text" 
                      id="empresa" 
                      name="empresa"
                      class="w-full px-4 py-3 bg-gray-800 border border-gray-600 rounded-lg text-white placeholder-gray-400 focus:border-neon-blue focus:ring-1 focus:ring-neon-blue transition-colors duration-300"
                      placeholder="Nombre de tu empresa"
                    >
                  </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                  <div>
                    <label for="email" class="block text-sm font-medium text-gray-300 mb-2">Email *</label>
                    <input 
                      type="email" 
                      id="email" 
                      name="email" 
                      required
                      class="w-full px-4 py-3 bg-gray-800 border border-gray-600 rounded-lg text-white placeholder-gray-400 focus:border-neon-blue focus:ring-1 focus:ring-neon-blue transition-colors duration-300"
                      placeholder="tu@email.com"
                    >
                  </div>
                  <div>
                    <label for="telefono" class="block text-sm font-medium text-gray-300 mb-2">Teléfono</label>
                    <input 
                      type="tel" 
                      id="telefono" 
                      name="telefono"
                      class="w-full px-4 py-3 bg-gray-800 border border-gray-600 rounded-lg text-white placeholder-gray-400 focus:border-neon-blue focus:ring-1 focus:ring-neon-blue transition-colors duration-300"
                      placeholder="+1 (555) 123-4567"
                    >
                  </div>
                </div>

                <div>
                  <label for="tipo-proyecto" class="block text-sm font-medium text-gray-300 mb-2">Tipo de Proyecto *</label>
                  <select 
                    id="tipo-proyecto" 
                    name="tipo-proyecto" 
                    required
                    class="w-full px-4 py-3 bg-gray-800 border border-gray-600 rounded-lg text-white focus:border-neon-blue focus:ring-1 focus:ring-neon-blue transition-colors duration-300"
                  >
                    <option value="">Selecciona una opción</option>
                    <option value="desarrollo-medida">Desarrollo a la Medida</option>
                    <option value="app-movil">Aplicación Móvil</option>
                    <option value="ecommerce">E-commerce</option>
                    <option value="consultoria">Consultoría Técnica</option>
                    <option value="fundacion-talento">Fundación - Aplicar como Talento</option>
                    <option value="fundacion-mentor">Fundación - Ser Mentor</option>
                    <option value="fundacion-aliado">Fundación - Ser Aliado</option>
                    <option value="otro">Otro</option>
                  </select>
                </div>

                <div id="proyecto-fields" class="hidden">
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                      <label for="presupuesto" class="block text-sm font-medium text-gray-300 mb-2">Presupuesto Estimado</label>
                      <select 
                        id="presupuesto" 
                        name="presupuesto"
                        class="w-full px-4 py-3 bg-gray-800 border border-gray-600 rounded-lg text-white focus:border-neon-blue focus:ring-1 focus:ring-neon-blue transition-colors duration-300"
                      >
                        <option value="">Selecciona un rango</option>
                        <option value="800k-1.6m">$800.000 - $1.599.000 (Startup)</option>
                        <option value="1.6m-4m">$1.600.000 - $4.000.000 (Growth)</option>
                        <option value="4.5m+">$4.500.000+ (Enterprise)</option>
                        <option value="no-definido">Aún no definido</option>
                      </select>
                    </div>
                    <div>
                      <label for="timeline" class="block text-sm font-medium text-gray-300 mb-2">Timeline Deseado</label>
                      <select 
                        id="timeline" 
                        name="timeline"
                        class="w-full px-4 py-3 bg-gray-800 border border-gray-600 rounded-lg text-white focus:border-neon-blue focus:ring-1 focus:ring-neon-blue transition-colors duration-300"
                      >
                        <option value="">Selecciona un timeline</option>
                        <option value="urgente">Lo antes posible (1-2 meses)</option>
                        <option value="normal">Normal (3-6 meses)</option>
                        <option value="flexible">Flexible (6+ meses)</option>
                        <option value="exploratorio">Solo explorando opciones</option>
                      </select>
                    </div>
                  </div>
                </div>

                <div id="fundacion-fields" class="hidden">
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                      <label for="experiencia" class="block text-sm font-medium text-gray-300 mb-2">Experiencia</label>
                      <select 
                        id="experiencia" 
                        name="experiencia"
                        class="w-full px-4 py-3 bg-gray-800 border border-gray-600 rounded-lg text-white focus:border-neon-blue focus:ring-1 focus:ring-neon-blue transition-colors duration-300"
                      >
                        <option value="">Selecciona tu experiencia</option>
                        <option value="estudiante">Estudiante</option>
                        <option value="profesional">Profesional</option>
                        <option value="senior">Senior</option>
                        <option value="otro">Otro</option>
                      </select>
                    </div>
                    <div>
                      <label for="disponibilidad" class="block text-sm font-medium text-gray-300 mb-2">Disponibilidad</label>
                      <select 
                        id="disponibilidad" 
                        name="disponibilidad"
                        class="w-full px-4 py-3 bg-gray-800 border border-gray-600 rounded-lg text-white focus:border-neon-blue focus:ring-1 focus:ring-neon-blue transition-colors duration-300"
                      >
                        <option value="">Selecciona tu disponibilidad</option>
                        <option value="tiempo-completo">Tiempo completo</option>
                        <option value="medio-tiempo">Medio tiempo</option>
                        <option value="flexible">Flexible</option>
                        <option value="otro">Otro</option>
                      </select>
                    </div>
                  </div>
                </div>

                <div>
                  <label id="mensaje-label" for="mensaje" class="block text-sm font-medium text-gray-300 mb-2">Cuéntanos más sobre tu proyecto *</label>
                  <textarea 
                    id="mensaje" 
                    name="mensaje" 
                    rows="6" 
                    required
                    class="w-full px-4 py-3 bg-gray-800 border border-gray-600 rounded-lg text-white placeholder-gray-400 focus:border-neon-blue focus:ring-1 focus:ring-neon-blue transition-colors duration-300 resize-none"
                    placeholder="Describe tu proyecto, objetivos, funcionalidades deseadas, o cualquier información relevante que nos ayude a entender mejor tus necesidades..."
                  ></textarea>
                </div>

                <div class="flex flex-col sm:flex-row gap-4 mt-8">
                  <button 
                    type="button" 
                    id="enviar-whatsapp"
                    class="w-full bg-gradient-to-r from-green-400 to-green-600 px-8 py-4 rounded-full text-white font-semibold text-lg hover:shadow-lg hover:shadow-green-400/25 transition-all duration-300 hover:scale-105 flex items-center justify-center gap-2"
                  >
                    <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M20.52 3.48A12.07 12.07 0 0 0 12 0C5.37 0 0 5.37 0 12c0 2.11.55 4.16 1.6 5.97L0 24l6.22-1.63A11.93 11.93 0 0 0 12 24c6.63 0 12-5.37 12-12 0-3.2-1.25-6.21-3.48-8.52zM12 22c-1.85 0-3.68-.5-5.26-1.44l-.38-.22-3.69.97.99-3.59-.25-.37A9.94 9.94 0 0 1 2 12c0-5.52 4.48-10 10-10s10 4.48 10 10-4.48 10-10 10zm5.2-7.6c-.28-.14-1.65-.81-1.9-.9-.25-.09-.43-.14-.61.14-.18.28-.28.7.9.86 1.08.16.18.32.2.6.07.28-.14-1.18-.44-2.25-1.4-.83-.74-1.39-1.65-1.55-1.93-.16-.28-.02-.43.12-.57.13-.13.28-.34.42-.51.14-.17.18-.29.28-.48.09-.18.05-.36-.02-.5-.07-.14-.61-1.47-.84-2.01-.22-.53-.45-.46-.61-.47-.16-.01-.36-.01-.56-.01-.19 0-.5.07-.76.34-.26.27-1 1-.97 2.43.03 1.43 1.03 2.81 1.18 3 .15.19 2.03 3.1 4.93 4.22.69.3 1.23.48 1.65.61.69.22 1.32.19 1.81.12.55-.08 1.65-.67 1.88-1.32.23-.65.23-1.2.16-1.32-.07-.12-.25-.19-.53-.33z"/></svg>
                    Enviar por WhatsApp
                  </button>
                  <button 
                    type="button" 
                    id="enviar-email"
                    class="w-full bg-gradient-to-r from-blue-500 to-purple-600 px-8 py-4 rounded-full text-white font-semibold text-lg hover:shadow-lg hover:shadow-blue-400/25 transition-all duration-300 hover:scale-105 flex items-center justify-center gap-2"
                  >
                    <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 2v.01L12 13 4 6.01V6h16zM4 20V8.99l8 6.99 8-6.99V20H4z"/></svg>
                    Enviar por Email
                  </button>
                </div>
                <p id="form-alert" class="text-red-500 text-sm mt-4 hidden"></p>
              </form>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ Rápido -->
    <section class="py-20 relative">
      <div class="container mx-auto px-6 relative z-10">
        <div class="text-center mb-16">
          <h2 class="font-display text-4xl md:text-5xl font-bold mb-6">
            <span class="bg-gradient-to-r from-neon-blue to-neon-purple bg-clip-text text-transparent">
              Preguntas Frecuentes
            </span>
          </h2>
          <p class="text-xl text-gray-400 max-w-3xl mx-auto">
            Respuestas rápidas a las consultas más comunes antes de contactarnos.
          </p>
        </div>

        <div class="max-w-4xl mx-auto">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div class="space-y-6">
              <div class="bg-gray-800/60 backdrop-blur-sm rounded-2xl p-6 border border-gray-700">
                <h3 class="font-semibold text-white mb-3">¿Cuánto tiempo toma recibir una respuesta?</h3>
                <p class="text-gray-400 text-sm">
                  Respondemos todos los mensajes en un máximo de 24 horas. Para proyectos urgentes, 
                  contacta directamente por teléfono.
                </p>
              </div>

              <div class="bg-gray-800/60 backdrop-blur-sm rounded-2xl p-6 border border-gray-700">
                <h3 class="font-semibold text-white mb-3">¿Ofrecen consultas gratuitas?</h3>
                <p class="text-gray-400 text-sm">
                  Sí, la primera consulta de 30 minutos es completamente gratuita para evaluar 
                  tu proyecto y determinar la mejor solución.
                </p>
              </div>

              <div class="bg-gray-800/60 backdrop-blur-sm rounded-2xl p-6 border border-gray-700">
                <h3 class="font-semibold text-white mb-3">¿Trabajan con startups pequeñas?</h3>
                <p class="text-gray-400 text-sm">
                  Absolutamente. Nos especializamos en emprendedores y tenemos planes flexibles 
                  para startups en diferentes etapas de crecimiento.
                </p>
              </div>
            </div>

            <div class="space-y-6">
              <div class="bg-gray-800/60 backdrop-blur-sm rounded-2xl p-6 border border-gray-700">
                <h3 class="font-semibold text-white mb-3">¿Cómo funciona el proceso de la Fundación?</h3>
                <p class="text-gray-400 text-sm">
                  Evaluamos cada aplicación individualmente. El proceso incluye entrevista técnica, 
                  evaluación de proyectos y matching con mentores apropiados.
                </p>
              </div>

              <div class="bg-gray-800/60 backdrop-blur-sm rounded-2xl p-6 border border-gray-700">
                <h3 class="font-semibold text-white mb-3">¿Manejan proyectos internacionales?</h3>
                <p class="text-gray-400 text-sm">
                  Sí, trabajamos con clientes en toda América Latina y Estados Unidos. 
                  Tenemos experiencia en proyectos remotos y equipos distribuidos.
                </p>
              </div>

              <div class="bg-gray-800/60 backdrop-blur-sm rounded-2xl p-6 border border-gray-700">
                <h3 class="font-semibold text-white mb-3">¿Qué incluye el mantenimiento?</h3>
                <p class="text-gray-400 text-sm">
                  Actualizaciones de seguridad, optimizaciones, nuevas funcionalidades menores, 
                  soporte técnico y monitoreo continuo según el plan elegido.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Final -->
    <section class="py-20 relative">
      <div class="container mx-auto px-6 text-center relative z-10">
        <h2 class="font-display text-4xl md:text-5xl font-bold mb-6">
          <span class="bg-gradient-to-r from-neon-blue to-neon-purple bg-clip-text text-transparent">
            ¿Listo para Comenzar?
          </span>
        </h2>
        <p class="text-xl text-gray-400 mb-10 max-w-2xl mx-auto">
          No esperes más para transformar tu idea en realidad. Estamos aquí para acompañarte en cada paso del camino.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="#contacto-form" class="bg-gradient-to-r from-neon-blue to-neon-purple px-8 py-4 rounded-full text-white font-semibold text-lg hover:shadow-lg hover:shadow-neon-blue/25 transition-all duration-300 hover:scale-105">
            Completar Formulario
          </a>
          <a href="/precios" class="border-2 border-neon-purple px-8 py-4 rounded-full text-neon-purple font-semibold text-lg hover:bg-neon-purple hover:text-white transition-all duration-300 hover:scale-105">
            Ver Planes y Precios
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  @keyframes grid-move {
    0% {
      transform: translate(0, 0);
    }
    100% {
      transform: translate(50px, 50px);
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('contact-form');
    const btnWhatsapp = document.getElementById('enviar-whatsapp');
    const btnEmail = document.getElementById('enviar-email');
    const alertMsg = document.getElementById('form-alert');
    const tipoProyecto = document.getElementById('tipo-proyecto') as HTMLSelectElement;
    const proyectoFields = document.getElementById('proyecto-fields');
    const fundacionFields = document.getElementById('fundacion-fields');
    const formTitle = document.getElementById('form-title');
    const empresaLabel = document.getElementById('empresa-label');
    const mensajeLabel = document.getElementById('mensaje-label');
    const mensajeTextarea = document.getElementById('mensaje') as HTMLTextAreaElement;

    // Función para actualizar la interfaz según la selección
    function actualizarInterfaz() {
      const valor = tipoProyecto.value;
      const esFundacion = valor.startsWith('fundacion-');
      
      if (esFundacion) {
        // Configuración para Fundación
        if (formTitle) formTitle.textContent = 'Únete a la Fundación FreeAgents';
        if (empresaLabel) empresaLabel.textContent = 'Organización / Universidad';
        if (mensajeLabel) mensajeLabel.textContent = 'Cuéntanos sobre tu interés en la Fundación *';
        if (mensajeTextarea) {
          mensajeTextarea.placeholder = 'Describe tu motivación para unirte a la Fundación, tu experiencia, objetivos de aprendizaje o cómo te gustaría contribuir...';
        }
        if (proyectoFields) proyectoFields.classList.add('hidden');
        if (fundacionFields) fundacionFields.classList.remove('hidden');
      } else if (valor && valor !== 'otro') {
        // Configuración para Proyectos Empresariales
        if (formTitle) formTitle.textContent = 'Cuéntanos sobre tu Proyecto';
        if (empresaLabel) empresaLabel.textContent = 'Empresa';
        if (mensajeLabel) mensajeLabel.textContent = 'Cuéntanos más sobre tu proyecto *';
        if (mensajeTextarea) {
          mensajeTextarea.placeholder = 'Describe tu proyecto, objetivos, funcionalidades deseadas, o cualquier información relevante que nos ayude a entender mejor tus necesidades...';
        }
        if (proyectoFields) proyectoFields.classList.remove('hidden');
        if (fundacionFields) fundacionFields.classList.add('hidden');
      } else {
        // Configuración por defecto
        if (formTitle) formTitle.textContent = 'Cuéntanos sobre tu Proyecto';
        if (empresaLabel) empresaLabel.textContent = 'Empresa';
        if (mensajeLabel) mensajeLabel.textContent = 'Cuéntanos más sobre tu proyecto *';
        if (mensajeTextarea) {
          mensajeTextarea.placeholder = 'Describe tu proyecto, objetivos, funcionalidades deseadas, o cualquier información relevante que nos ayude a entender mejor tus necesidades...';
        }
        if (proyectoFields) proyectoFields.classList.add('hidden');
        if (fundacionFields) fundacionFields.classList.add('hidden');
      }
    }

    // Event listener para cambios en el tipo de proyecto
    if (tipoProyecto) {
      tipoProyecto.addEventListener('change', actualizarInterfaz);
    }

    function getFormData() {
      const f = form as HTMLFormElement | null;
      if (!f) return {
        nombre: '', empresa: '', email: '', telefono: '', tipo: '', presupuesto: '', timeline: '', mensaje: '', experiencia: '', disponibilidad: ''
      };
      return {
        nombre: (f.elements.namedItem('nombre') as HTMLInputElement)?.value.trim(),
        empresa: (f.elements.namedItem('empresa') as HTMLInputElement)?.value.trim(),
        email: (f.elements.namedItem('email') as HTMLInputElement)?.value.trim(),
        telefono: (f.elements.namedItem('telefono') as HTMLInputElement)?.value.trim(),
        tipo: (f.elements.namedItem('tipo-proyecto') as HTMLSelectElement)?.value.trim(),
        presupuesto: (f.elements.namedItem('presupuesto') as HTMLSelectElement)?.value.trim(),
        timeline: (f.elements.namedItem('timeline') as HTMLSelectElement)?.value.trim(),
        mensaje: (f.elements.namedItem('mensaje') as HTMLTextAreaElement)?.value.trim(),
        experiencia: (f.elements.namedItem('experiencia') as HTMLSelectElement)?.value.trim(),
        disponibilidad: (f.elements.namedItem('disponibilidad') as HTMLSelectElement)?.value.trim(),
      };
    }

    function validarCampos(data: {nombre: string, empresa: string, email: string, telefono: string, tipo: string, presupuesto: string, timeline: string, mensaje: string, experiencia: string, disponibilidad: string}): string {
      if (!data.nombre || !data.email || !data.tipo || !data.mensaje) {
        return 'Por favor completa todos los campos obligatorios marcados con *';
      }
      if (!data.email.includes('@')) {
        return 'Por favor ingresa un email válido';
      }
      return '';
    }

    function mensajeWhatsapp(data: {nombre: string, empresa: string, email: string, telefono: string, tipo: string, presupuesto: string, timeline: string, mensaje: string, experiencia: string, disponibilidad: string}): string {
      const esFundacion = data.tipo.startsWith('fundacion-');
      
      if (esFundacion) {
        return encodeURIComponent(
          `¡Hola Fundación FreeAgents! 👋\n\n` +
          `Mi nombre es: ${data.nombre}${data.empresa ? ' (' + data.empresa + ')' : ''}\n` +
          `Email: ${data.email}\n` +
          (data.telefono ? `Teléfono: ${data.telefono}\n` : '') +
          `Interés en: ${data.tipo}\n` +
          (data.experiencia ? `Experiencia: ${data.experiencia}\n` : '') +
          (data.disponibilidad ? `Disponibilidad: ${data.disponibilidad}\n` : '') +
          `\nMotivación e interés:\n${data.mensaje}\n\n¡Gracias!`
        );
      } else {
        return encodeURIComponent(
          `¡Hola FreeAgents! 👋\n\n` +
          `Mi nombre es: ${data.nombre}${data.empresa ? ' (' + data.empresa + ')' : ''}\n` +
          `Email: ${data.email}\n` +
          (data.telefono ? `Teléfono: ${data.telefono}\n` : '') +
          `Tipo de proyecto: ${data.tipo}\n` +
          (data.presupuesto ? `Presupuesto estimado: ${data.presupuesto}\n` : '') +
          (data.timeline ? `Timeline deseado: ${data.timeline}\n` : '') +
          `\nDetalles del proyecto:\n${data.mensaje}\n\n¡Gracias!`
        );
      }
    }

    function mensajeEmail(data: {nombre: string, empresa: string, email: string, telefono: string, tipo: string, presupuesto: string, timeline: string, mensaje: string, experiencia: string, disponibilidad: string}): string {
      const esFundacion = data.tipo.startsWith('fundacion-');
      
      if (esFundacion) {
        return (
          `¡Hola Fundación FreeAgents!%0D%0A%0D%0A` +
          `Mi nombre es: ${data.nombre}${data.empresa ? ' (' + data.empresa + ')' : ''}%0D%0A` +
          `Email: ${data.email}%0D%0A` +
          (data.telefono ? `Teléfono: ${data.telefono}%0D%0A` : '') +
          `Interés en: ${data.tipo}%0D%0A` +
          (data.experiencia ? `Experiencia: ${data.experiencia}%0D%0A` : '') +
          (data.disponibilidad ? `Disponibilidad: ${data.disponibilidad}%0D%0A` : '') +
          `%0D%0AMotivación e interés:%0D%0A${data.mensaje}%0D%0A%0D%0A¡Gracias!`
        );
      } else {
        return (
          `¡Hola FreeAgents!%0D%0A%0D%0A` +
          `Mi nombre es: ${data.nombre}${data.empresa ? ' (' + data.empresa + ')' : ''}%0D%0A` +
          `Email: ${data.email}%0D%0A` +
          (data.telefono ? `Teléfono: ${data.telefono}%0D%0A` : '') +
          `Tipo de proyecto: ${data.tipo}%0D%0A` +
          (data.presupuesto ? `Presupuesto estimado: ${data.presupuesto}%0D%0A` : '') +
          (data.timeline ? `Timeline deseado: ${data.timeline}%0D%0A` : '') +
          `%0D%0ADetalles del proyecto:%0D%0A${data.mensaje}%0D%0A%0D%0A¡Gracias!`
        );
      }
    }

    if (btnWhatsapp) {
      btnWhatsapp.addEventListener('click', () => {
        const data = getFormData();
        const error = validarCampos(data);
        if (alertMsg) {
          if (error) {
            alertMsg.textContent = error;
            alertMsg.classList.remove('hidden');
            return;
          }
          alertMsg.classList.add('hidden');
        }
        const texto = mensajeWhatsapp(data);
        window.open(`https://wa.me/573004940576?text=${texto}`, '_blank');
      });
    }

    if (btnEmail) {
      btnEmail.addEventListener('click', () => {
        const data = getFormData();
        const error = validarCampos(data);
        if (alertMsg) {
          if (error) {
            alertMsg.textContent = error;
            alertMsg.classList.remove('hidden');
            return;
          }
          alertMsg.classList.add('hidden');
        }
        if (data.email.endsWith('@gmail.com')) {
          const subject = encodeURIComponent('Nuevo contacto desde FreeAgents');
          const body = mensajeEmail(data);
          window.open(`https://mail.google.com/mail/?view=cm&fs=1&to=freeagentsdev@gmail.com&su=${subject}&body=${body}`, '_blank');
        } else if (alertMsg) {
          alertMsg.textContent = 'Solo puedes usar el envío por email si tu correo es de Gmail.';
          alertMsg.classList.remove('hidden');
        }
      });
    }

    // Smooth scroll para el enlace del CTA
    const ctaLinks = document.querySelectorAll('a[href="#contacto-form"]');
    ctaLinks.forEach(link => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        document.getElementById('contacto-form')?.scrollIntoView({
          behavior: 'smooth'
        });
      });
    });
  });
</script>