---
interface Props {
  title: string;
  subtitle: string;
  description: string;
  ctaText: string;
  ctaLink: string;
  secondaryCtaText?: string;
  secondaryCtaLink?: string;
  backgroundImage?: string;
}

const { 
  title, 
  subtitle, 
  description, 
  ctaText, 
  ctaLink, 
  secondaryCtaText, 
  secondaryCtaLink,
  backgroundImage = "/elongreen.png"
} = Astro.props;
---

<section class="pt-10 relative min-h-screen flex items-center justify-center overflow-hidden">
  <!-- Background -->
  <div class="absolute inset-0 bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900"></div>
  
  <!-- Animated background elements -->
  <div class="absolute inset-0">
    <div class="absolute top-1/4 left-1/4 w-64 h-64 bg-neon-cyan/10 rounded-full blur-3xl animate-pulse"></div>
    <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-neon-teal/10 rounded-full blur-3xl animate-pulse delay-1000"></div>
    <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-32 h-32 bg-neon-blue/20 rounded-full blur-2xl animate-float"></div>
  </div>

  <div class="relative z-10 container mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <!-- Content -->
      <div class="text-center lg:text-left">
        <!-- Title -->
        <h1 class="font-display text-5xl md:text-7xl font-bold mb-6 animate-slide-up">
          <span class="text-white">
            {title.split(' ').slice(0, -2).join(' ')}
          </span>
          <br>
          <span class="bg-gradient-to-r from-neon-cyan to-neon-teal bg-clip-text text-transparent">
            {title.split(' ').slice(-2).join(' ')}
          </span>
        </h1>

        <!-- Subtitle -->
        <h2 class="text-2xl md:text-3xl font-semibold text-gray-300 mb-6 animate-slide-up delay-200">
          {subtitle}
        </h2>

        <!-- Description -->
        <p class="text-xl text-gray-400 mb-10 leading-relaxed animate-slide-up delay-300">
          {description}
        </p>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start animate-slide-up delay-500">
          <a 
            href={ctaLink}
            class="bg-gradient-to-r from-neon-cyan to-neon-teal px-8 py-4 rounded-full text-white font-semibold text-lg hover:shadow-lg hover:shadow-neon-cyan/25 transition-all duration-300 hover:scale-105"
          >
            {ctaText}
          </a>
          {secondaryCtaText && secondaryCtaLink && (
            <a 
              href={secondaryCtaLink}
              class="border-2 border-neon-teal px-8 py-4 rounded-full text-neon-teal font-semibold text-lg hover:bg-neon-teal hover:text-white transition-all duration-300 hover:scale-105"
            >
              {secondaryCtaText}
            </a>
          )}
        </div>
      </div>

      <!-- Hero Image -->
      <div class="relative flex justify-center lg:justify-end">
        <div class="relative">
          <!-- Glow effect behind image -->
          <div class="absolute inset-0 bg-gradient-to-r from-neon-cyan/20 to-neon-teal/20 rounded-3xl blur-2xl transform scale-110"></div>
          
          <!-- Main image container -->
          <div class="relative bg-gradient-to-br from-gray-800/50 to-gray-900/50 backdrop-blur-sm rounded-3xl p-8 border border-gray-700/50">
            <img 
              src={backgroundImage} 
              alt="FreeAgents" 
              class="h-80 rounded-3xl w-auto mx-auto animate-float drop-shadow-2xl"
            >
            
            <!-- Decorative elements -->
            <div class="absolute -top-4 -right-4 w-8 h-8 bg-neon-cyan rounded-full animate-pulse"></div>
            <div class="absolute -bottom-4 -left-4 w-6 h-6 bg-neon-teal rounded-full animate-pulse delay-500"></div>
            <div class="absolute top-1/2 -left-6 w-4 h-4 bg-neon-blue rounded-full animate-pulse delay-1000"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes delay-200 {
    0% { animation-delay: 0.2s; }
  }
  @keyframes delay-300 {
    0% { animation-delay: 0.3s; }
  }
  @keyframes delay-500 {
    0% { animation-delay: 0.5s; }
  }
  @keyframes delay-1000 {
    0% { animation-delay: 1s; }
  }
</style>