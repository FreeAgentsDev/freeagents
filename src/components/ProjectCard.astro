---
// Props para la card de proyecto
export interface Props {
  title: string;
  description: string;
  media?: Array<{ type: 'image' | 'video'; src: string; alt?: string }>; // Soporte para imágenes y videos
  imageAlt?: string; // Mantener por compatibilidad
  techs?: { name: string; colorClass: string }[];
  badge?: string;
  badgeColorClass?: string;
  category?: string;
  detailsUrl?: string;
  detailsLabel?: string;
  metric?: string;
  metricLabel?: string;
  demoUrl?: string;
}
const {
  title,
  description,
  media = [],
  imageAlt = '',
  techs = [],
  badge,
  badgeColorClass = '',
  category,
  detailsUrl = '',
  detailsLabel = 'Ver detalles →',
  metric,
  metricLabel,
  demoUrl = ''
} = Astro.props;

// Generar IDs únicos basados en el título
const cardId = title.toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '');
const mediaId = `project-media-${cardId}`;
const prevId = `prev-btn-${cardId}`;
const nextId = `next-btn-${cardId}`;
---
<div class="project-card bg-gray-800 rounded-2xl overflow-hidden border border-gray-700 hover:border-neon-blue/50 transition-all duration-300 group hover:scale-105" data-category={category} data-media={JSON.stringify(media.length > 4 ? media.slice(0,4) : media)}>
  <div class="h-48 bg-gradient-to-br from-neon-blue/20 to-neon-purple/20 flex items-center justify-center relative overflow-hidden">
    {media.length > 0 && (
      <>
        {media[0].type === 'video' ? (
          <video id={mediaId} class="max-h-44 w-auto rounded transition-all duration-300 shadow-lg" controls muted loop>
            <source src={media[0].src} type="video/mp4" />
            Tu navegador no soporta el elemento video.
          </video>
        ) : (
          <img id={mediaId} src={media[0].src} alt={media[0].alt || imageAlt} class="max-h-44 w-auto rounded transition-all duration-300 shadow-lg" />
        )}
        {media.length > 1 && (
          <>
            <button type="button" id={prevId} class="absolute left-2 z-10 bg-gray-900/70 rounded-full p-1 text-white hover:bg-neon-blue transition-colors duration-200 focus:outline-none">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
            </button>
            <button type="button" id={nextId} class="absolute right-2 z-10 bg-gray-900/70 rounded-full p-1 text-white hover:bg-neon-blue transition-colors duration-200 focus:outline-none">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </button>
          </>
        )}
      </>
    )}
    {badge && (
      <div class="absolute top-4 right-4">
        <span class={`px-3 py-1 rounded-full text-sm font-medium ${badgeColorClass}`}>{badge}</span>
      </div>
    )}
  </div>
  <div class="flex flex-col gap-4 p-6">
    <div class="flex flex-col gap-2">
      {badge && (
        <span class={`text-xs font-medium px-2.5 py-0.5 rounded-full w-fit ${badgeColorClass}`}>
          {badge}
        </span>
      )}
      <h3 class="text-xl font-bold text-white group-hover:text-neon-blue transition-colors">
        {title}
      </h3>
      <p class="text-gray-400 text-sm">
        {description}
      </p>
    </div>

    {techs.length > 0 && (
      <div class="flex flex-wrap gap-2">
        {techs.map(tech => (
          <span class={`text-xs font-medium px-2.5 py-0.5 rounded-full ${tech.colorClass}`}>
            {tech.name}
          </span>
        ))}
      </div>
    )}

    {(metric || detailsUrl || demoUrl) && (
      <div class="flex flex-wrap items-center gap-4 mt-auto">
        {metric && (
          <div class="flex items-center gap-2">
            <span class="text-neon-blue font-bold">{metric}</span>
            {metricLabel && <span class="text-gray-400 text-sm">{metricLabel}</span>}
          </div>
        )}
        <div class="flex flex-wrap gap-4 ml-auto">
          {demoUrl && (
            <a
              href={demoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm font-medium text-neon-purple hover:text-neon-blue transition-colors"
            >
              Ver demo →
            </a>
          )}
          {detailsUrl && (
            <a
              href={detailsUrl}
              class="text-sm font-medium text-neon-blue hover:text-neon-purple transition-colors"
            >
              {detailsLabel}
            </a>
          )}
        </div>
      </div>
    )}
  </div>
  {media.length > 1 && (
    <script is:inline define:vars={{ mediaId, prevId, nextId }}>
      (() => {
        let idx = 0;
        const mediaElement = document.getElementById(mediaId);
        const prev = document.getElementById(prevId);
        const next = document.getElementById(nextId);
        const container = mediaElement?.closest('.project-card');
        const mediaArray = container ? JSON.parse(container.getAttribute('data-media')) : [];
        
        function show(i) {
          if (!mediaElement || !mediaArray[i]) return;
          
          const currentMedia = mediaArray[i];
          const isVideo = currentMedia.type === 'video';
          
          if (isVideo) {
            // Si el elemento actual es un video, reemplazar el src
            if (mediaElement.tagName === 'VIDEO') {
              mediaElement.src = currentMedia.src;
            } else {
              // Si era una imagen, reemplazar con video
              const video = document.createElement('video');
              video.id = mediaId;
              video.className = 'max-h-44 w-auto rounded transition-all duration-300 shadow-lg';
              video.controls = true;
              video.muted = true;
              video.loop = true;
              video.innerHTML = `<source src="${currentMedia.src}" type="video/mp4" />Tu navegador no soporta el elemento video.`;
              mediaElement.parentNode.replaceChild(video, mediaElement);
            }
          } else {
            // Si el elemento actual es una imagen, reemplazar el src
            if (mediaElement.tagName === 'IMG') {
              mediaElement.src = currentMedia.src;
              mediaElement.alt = currentMedia.alt || '';
            } else {
              // Si era un video, reemplazar con imagen
              const img = document.createElement('img');
              img.id = mediaId;
              img.src = currentMedia.src;
              img.alt = currentMedia.alt || '';
              img.className = 'max-h-44 w-auto rounded transition-all duration-300 shadow-lg';
              mediaElement.parentNode.replaceChild(img, mediaElement);
            }
          }
        }
        
        prev?.addEventListener('click', () => {
          idx = (idx - 1 + mediaArray.length) % mediaArray.length;
          show(idx);
        });
        next?.addEventListener('click', () => {
          idx = (idx + 1) % mediaArray.length;
          show(idx);
        });
      })();
    </script>
  )}
</div> 