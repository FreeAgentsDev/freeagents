---
import LanguageSelector from './LanguageSelector.astro';

const currentPath = Astro.url.pathname;
---

<header class="fixed top-0 w-full z-50" id="main-header">
  <!-- Animated Background Gradient con Glassmorphism -->
  <div class="absolute inset-0 bg-gray-900/80 backdrop-blur-xl border-b border-gray-800/50"></div>
  
  <!-- Efectos de Fondo Dinámico Sutil -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <!-- Grid Pattern Sutil -->
    <div class="absolute inset-0 opacity-5" style="background-image: linear-gradient(rgba(0, 212, 255, 0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(20, 184, 166, 0.1) 1px, transparent 1px); background-size: 30px 30px;"></div>
    
    <!-- Partículas Animadas -->
    <div class="absolute top-0 left-1/4 w-2 h-2 bg-neon-cyan rounded-full animate-pulse opacity-40" style="animation-delay: 0s;"></div>
    <div class="absolute top-0 right-1/3 w-1.5 h-1.5 bg-neon-teal rounded-full animate-pulse opacity-40" style="animation-delay: 0.5s;"></div>
    <div class="absolute top-0 left-1/2 w-1 h-1 bg-neon-blue rounded-full animate-pulse opacity-40" style="animation-delay: 1s;"></div>
    
    <!-- Gradiente Sutil -->
    <div class="absolute inset-0 bg-gradient-to-r from-neon-cyan/3 via-transparent to-neon-teal/3"></div>
  </div>

  <!-- Glow Effect on Scroll -->
  <div class="absolute inset-0 bg-gradient-to-r from-neon-cyan/0 via-neon-cyan/3 to-neon-cyan/0 opacity-0 transition-opacity duration-500" id="header-glow"></div>

  <nav class="container mx-auto px-6 py-4 relative z-10">
    <div class="flex items-center justify-between">
      <!-- Logo con Efectos Premium -->
      <a href="/" class="flex items-center space-x-3 group relative">
        <!-- Glow Effect -->
        <div class="absolute -inset-2 bg-neon-cyan/20 rounded-full blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
        
        <div class="relative">
          <img 
            src="/logofreeagents1.png" 
            alt="FreeAgents" 
            class="h-10 w-auto group-hover:scale-110 transition-all duration-300 rounded-full sm:h-8 drop-shadow-lg group-hover:drop-shadow-2xl group-hover:drop-shadow-neon-cyan/50"
          >
          <div class="absolute inset-0 bg-neon-cyan/0 group-hover:bg-neon-cyan/10 rounded-full transition-all duration-300 blur-sm"></div>
        </div>
        
        <span class="font-display font-bold text-xl bg-gradient-to-r from-neon-cyan via-neon-teal to-neon-blue bg-clip-text text-transparent sm:text-lg group-hover:from-neon-teal group-hover:via-neon-blue group-hover:to-neon-cyan transition-all duration-300 relative">
          FreeAgents
          <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-gradient-to-r from-neon-cyan to-neon-teal group-hover:w-full transition-all duration-300"></span>
        </span>
      </a>

      <!-- Desktop Navigation con Efectos Avanzados -->
      <nav class="hidden md:flex items-center space-x-2" aria-label="Navegación principal">
        <a 
          href="/" 
          class={`nav-link group relative px-4 py-2 rounded-lg transition-all duration-300 ${currentPath === '/' ? 'text-neon-cyan' : 'text-gray-300 hover:text-white'}`}
          aria-current={currentPath === '/' ? 'page' : undefined}
        >
          <span class="relative z-10" data-es="Inicio" data-en="Home">Inicio</span>
          <div class={`absolute inset-0 bg-gradient-to-r from-neon-cyan/10 to-neon-teal/10 rounded-lg opacity-0 group-hover:opacity-100 transition-opacity duration-300 ${currentPath === '/' ? 'opacity-100' : ''}`}></div>
          <div class={`absolute bottom-0 left-0 w-0 h-0.5 bg-gradient-to-r from-neon-cyan to-neon-teal group-hover:w-full transition-all duration-300 ${currentPath === '/' ? 'w-full' : ''}`}></div>
        </a>
        
        <a 
          href="/servicios" 
          class={`nav-link group relative px-4 py-2 rounded-lg transition-all duration-300 ${currentPath === '/servicios' ? 'text-neon-cyan' : 'text-gray-300 hover:text-white'}`}
          aria-current={currentPath === '/servicios' ? 'page' : undefined}
        >
          <span class="relative z-10" data-es="Servicios" data-en="Services">Servicios</span>
          <div class={`absolute inset-0 bg-gradient-to-r from-neon-cyan/10 to-neon-teal/10 rounded-lg opacity-0 group-hover:opacity-100 transition-opacity duration-300 ${currentPath === '/servicios' ? 'opacity-100' : ''}`}></div>
          <div class={`absolute bottom-0 left-0 w-0 h-0.5 bg-gradient-to-r from-neon-cyan to-neon-teal group-hover:w-full transition-all duration-300 ${currentPath === '/servicios' ? 'w-full' : ''}`}></div>
        </a>
        
        <a 
          href="/portafolio" 
          class={`nav-link group relative px-4 py-2 rounded-lg transition-all duration-300 ${currentPath === '/portafolio' ? 'text-neon-cyan' : 'text-gray-300 hover:text-white'}`}
          aria-current={currentPath === '/portafolio' ? 'page' : undefined}
        >
          <span class="relative z-10" data-es="Portafolio" data-en="Portfolio">Portafolio</span>
          <div class={`absolute inset-0 bg-gradient-to-r from-neon-cyan/10 to-neon-teal/10 rounded-lg opacity-0 group-hover:opacity-100 transition-opacity duration-300 ${currentPath === '/portafolio' ? 'opacity-100' : ''}`}></div>
          <div class={`absolute bottom-0 left-0 w-0 h-0.5 bg-gradient-to-r from-neon-cyan to-neon-teal group-hover:w-full transition-all duration-300 ${currentPath === '/portafolio' ? 'w-full' : ''}`}></div>
        </a>
        
        <a 
          href="/precios" 
          class={`nav-link group relative px-4 py-2 rounded-lg transition-all duration-300 ${currentPath === '/precios' ? 'text-neon-cyan' : 'text-gray-300 hover:text-white'}`}
          aria-current={currentPath === '/precios' ? 'page' : undefined}
        >
          <span class="relative z-10" data-es="Precios" data-en="Pricing">Precios</span>
          <div class={`absolute inset-0 bg-gradient-to-r from-neon-cyan/10 to-neon-teal/10 rounded-lg opacity-0 group-hover:opacity-100 transition-opacity duration-300 ${currentPath === '/precios' ? 'opacity-100' : ''}`}></div>
          <div class={`absolute bottom-0 left-0 w-0 h-0.5 bg-gradient-to-r from-neon-cyan to-neon-teal group-hover:w-full transition-all duration-300 ${currentPath === '/precios' ? 'w-full' : ''}`}></div>
        </a>
        
        <a 
          href="/nosotros" 
          class={`nav-link group relative px-4 py-2 rounded-lg transition-all duration-300 ${currentPath === '/nosotros' ? 'text-neon-cyan' : 'text-gray-300 hover:text-white'}`}
          aria-current={currentPath === '/nosotros' ? 'page' : undefined}
        >
          <span class="relative z-10" data-es="Nosotros" data-en="About">Nosotros</span>
          <div class={`absolute inset-0 bg-gradient-to-r from-neon-cyan/10 to-neon-teal/10 rounded-lg opacity-0 group-hover:opacity-100 transition-opacity duration-300 ${currentPath === '/nosotros' ? 'opacity-100' : ''}`}></div>
          <div class={`absolute bottom-0 left-0 w-0 h-0.5 bg-gradient-to-r from-neon-cyan to-neon-teal group-hover:w-full transition-all duration-300 ${currentPath === '/nosotros' ? 'w-full' : ''}`}></div>
        </a>
        
        <a 
          href="/fundacion" 
          class={`nav-link group relative px-4 py-2 rounded-lg transition-all duration-300 ${currentPath === '/fundacion' ? 'text-neon-teal' : 'text-gray-300 hover:text-neon-teal'}`}
          aria-current={currentPath === '/fundacion' ? 'page' : undefined}
        >
          <span class="relative z-10" data-es="Fundación" data-en="Foundation">Fundación</span>
          <div class={`absolute inset-0 bg-gradient-to-r from-neon-teal/10 to-neon-green/10 rounded-lg opacity-0 group-hover:opacity-100 transition-opacity duration-300 ${currentPath === '/fundacion' ? 'opacity-100' : ''}`}></div>
          <div class={`absolute bottom-0 left-0 w-0 h-0.5 bg-gradient-to-r from-neon-teal to-neon-green group-hover:w-full transition-all duration-300 ${currentPath === '/fundacion' ? 'w-full' : ''}`}></div>
        </a>
        
        <!-- CTA Button Premium -->
        <a 
          href="/contacto" 
          class="group relative ml-4 px-6 py-2 rounded-full text-white font-medium overflow-hidden transition-all duration-300"
          aria-label="Ir a la página de contacto"
        >
          <!-- Gradient Background -->
          <div class="absolute inset-0 bg-gradient-to-r from-neon-cyan via-neon-teal to-neon-cyan bg-[length:200%_100%] group-hover:animate-shimmer"></div>
          
          <!-- Glow Effect -->
          <div class="absolute inset-0 bg-gradient-to-r from-neon-cyan to-neon-teal opacity-0 group-hover:opacity-100 blur-xl transition-opacity duration-300"></div>
          
          <span class="relative z-10 flex items-center gap-2" data-es="Contacto" data-en="Contact">
            Contacto
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </span>
          
          <!-- Shine Effect -->
          <div class="absolute inset-0 -translate-x-full group-hover:translate-x-full transition-transform duration-700 bg-gradient-to-r from-transparent via-white/20 to-transparent"></div>
        </a>
        
        <!-- Language Selector -->
        <div class="ml-2">
          <LanguageSelector />
        </div>
      </div>

      <!-- Mobile Menu Button Premium -->
      <button 
        id="mobile-menu-btn" 
        class="md:hidden relative p-2 rounded-lg text-gray-300 hover:text-white transition-all duration-300 group focus:outline-none focus:ring-2 focus:ring-neon-cyan/50"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <div class="absolute inset-0 bg-neon-cyan/0 group-hover:bg-neon-cyan/10 rounded-lg transition-all duration-300"></div>
        <svg class="w-7 h-7 relative z-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path id="menu-icon-top" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16"></path>
          <path id="menu-icon-middle" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 12h16"></path>
          <path id="menu-icon-bottom" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 18h16"></path>
        </svg>
      </button>
    </div>

    <!-- Mobile Navigation Premium -->
    <nav 
      id="mobile-menu" 
      class="hidden md:hidden mt-4 pb-4 border-t border-gray-800/50 bg-gray-900/95 backdrop-blur-xl rounded-b-2xl shadow-2xl max-h-[90vh] overflow-y-auto"
      aria-label="Navegación móvil"
    >
      <div class="flex flex-col space-y-2 pt-4">
        <a 
          href="/" 
          class="mobile-link group relative px-4 py-3 rounded-lg text-gray-300 hover:text-white transition-all duration-300"
        >
          <span class="relative z-10 flex items-center gap-3" data-es="Inicio" data-en="Home">
            <div class="w-2 h-2 bg-neon-cyan rounded-full opacity-0 group-hover:opacity-100 transition-opacity"></div>
            Inicio
          </span>
          <div class="absolute inset-0 bg-gradient-to-r from-neon-cyan/10 to-transparent rounded-lg opacity-0 group-hover:opacity-100 transition-opacity"></div>
        </a>
        
        <a 
          href="/servicios" 
          class="mobile-link group relative px-4 py-3 rounded-lg text-gray-300 hover:text-white transition-all duration-300"
        >
          <span class="relative z-10 flex items-center gap-3" data-es="Servicios" data-en="Services">
            <div class="w-2 h-2 bg-neon-cyan rounded-full opacity-0 group-hover:opacity-100 transition-opacity"></div>
            Servicios
          </span>
          <div class="absolute inset-0 bg-gradient-to-r from-neon-cyan/10 to-transparent rounded-lg opacity-0 group-hover:opacity-100 transition-opacity"></div>
        </a>
        
        <a 
          href="/portafolio" 
          class="mobile-link group relative px-4 py-3 rounded-lg text-gray-300 hover:text-white transition-all duration-300"
        >
          <span class="relative z-10 flex items-center gap-3" data-es="Portafolio" data-en="Portfolio">
            <div class="w-2 h-2 bg-neon-cyan rounded-full opacity-0 group-hover:opacity-100 transition-opacity"></div>
            Portafolio
          </span>
          <div class="absolute inset-0 bg-gradient-to-r from-neon-cyan/10 to-transparent rounded-lg opacity-0 group-hover:opacity-100 transition-opacity"></div>
        </a>
        
        <a 
          href="/precios" 
          class="mobile-link group relative px-4 py-3 rounded-lg text-gray-300 hover:text-white transition-all duration-300"
        >
          <span class="relative z-10 flex items-center gap-3" data-es="Precios" data-en="Pricing">
            <div class="w-2 h-2 bg-neon-cyan rounded-full opacity-0 group-hover:opacity-100 transition-opacity"></div>
            Precios
          </span>
          <div class="absolute inset-0 bg-gradient-to-r from-neon-cyan/10 to-transparent rounded-lg opacity-0 group-hover:opacity-100 transition-opacity"></div>
        </a>
        
        <a 
          href="/nosotros" 
          class="mobile-link group relative px-4 py-3 rounded-lg text-gray-300 hover:text-white transition-all duration-300"
        >
          <span class="relative z-10 flex items-center gap-3" data-es="Nosotros" data-en="About">
            <div class="w-2 h-2 bg-neon-cyan rounded-full opacity-0 group-hover:opacity-100 transition-opacity"></div>
            Nosotros
          </span>
          <div class="absolute inset-0 bg-gradient-to-r from-neon-cyan/10 to-transparent rounded-lg opacity-0 group-hover:opacity-100 transition-opacity"></div>
        </a>
        
        <a 
          href="/fundacion" 
          class="mobile-link group relative px-4 py-3 rounded-lg text-gray-300 hover:text-neon-teal transition-all duration-300"
        >
          <span class="relative z-10 flex items-center gap-3" data-es="Fundación" data-en="Foundation">
            <div class="w-2 h-2 bg-neon-teal rounded-full opacity-0 group-hover:opacity-100 transition-opacity"></div>
            Fundación
          </span>
          <div class="absolute inset-0 bg-gradient-to-r from-neon-teal/10 to-transparent rounded-lg opacity-0 group-hover:opacity-100 transition-opacity"></div>
        </a>
        
        <a 
          href="/contacto" 
          class="mobile-link group relative mx-4 mt-2 px-6 py-3 rounded-full text-white font-medium text-center overflow-hidden"
        >
          <div class="absolute inset-0 bg-gradient-to-r from-neon-cyan via-neon-teal to-neon-cyan bg-[length:200%_100%] group-hover:animate-shimmer"></div>
          <span class="relative z-10" data-es="Contacto" data-en="Contact">Contacto</span>
        </a>
        
        <!-- Mobile Language Selector -->
        <div class="pt-4 px-4 border-t border-gray-800/50">
          <LanguageSelector />
        </div>
      </div>
    </div>
  </nav>
</header>

<style>
  @keyframes shimmer {
    0% {
      background-position: -200% 0;
    }
    100% {
      background-position: 200% 0;
    }
  }

  .animate-shimmer {
    animation: shimmer 2s linear infinite;
  }

  /* Header Scroll Effect */
  #main-header {
    transition: all 0.3s ease;
  }

  #main-header.scrolled {
    box-shadow: 0 4px 20px rgba(0, 212, 255, 0.1);
  }

  /* Mobile Menu Animation */
  #mobile-menu {
    animation: slideDown 0.3s ease-out;
  }

  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const mobileLinks = document.querySelectorAll('.mobile-link');
    const header = document.getElementById('main-header');
    const headerGlow = document.getElementById('header-glow');

    // Mobile Menu Toggle
    mobileMenuBtn?.addEventListener('click', () => {
      if (!mobileMenu || !mobileMenuBtn) return;
      
      const isHidden = mobileMenu.classList.contains('hidden');
      mobileMenu.classList.toggle('hidden');
      const isOpen = !mobileMenu.classList.contains('hidden');
      
      // Update ARIA attributes
      mobileMenuBtn.setAttribute('aria-expanded', isOpen.toString());
      mobileMenuBtn.setAttribute('aria-label', isOpen ? 'Cerrar menú de navegación' : 'Abrir menú de navegación');
      
      // Animate hamburger icon
      const iconTop = document.getElementById('menu-icon-top');
      const iconMiddle = document.getElementById('menu-icon-middle');
      const iconBottom = document.getElementById('menu-icon-bottom');
      
      if (isOpen) {
        iconTop?.setAttribute('d', 'M6 18L18 6');
        iconMiddle?.setAttribute('opacity', '0');
        iconBottom?.setAttribute('d', 'M6 6l12 12');
      } else {
        iconTop?.setAttribute('d', 'M4 6h16');
        iconMiddle?.setAttribute('opacity', '1');
        iconBottom?.setAttribute('d', 'M4 18h16');
      }
    });

    // Close mobile menu on link click
    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        if (!mobileMenu || !mobileMenuBtn) return;
        
        mobileMenu.classList.add('hidden');
        mobileMenuBtn.setAttribute('aria-expanded', 'false');
        mobileMenuBtn.setAttribute('aria-label', 'Abrir menú de navegación');
        
        const iconTop = document.getElementById('menu-icon-top');
        const iconMiddle = document.getElementById('menu-icon-middle');
        const iconBottom = document.getElementById('menu-icon-bottom');
        
        iconTop?.setAttribute('d', 'M4 6h16');
        iconMiddle?.setAttribute('opacity', '1');
        iconBottom?.setAttribute('d', 'M4 18h16');
      });
    });

    // Header scroll effect
    let lastScroll = 0;
    window.addEventListener('scroll', () => {
      const currentScroll = window.pageYOffset;
      
      if (currentScroll > 50) {
        header?.classList.add('scrolled');
        headerGlow?.classList.add('opacity-100');
      } else {
        header?.classList.remove('scrolled');
        headerGlow?.classList.remove('opacity-100');
      }
      
      lastScroll = currentScroll;
    });

    // Language switching functionality
    function updateLanguage(lang: string) {
      const elements = document.querySelectorAll('[data-es][data-en]');
      elements.forEach(element => {
        const text = element.getAttribute(`data-${lang}`);
        if (text) {
          element.textContent = text;
        }
      });
    }

    // Initialize language
    const currentLang = localStorage.getItem('language') || 'es';
    updateLanguage(currentLang);

    // Listen for language changes
    window.addEventListener('languageChanged', (e) => {
      const customEvent = e as CustomEvent<{ language: string }>;
      updateLanguage(customEvent.detail.language);
    });
  });
</script>
