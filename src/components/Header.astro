---
const currentPath = Astro.url.pathname;
---

<header class="fixed top-0 w-full z-50 bg-gray-900/80 backdrop-blur-md border-b border-gray-800">
  <nav class="container mx-auto px-6 py-4">
    <div class="flex items-center justify-between">
      <!-- Logo -->
      <a href="/" class="flex items-center space-x-3 group">
        <img src="/Logotipo Neon con Perro y Tecnología.png" alt="FreeAgents" class="h-10 w-auto group-hover:scale-105 transition-transform duration-300">
        <span class="font-display font-bold text-xl bg-gradient-to-r from-neon-blue to-neon-purple bg-clip-text text-transparent">
          FreeAgents
        </span>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center space-x-8">
        <a href="/" class={`hover:text-neon-blue transition-colors duration-300 ${currentPath === '/' ? 'text-neon-blue' : 'text-gray-300'}`}>
          Inicio
        </a>
        <a href="/servicios" class={`hover:text-neon-blue transition-colors duration-300 ${currentPath === '/servicios' ? 'text-neon-blue' : 'text-gray-300'}`}>
          Servicios
        </a>
        <a href="/portafolio" class={`hover:text-neon-blue transition-colors duration-300 ${currentPath === '/portafolio' ? 'text-neon-blue' : 'text-gray-300'}`}>
          Portafolio
        </a>
        <a href="/precios" class={`hover:text-neon-blue transition-colors duration-300 ${currentPath === '/precios' ? 'text-neon-blue' : 'text-gray-300'}`}>
          Precios
        </a>
        <a href="/nosotros" class={`hover:text-neon-blue transition-colors duration-300 ${currentPath === '/nosotros' ? 'text-neon-blue' : 'text-gray-300'}`}>
          Nosotros
        </a>
        <a href="/fundacion" class={`hover:text-neon-purple transition-colors duration-300 ${currentPath === '/fundacion' ? 'text-neon-purple' : 'text-gray-300'}`}>
          Fundación
        </a>
        <a href="/contacto" class="bg-gradient-to-r from-neon-blue to-neon-purple px-6 py-2 rounded-full text-white font-medium hover:shadow-lg hover:shadow-neon-blue/25 transition-all duration-300">
          Contacto
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button id="mobile-menu-btn" class="md:hidden text-gray-300 hover:text-white">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>

    <!-- Mobile Navigation -->
    <div id="mobile-menu" class="hidden md:hidden mt-4 pb-4 border-t border-gray-800">
      <div class="flex flex-col space-y-4 pt-4">
        <a href="/" class="text-gray-300 hover:text-neon-blue transition-colors duration-300">Inicio</a>
        <a href="/servicios" class="text-gray-300 hover:text-neon-blue transition-colors duration-300">Servicios</a>
        <a href="/portafolio" class="text-gray-300 hover:text-neon-blue transition-colors duration-300">Portafolio</a>
        <a href="/precios" class="text-gray-300 hover:text-neon-blue transition-colors duration-300">Precios</a>
        <a href="/nosotros" class="text-gray-300 hover:text-neon-blue transition-colors duration-300">Nosotros</a>
        <a href="/fundacion" class="text-gray-300 hover:text-neon-purple transition-colors duration-300">Fundación</a>
        <a href="/contacto" class="bg-gradient-to-r from-neon-blue to-neon-purple px-6 py-2 rounded-full text-white font-medium text-center">
          Contacto
        </a>
      </div>
    </div>
  </nav>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');

    mobileMenuBtn?.addEventListener('click', () => {
      mobileMenu?.classList.toggle('hidden');
    });
  });
</script>