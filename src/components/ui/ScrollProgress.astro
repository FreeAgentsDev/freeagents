---
/**
 * Componente de indicador de progreso de scroll
 * Muestra una barra de progreso en la parte superior
 */
---

<!-- Scroll Progress Bar - Optimizado para móvil -->
<div 
  id="scroll-progress" 
  class="fixed top-0 left-0 h-0.5 sm:h-1 bg-gradient-to-r from-neon-cyan via-neon-teal to-neon-blue z-[100] transition-all duration-150 ease-out"
  role="progressbar"
  aria-valuemin="0"
  aria-valuemax="100"
  aria-valuenow="0"
  aria-label="Progreso de scroll"
  style="width: 0%; box-shadow: 0 0 10px rgba(0, 212, 255, 0.5);"
></div>

<!-- Back to Top Button - Solo visible después de scroll -->
  <button
    id="back-to-top"
    class="fixed bottom-6 right-6 sm:bottom-8 sm:right-8 z-50 w-12 h-12 sm:w-14 sm:h-14 bg-gradient-to-r from-neon-cyan to-neon-teal rounded-full flex items-center justify-center shadow-2xl hover:shadow-neon-cyan/50 transition-all duration-300 hover:scale-110 active:scale-95 opacity-0 pointer-events-none group focus-visible:outline-2 focus-visible:outline-neon-cyan focus-visible:outline-offset-2"
    aria-label="Volver arriba"
    title="Volver arriba"
  >
    <svg class="w-6 h-6 sm:w-7 sm:h-7 text-white transform group-hover:-translate-y-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
    </svg>
  <!-- Glow effect -->
  <div class="absolute inset-0 rounded-full bg-neon-cyan/30 blur-xl opacity-0 group-hover:opacity-100 transition-opacity"></div>
</button>

<script>
  if (typeof window !== 'undefined') {
    const scrollProgress = document.getElementById('scroll-progress');
    
    if (scrollProgress) {
      const updateScrollProgress = () => {
        const windowHeight = window.innerHeight;
        const documentHeight = document.documentElement.scrollHeight;
        const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
        const scrollableHeight = documentHeight - windowHeight;
        const progress = scrollableHeight > 0 ? (scrollTop / scrollableHeight) * 100 : 0;
        
        scrollProgress.style.width = `${progress}%`;
        scrollProgress.setAttribute('aria-valuenow', Math.round(progress).toString());
      };
      
      // Throttle para mejor performance
      let ticking = false;
      const handleScroll = () => {
        if (!ticking) {
          window.requestAnimationFrame(() => {
            updateScrollProgress();
            ticking = false;
          });
          ticking = true;
        }
      };
      
      window.addEventListener('scroll', handleScroll, { passive: true });
      updateScrollProgress(); // Inicializar
    }
    
    // Back to Top Button
    const backToTopBtn = document.getElementById('back-to-top');
    if (backToTopBtn) {
      const showBackToTop = () => {
        const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
        // Mostrar después de 2 viewports de scroll
        const showThreshold = window.innerHeight * 2;
        
        if (scrollTop > showThreshold) {
          backToTopBtn.classList.remove('opacity-0', 'pointer-events-none');
          backToTopBtn.classList.add('opacity-100', 'pointer-events-auto');
        } else {
          backToTopBtn.classList.add('opacity-0', 'pointer-events-none');
          backToTopBtn.classList.remove('opacity-100', 'pointer-events-auto');
        }
      };
      
      // Throttle para mejor performance
      let tickingBtn = false;
      const handleScrollBtn = () => {
        if (!tickingBtn) {
          window.requestAnimationFrame(() => {
            showBackToTop();
            tickingBtn = false;
          });
          tickingBtn = true;
        }
      };
      
      window.addEventListener('scroll', handleScrollBtn, { passive: true });
      showBackToTop(); // Inicializar
      
      // Smooth scroll al hacer click
      backToTopBtn.addEventListener('click', () => {
        window.scrollTo({
          top: 0,
          behavior: 'smooth'
        });
      });
    }
  }
</script>

