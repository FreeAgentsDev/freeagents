---
/**
 * Componente de sección reutilizable con estructura semántica
 * Mejora accesibilidad y consistencia visual
 */
export interface SectionProps {
  id?: string;
  ariaLabel?: string;
  padding?: 'none' | 'sm' | 'md' | 'lg';
  background?: boolean;
  class?: string;
}

const {
  id,
  ariaLabel,
  padding = 'lg',
  background = false,
  class: className = '',
} = Astro.props;

const paddingMap = {
  none: '',
  sm: 'py-12',
  md: 'py-16',
  lg: 'py-24',
};

const paddingClass = paddingMap[padding];
const backgroundClass = background ? 'relative overflow-hidden' : '';
---

<section
  id={id}
  class={`${paddingClass} ${backgroundClass} ${className}`.trim()}
  aria-label={ariaLabel}
>
  <slot />
</section>

