---
---

<div id="orvi-chat-root" data-orvi-instance="true">
  <!-- Botón flotante profesional con estilo de la página de inicio -->
  <button
    id="orvi-toggle"
    type="button"
    class="orvi-float-button fixed bottom-6 right-6 z-40 flex items-center justify-center w-14 h-14 rounded-full bg-gradient-to-br from-neon-cyan via-neon-teal to-neon-blue backdrop-blur-md border-2 border-neon-cyan/40 hover:border-neon-cyan/60 shadow-2xl hover:shadow-neon-cyan/50 transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-neon-cyan focus:ring-offset-2 focus:ring-offset-gray-900 group animate-bounce-subtle"
    aria-label="Abrir chat con Orvi, asistente virtual de FreeAgents"
    aria-expanded="false"
    aria-controls="orvi-panel"
  >
    <div class="relative w-10 h-10 rounded-full flex items-center justify-center overflow-hidden flex-shrink-0 ring-2 ring-white/30 group-hover:ring-white/50 transition-all shadow-lg shadow-neon-cyan/30">
      <div class="absolute inset-0 bg-gradient-to-br from-white/30 to-transparent rounded-full"></div>
      <img 
        src="/orby.png" 
        alt="Orvi - Asistente IA" 
        class="w-full h-full object-cover rounded-full orby-avatar relative z-10"
        loading="eager"
      />
      <div class="absolute -top-1 -right-1 w-3 h-3 bg-green-400 rounded-full border-2 border-white animate-pulse shadow-lg shadow-green-400/50"></div>
    </div>
    <!-- Indicador de notificación cuando no hay chat activo -->
    <div
      id="orvi-inactive-badge"
      class="absolute -top-1 -right-1 w-5 h-5 bg-red-500 rounded-full border-2 border-white flex items-center justify-center text-white text-xs font-bold animate-pulse hidden shadow-lg"
      aria-label="Nuevo chat disponible"
    >
      <span class="text-[10px]">!</span>
    </div>
  </button>
  
  <!-- Notificación de mensaje nuevo con estilo profesional -->
  <div
    id="orvi-notification"
    class="fixed bottom-32 right-6 z-50 hidden items-center gap-3 px-4 py-3 rounded-2xl bg-gradient-to-br from-neon-cyan via-neon-teal to-neon-blue backdrop-blur-md border-2 border-neon-cyan/40 shadow-2xl shadow-neon-cyan/30 cursor-pointer hover:scale-105 transition-transform max-w-sm"
    style="display: none;"
    role="alert"
    aria-live="polite"
  >
    <div class="relative w-10 h-10 rounded-full flex items-center justify-center overflow-hidden flex-shrink-0 ring-2 ring-white/30 shadow-lg shadow-neon-cyan/30">
      <img 
        src="/orby.png" 
        alt="Orvi - Asistente IA" 
        class="w-full h-full object-cover rounded-full orby-avatar"
        loading="eager"
      />
      <div class="absolute -top-1 -right-1 w-3 h-3 bg-red-500 rounded-full border-2 border-white animate-pulse shadow-lg"></div>
    </div>
    <div class="flex flex-col text-left">
      <span class="text-xs text-cyan-100 font-medium">Nuevo mensaje</span>
      <span class="text-sm font-bold text-white drop-shadow-[0_0_10px_rgba(0,212,255,0.5)]">Orvi te está esperando</span>
    </div>
    <button
      id="orvi-notification-close"
      class="ml-2 p-1 rounded-lg hover:bg-white/20 text-white transition-colors"
      aria-label="Cerrar notificación"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Ventana de chat profesional con estilo de la página de inicio -->
  <div
    id="orvi-panel"
    class="fixed bottom-24 right-4 sm:right-6 z-40 w-[90vw] max-w-sm bg-gradient-to-br from-gray-900/95 via-gray-800/90 to-gray-900/95 backdrop-blur-xl border-2 border-neon-cyan/40 rounded-3xl shadow-2xl overflow-hidden transform translate-y-6 opacity-0 pointer-events-none transition-all duration-500 orvi-panel"
    role="dialog"
    aria-label="Chat con Orvi, asistente virtual"
    aria-modal="true"
    aria-live="polite"
  >
    <!-- Efecto de brillo profesional con colores cyan/teal -->
    <div class="absolute inset-0 rounded-3xl bg-gradient-to-r from-neon-cyan/20 via-neon-teal/20 to-neon-cyan/20 orvi-panel-glow pointer-events-none"></div>
    <div class="absolute inset-0 rounded-3xl bg-gradient-to-br from-neon-cyan/10 via-transparent to-neon-teal/10 orvi-panel-glow-secondary pointer-events-none"></div>
    
    <!-- Patrón de circuitos con colores cyan/teal -->
    <div class="absolute inset-0 rounded-3xl opacity-5 orvi-neural-pattern pointer-events-none" style="background-image: linear-gradient(rgba(0, 212, 255, 0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(20, 184, 166, 0.1) 1px, transparent 1px); background-size: 20px 20px; animation: neural-pulse 4s ease-in-out infinite;"></div>
    
    <!-- Header profesional con estilo de la página de inicio -->
    <div class="relative flex items-center justify-between px-5 py-4 border-b border-neon-cyan/30 bg-gradient-to-r from-gray-800/80 via-gray-800/60 to-gray-800/80 backdrop-blur-sm">
      <!-- Efecto de data stream sutil -->
      <div class="absolute inset-0 bg-gradient-to-r from-transparent via-neon-cyan/5 to-transparent orvi-data-stream pointer-events-none"></div>
      
      <div class="flex items-center gap-3 relative z-10">
        <div class="relative w-10 h-10 rounded-full flex items-center justify-center overflow-hidden flex-shrink-0 ring-2 ring-neon-cyan/50 ring-neon-teal/30 orvi-avatar-glow">
          <div class="absolute inset-0 bg-gradient-to-br from-neon-cyan/30 to-neon-teal/30 rounded-full animate-pulse-slow"></div>
          <div class="absolute inset-0 bg-gradient-to-tr from-transparent via-white/20 to-transparent rounded-full orvi-avatar-shine"></div>
          <img 
            src="/orby.png" 
            alt="Orvi - Asistente IA" 
            class="w-full h-full object-cover rounded-full orby-avatar relative z-10"
            loading="eager"
          />
          <!-- Indicador de IA activa -->
          <div class="absolute -bottom-0.5 -right-0.5 w-3 h-3 bg-green-400 rounded-full border-2 border-gray-900 animate-pulse shadow-lg shadow-green-400/50"></div>
        </div>
        <div class="flex flex-col">
          <span class="text-base font-bold text-white bg-gradient-to-r from-neon-cyan via-neon-teal to-neon-cyan bg-clip-text text-transparent animate-gradient-x drop-shadow-[0_0_10px_rgba(0,212,255,0.5)]">Orvi</span>
          <span class="text-xs text-gray-300 font-medium flex items-center gap-1">
            <span class="w-1.5 h-1.5 bg-green-400 rounded-full animate-pulse shadow-sm shadow-green-400/50"></span>
            Asistente IA
          </span>
        </div>
      </div>
      <div class="flex items-center gap-2 relative z-10">
        <a
          href="/orvy"
          class="p-2 rounded-xl hover:bg-neon-cyan/20 text-gray-400 hover:text-neon-cyan transition-all hover:scale-110"
          aria-label="Abrir vista completa de Orvi"
          title="Vista completa"
          onclick="event.stopPropagation();"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" />
          </svg>
        </a>
        <button
          id="orvi-close"
          type="button"
          class="p-2 rounded-xl hover:bg-neon-cyan/20 text-gray-400 hover:text-neon-cyan transition-all hover:scale-110 hover:rotate-90"
          aria-label="Cerrar chat de Orvi"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mensajes con fondo de IA -->
    <div
      id="orvi-messages"
      class="relative max-h-80 min-h-[200px] overflow-y-auto px-4 py-4 space-y-3 custom-scrollbar orvi-messages-container"
    >
      <!-- Mensaje inicial con animación especial -->
      <div class="flex items-start gap-3 orvi-welcome-message">
        <div class="w-8 h-8 rounded-full flex items-center justify-center overflow-hidden flex-shrink-0 ring-2 ring-neon-cyan/30">
          <div class="absolute inset-0 bg-gradient-to-br from-neon-cyan/20 to-neon-teal/20 rounded-full"></div>
          <img 
            src="/orby.png" 
            alt="Orvi - Asistente IA" 
            class="w-full h-full object-cover rounded-full orby-avatar relative z-10"
            loading="eager"
          />
        </div>
        <div class="relative max-w-[85%] rounded-2xl bg-gradient-to-br from-gray-800/80 via-gray-800/70 to-gray-800/80 backdrop-blur-md border border-neon-cyan/30 px-4 py-3 text-sm leading-relaxed shadow-xl overflow-hidden orvi-message-bubble">
          <!-- Efecto de glow profesional en el mensaje -->
          <div class="absolute inset-0 rounded-2xl bg-gradient-to-r from-neon-cyan/10 via-neon-teal/10 to-neon-cyan/10 blur-xl opacity-60 pointer-events-none"></div>
          
          <p class="text-gray-100 relative z-10 drop-shadow-[0_2px_4px_rgba(0,0,0,0.3)]">
            <span class="orvi-greeting-text inline-block">
              ¡Hola! 👋 Soy <span class="font-bold text-transparent bg-clip-text bg-gradient-to-r from-neon-cyan via-neon-teal to-neon-cyan animate-gradient-x drop-shadow-[0_0_10px_rgba(0,212,255,0.5)]">Orvi</span>, tu consultor de FreeAgents.
            </span>
          </p>
          <p class="mt-2 text-gray-200 orvi-welcome-text relative z-10 drop-shadow-[0_2px_4px_rgba(0,0,0,0.3)]">
            Estoy aquí para entender qué necesita tu negocio y ayudarte a encontrar la mejor solución. ¿Qué desafío o proyecto tienes en mente?
          </p>
          <!-- Efecto de brillo animado sutil -->
          <div class="absolute inset-0 rounded-2xl bg-gradient-to-r from-transparent via-white/5 to-transparent -translate-x-full orvi-message-shine pointer-events-none"></div>
        </div>
      </div>
    </div>

    <!-- Input profesional con estilo de la página de inicio -->
    <form id="orvi-form" class="relative border-t border-neon-cyan/30 px-4 py-3 flex items-center gap-2 bg-gradient-to-r from-gray-900/80 via-gray-800/60 to-gray-900/80 backdrop-blur-sm">
      <!-- Efecto de data stream sutil -->
      <div class="absolute inset-0 bg-gradient-to-r from-transparent via-neon-cyan/3 to-transparent orvi-input-stream pointer-events-none"></div>
      
      <input
        id="orvi-input"
        type="text"
        required
        autocomplete="off"
        placeholder="Escribe tu mensaje..."
        aria-label="Campo de texto para escribir tu pregunta a Orvi"
        aria-required="true"
        class="relative z-10 flex-1 bg-gray-800/80 border-2 border-neon-cyan/30 rounded-xl px-4 py-2.5 text-sm text-gray-100 placeholder-gray-400 focus:outline-none focus:border-neon-cyan/60 focus:bg-gray-800/90 focus:ring-2 focus:ring-neon-cyan/30 focus:shadow-lg focus:shadow-neon-cyan/20 transition-all orvi-input-glow"
      />
      <button
        type="submit"
        id="orvi-send"
        aria-label="Enviar mensaje a Orvi"
        class="relative z-10 flex items-center justify-center w-11 h-11 rounded-xl bg-gradient-to-br from-neon-cyan to-neon-teal hover:from-neon-cyan/90 hover:to-neon-teal/90 text-white shadow-lg hover:shadow-neon-cyan/50 transition-all disabled:opacity-50 disabled:cursor-not-allowed focus:outline-none focus:ring-2 focus:ring-neon-cyan hover:scale-110 active:scale-95 orvi-send-glow"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
        </svg>
      </button>
    </form>
  </div>
</div>

<script>
  (function () {
    // Prevenir múltiples instancias
    if (document.querySelector('[data-orvi-instance="true"]') && window.orviInitialized) {
      return;
    }
    window.orviInitialized = true;
    
    const root = document.getElementById('orvi-chat-root');
    if (!root) return;

    const panel = document.getElementById('orvi-panel');
    const toggle = document.getElementById('orvi-toggle');
    const closeBtn = document.getElementById('orvi-close');
    const form = document.getElementById('orvi-form');
    const input = document.getElementById('orvi-input');
    const messages = document.getElementById('orvi-messages');
    const sendBtn = document.getElementById('orvi-send');
    const notification = document.getElementById('orvi-notification');
    const notificationClose = document.getElementById('orvi-notification-close');
    
    // Debug: verificar que el botón de cerrar existe
    if (!closeBtn) {
      console.error('[Orvi] Error: No se encontró el botón de cerrar (#orvi-close)');
    }

    let isPanelOpen = false;
    let notificationShown = false;
    let notificationTimeout: ReturnType<typeof setTimeout> | null = null;
    let notificationInterval: ReturnType<typeof setInterval> | null = null;
    let hideNotificationTimeout: ReturnType<typeof setTimeout> | null = null;
    let hasActiveChat = false; // Rastrea si hay un chat activo (mensajes intercambiados)
    const inactiveBadge = document.getElementById('orvi-inactive-badge');
    
    // Verificar estado inicial del panel
    if (panel) {
      const computedStyle = window.getComputedStyle(panel);
      isPanelOpen = computedStyle.opacity === '1' && computedStyle.pointerEvents === 'auto';
    }

    function openPanel(e?: Event) {
      if (!panel) return;
      if (e) {
        e.preventDefault();
        e.stopPropagation();
      }
      
      // Prevenir scroll cuando se abre el panel
      const scrollY = window.scrollY;
      const scrollX = window.scrollX;
      
      isPanelOpen = true;
      panel.style.visibility = 'visible';
      panel.style.pointerEvents = 'auto';
      // Aplicar transición suave para la apertura
      panel.style.transition = 'all 0.3s cubic-bezier(0.4, 0, 0.2, 1)';
      // Usar requestAnimationFrame para asegurar que la animación se ejecute
      requestAnimationFrame(() => {
        panel.style.opacity = '1';
        panel.style.transform = 'translateY(0) scale(1)';
      });
      // Asegurar que el panel esté fijo y no se mueva
      panel.style.position = 'fixed';
      panel.style.bottom = '6rem'; // bottom-24 en Tailwind
      panel.style.right = window.innerWidth >= 640 ? '1.5rem' : '1rem';
      panel.style.top = 'auto';
      panel.style.left = 'auto';
      panel.style.margin = '0';
      
      if (toggle) {
        toggle.setAttribute('aria-expanded', 'true');
      }
      // Ocultar notificación si existe
      hideNotification();
      // Cancelar cualquier notificación programada cuando se abre el panel
      if (notificationTimeout) {
        clearTimeout(notificationTimeout);
        notificationTimeout = null;
      }
      // Ocultar badge de inactivo cuando se abre el panel
      if (inactiveBadge) {
        inactiveBadge.classList.add('hidden');
      }
      
      // Mantener posición de scroll inmediatamente y después de un frame
      window.scrollTo(scrollX, scrollY);
      requestAnimationFrame(() => {
        window.scrollTo(scrollX, scrollY);
      });
      
      if (input) {
        setTimeout(() => input.focus(), 200);
      }
    }

    function closePanel() {
      if (!panel) return;
      isPanelOpen = false;
      
      // Asegurar que el input pierda el foco primero
      if (input) {
        input.blur();
      }
      
      // Animación fluida de cierre con scale y fade
      // Usar requestAnimationFrame para asegurar que el navegador procese el cambio
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          panel.style.opacity = '0';
          panel.style.transform = 'translateY(20px) scale(0.95)';
        });
      });
      
      // Deshabilitar interacciones después de que la animación comience
      setTimeout(() => {
        panel.style.pointerEvents = 'none';
        panel.style.visibility = 'hidden';
      }, 100);
      
      if (toggle) {
        toggle.setAttribute('aria-expanded', 'false');
      }
      
      // Verificar si mostrar badge después de cerrar (solo si no hay chat activo)
      setTimeout(() => {
        if (!hasActiveChat) {
          checkInactiveChat();
          // Reiniciar el ciclo de notificaciones si no hay chat activo
          scheduleNextNotification();
        }
      }, 350);
    }
    
    function hideNotification() {
      const notification = document.getElementById('orvi-notification');
      if (notification) {
        notification.style.display = 'none';
        notificationShown = false;
      }
      if (hideNotificationTimeout) {
        clearTimeout(hideNotificationTimeout);
        hideNotificationTimeout = null;
      }
    }
    
    function showNotification() {
      // No mostrar si el panel está abierto o hay un chat activo
      if (isPanelOpen || hasActiveChat) return;
      
      const notification = document.getElementById('orvi-notification');
      if (notification) {
        notificationShown = true;
        notification.style.display = 'flex';
        setTimeout(() => {
          notification.style.animation = 'notificationSlideIn 0.3s ease-out';
        }, 100);
        
        // Ocultar la notificación después de 5 segundos
        hideNotificationTimeout = setTimeout(() => {
          hideNotification();
        }, 5000);
      }
    }
    
    // Mostrar badge de inactivo si no hay chat activo después de cargar
    function checkInactiveChat() {
      // Si ya hay un chat activo, no mostrar el badge
      if (hasActiveChat || !inactiveBadge) return;
      
      // Contar mensajes del usuario (excluyendo el mensaje de bienvenida)
      const userMessages = messages?.querySelectorAll('.flex.items-start.gap-2.justify-end');
      
      // Si no hay mensajes del usuario y el panel está cerrado, mostrar badge de inactivo
      if ((!userMessages || userMessages.length === 0) && !isPanelOpen) {
        inactiveBadge.classList.remove('hidden');
      } else {
        inactiveBadge.classList.add('hidden');
      }
    }
    
    // Verificar estado inicial después de que la página cargue
    setTimeout(() => {
      checkInactiveChat();
    }, 1500);
    
    // Función para programar la próxima notificación
    function scheduleNextNotification() {
      // Limpiar cualquier timeout anterior
      if (notificationTimeout) {
        clearTimeout(notificationTimeout);
      }
      
      // Mostrar notificación después de 4 minutos (240000 ms)
      notificationTimeout = setTimeout(() => {
        if (!isPanelOpen && !hasActiveChat) {
          showNotification();
        }
        // Programar la siguiente notificación
        scheduleNextNotification();
      }, 240000); // 4 minutos
    }
    
    // Mostrar primera notificación después de 5 segundos
    notificationTimeout = setTimeout(() => {
      if (!isPanelOpen && !hasActiveChat) {
        showNotification();
      }
      // Programar la siguiente notificación
      scheduleNextNotification();
    }, 5000);

    function appendMessage(text, from) {
      if (!messages) return;
      
      // Marcar que hay un chat activo cuando se envía o recibe un mensaje
      if (from === 'user' || from === 'orvi') {
        hasActiveChat = true;
        // Ocultar badge de inactivo cuando hay chat activo
        if (inactiveBadge) {
          inactiveBadge.classList.add('hidden');
        }
        // Ocultar notificación y cancelar timeouts cuando hay chat activo
        hideNotification();
        if (notificationTimeout) {
          clearTimeout(notificationTimeout);
          notificationTimeout = null;
        }
      }
      
      const wrapper = document.createElement('div');
      wrapper.className = 'flex items-start gap-2 ' + (from === 'user' ? 'justify-end' : '');

      if (from === 'user') {
        const bubble = document.createElement('div');
        bubble.className =
          'relative max-w-[85%] rounded-2xl bg-gradient-to-br from-neon-cyan/40 to-neon-teal/40 border border-neon-cyan/40 px-4 py-3 text-sm text-white leading-relaxed shadow-xl animate-message-in orvi-user-message';
        // Efecto de glow profesional en mensajes del usuario
        const glow = document.createElement('div');
        glow.className = 'absolute inset-0 rounded-2xl bg-gradient-to-r from-neon-cyan/15 via-neon-teal/15 to-neon-cyan/15 blur-xl opacity-60 pointer-events-none';
        bubble.appendChild(glow);
        const textNode = document.createElement('span');
        textNode.className = 'relative z-10 drop-shadow-[0_2px_4px_rgba(0,0,0,0.3)]';
        textNode.textContent = text;
        bubble.appendChild(textNode);
        wrapper.appendChild(bubble);
      } else {
        const avatar = document.createElement('div');
        avatar.className =
          'w-6 h-6 rounded-full flex items-center justify-center overflow-hidden flex-shrink-0 ring-2 ring-neon-cyan/40';
        const avatarGlow = document.createElement('div');
        avatarGlow.className = 'absolute inset-0 bg-gradient-to-br from-neon-cyan/20 to-neon-teal/20 rounded-full';
        avatar.appendChild(avatarGlow);
        const img = document.createElement('img');
        img.src = '/orby.png';
        img.alt = 'Orvi - Asistente IA';
        img.className = 'w-full h-full object-cover rounded-full orby-avatar relative z-10';
        avatar.appendChild(img);

        const bubble = document.createElement('div');
        bubble.className =
          'relative max-w-[85%] rounded-2xl bg-gradient-to-br from-gray-800/80 via-gray-800/70 to-gray-800/80 backdrop-blur-md border border-neon-cyan/30 px-4 py-3 text-sm text-gray-200 leading-relaxed whitespace-pre-wrap shadow-xl animate-message-in orvi-message-bubble';
        // Efecto de glow profesional en mensajes de Orvi
        const glow = document.createElement('div');
        glow.className = 'absolute inset-0 rounded-2xl bg-gradient-to-r from-neon-cyan/10 via-neon-teal/10 to-neon-cyan/10 blur-xl opacity-60 pointer-events-none';
        bubble.appendChild(glow);
        const textNode = document.createElement('span');
        textNode.className = 'relative z-10 drop-shadow-[0_2px_4px_rgba(0,0,0,0.3)]';
        textNode.textContent = text;
        bubble.appendChild(textNode);

        wrapper.appendChild(avatar);
        wrapper.appendChild(bubble);
      }

      messages.appendChild(wrapper);
      messages.scrollTop = messages.scrollHeight;
    }

    async function sendMessage(message: string) {
      if (!sendBtn || !messages) return;
      sendBtn.disabled = true;
      const typingId = 'orvi-typing';

      const typing = document.createElement('div');
      typing.id = typingId;
      typing.className = 'flex items-start gap-2';
      typing.innerHTML = `
        <div class="w-6 h-6 rounded-full flex items-center justify-center overflow-hidden flex-shrink-0">
          <img src="/orby.png" alt="Orvi - Asistente IA" class="w-full h-full object-cover rounded-full orby-avatar" />
        </div>
        <div class="max-w-[85%] rounded-xl bg-gray-800/60 px-3 py-2 text-sm text-gray-300">
          <span class="inline-flex gap-1 items-center">
            <span class="w-1.5 h-1.5 rounded-full bg-gray-400 animate-pulse"></span>
            <span class="w-1.5 h-1.5 rounded-full bg-gray-400/70 animate-pulse" style="animation-delay: 0.15s;"></span>
            <span class="w-1.5 h-1.5 rounded-full bg-gray-400/50 animate-pulse" style="animation-delay: 0.3s;"></span>
          </span>
        </div>
      `;
      messages.appendChild(typing);
      messages.scrollTop = messages.scrollHeight;

      try {
        const lang = (localStorage.getItem('language') || 'es');
        console.log('[Orvi] Enviando mensaje al backend...', {
          message,
          pageUrl: window.location.pathname,
        });

        const res = await fetch('/api/orvi', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            message,
            pageUrl: window.location.pathname,
            language: lang,
          }),
        });

        let data = {};
        try {
          data = await res.json();
        } catch (err) {
          console.error('[Orvi] No se pudo parsear la respuesta JSON de /api/orvi:', err);
        }

        console.log('[Orvi] Respuesta de /api/orvi:', {
          ok: res.ok,
          status: res.status,
          data,
        });

        const typingEl = document.getElementById(typingId);
        if (typingEl) typingEl.remove();

        if (!res.ok || !data?.reply) {
          let errorText =
            (data && data.error) ||
            'Ahora mismo no puedo responder correctamente. Intenta de nuevo en unos segundos o contáctanos por la página de contacto.';

          if (data && data.providerMessage) {
            errorText += '\n\nDetalle técnico:\n' + data.providerMessage;
          }

          appendMessage(errorText, 'orvi');
        } else {
          appendMessage(data.reply, 'orvi');
        }
      } catch (e) {
        console.error('Orvi client error', e);
        document.getElementById(typingId)?.remove();
        appendMessage(
          'Hubo un problema al conectar con Orvi. Por favor, intenta de nuevo más tarde o usa el formulario de contacto.',
          'orvi'
        );
      } finally {
        sendBtn.disabled = false;
      }
    }

    toggle?.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      e.stopImmediatePropagation();
      if (!panel) return;
      
      // Guardar posición de scroll actual
      const scrollY = window.scrollY;
      
      const computedStyle = window.getComputedStyle(panel);
      const isOpen = computedStyle.opacity === '1' && computedStyle.pointerEvents === 'auto';
      if (isOpen) {
        closePanel();
      } else {
        openPanel(e);
      }
      
      // Prevenir scroll - mantener posición
      requestAnimationFrame(() => {
        window.scrollTo(window.scrollX, scrollY);
      });
      
      return false;
    });

    if (closeBtn) {
      closeBtn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        e.stopImmediatePropagation();
        closePanel();
        return false;
      }, true); // Usar capture phase para asegurar que se ejecute
    } else {
      console.error('[Orvi] Error: No se pudo encontrar el botón de cerrar');
    }

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!input) return;
      const value = input.value.trim();
      if (!value) return;

      appendMessage(value, 'user');
      input.value = '';
      sendMessage(value);
    });
    
    // Cerrar notificación
    notificationClose?.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      hideNotification();
    });
    
    // Abrir panel al hacer clic en la notificación
    notification?.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      if (e.target !== notificationClose && !notificationClose?.contains(e.target as Node)) {
        openPanel(e);
      }
    });
    
    // Exponer función openPanel globalmente para que el Header pueda usarla
    (window as any).openOrviChat = () => {
      openPanel();
    };
  })();
</script>

