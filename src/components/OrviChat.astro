---
---

<div id="orvi-chat-root">
  <!-- Botón flotante -->
  <button
    id="orvi-toggle"
    class="fixed bottom-6 right-6 z-40 flex items-center gap-2 px-4 py-3 rounded-full bg-gradient-to-r from-neon-cyan to-neon-purple shadow-lg shadow-neon-cyan/40 border border-neon-cyan/60 hover:scale-105 hover:shadow-neon-purple/50 transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-neon-cyan focus:ring-offset-2 focus:ring-offset-gray-900"
    aria-label="Abrir chat con Orvi, asistente virtual de FreeAgents"
    aria-expanded="false"
    aria-controls="orvi-panel"
  >
    <div class="relative w-9 h-9 rounded-full bg-gray-900/80 border border-neon-cyan/60 flex items-center justify-center overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-br from-neon-cyan/40 via-neon-purple/40 to-neon-teal/40 opacity-60"></div>
      <span class="relative font-display text-lg font-bold text-white">O</span>
    </div>
    <div class="hidden sm:flex flex-col text-left">
      <span class="text-xs uppercase tracking-wide text-neon-cyan/90">Asistente IA</span>
      <span class="text-sm font-semibold text-white">Orvi está en línea</span>
    </div>
  </button>

  <!-- Ventana de chat -->
  <div
    id="orvi-panel"
    class="fixed bottom-24 right-4 sm:right-6 z-40 w-[90vw] max-w-sm bg-gray-900/95 border border-neon-cyan/40 rounded-2xl shadow-2xl shadow-neon-cyan/30 backdrop-blur-xl overflow-hidden transform translate-y-6 opacity-0 pointer-events-none transition-all duration-300"
    role="dialog"
    aria-label="Chat con Orvi, asistente virtual"
    aria-modal="true"
    aria-live="polite"
  >
    <!-- Header -->
    <div class="flex items-center justify-between px-4 py-3 border-b border-gray-700/70 bg-gradient-to-r from-gray-900/90 via-gray-900/80 to-gray-900/90">
      <div class="flex items-center gap-3">
        <div class="relative w-9 h-9 rounded-full bg-gray-900/80 border border-neon-cyan/60 flex items-center justify-center overflow-hidden">
          <div class="absolute inset-0 bg-gradient-to-br from-neon-cyan/40 via-neon-purple/40 to-neon-teal/40 opacity-70 animate-pulse"></div>
          <span class="relative font-display text-lg font-bold text-white">O</span>
        </div>
        <div class="flex flex-col">
          <span class="text-sm font-semibold text-white">Orvi</span>
          <span class="text-xs text-neon-cyan/80">Asistente IA de FreeAgents</span>
        </div>
      </div>
      <button
        id="orvi-close"
        class="p-1.5 rounded-full hover:bg-gray-800/80 text-gray-400 hover:text-white transition-colors"
        aria-label="Cerrar chat de Orvi"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Mensajes -->
    <div
      id="orvi-messages"
      class="max-h-80 min-h-[220px] overflow-y-auto px-4 py-3 space-y-3 custom-scrollbar"
    >
      <div class="flex items-start gap-2">
        <div class="w-7 h-7 rounded-full bg-gradient-to-br from-neon-cyan to-neon-purple flex items-center justify-center text-xs font-bold text-white">
          O
        </div>
        <div class="max-w-[80%] rounded-2xl bg-gray-800/90 border border-neon-cyan/40 px-3 py-2 text-sm text-gray-100">
          <p>
            ¡Hola! Soy <span class="font-semibold text-neon-cyan">Orvi</span>, el asistente IA de FreeAgents.
            Puedo ayudarte a entender nuestros servicios, planes y a guiarte al mejor siguiente paso.
          </p>
        </div>
      </div>
    </div>

    <!-- Input -->
    <form id="orvi-form" class="border-t border-gray-700/70 bg-gray-900/90 px-3 py-2 flex items-center gap-2">
      <input
        id="orvi-input"
        type="text"
        required
        autocomplete="off"
        placeholder="Escribe tu pregunta para Orvi..."
        aria-label="Campo de texto para escribir tu pregunta a Orvi"
        aria-required="true"
        class="flex-1 bg-gray-800/80 border border-gray-700 rounded-full px-3 py-2 text-sm text-gray-100 placeholder-gray-500 focus:outline-none focus:border-neon-cyan focus:ring-2 focus:ring-neon-cyan focus:ring-offset-2 focus:ring-offset-gray-900"
      />
      <button
        type="submit"
        id="orvi-send"
        aria-label="Enviar mensaje a Orvi"
        class="flex items-center justify-center w-9 h-9 rounded-full bg-gradient-to-r from-neon-cyan to-neon-teal text-white hover:scale-105 transition-transform disabled:opacity-50 disabled:cursor-not-allowed focus:outline-none focus:ring-2 focus:ring-neon-cyan focus:ring-offset-2 focus:ring-offset-gray-900"
        aria-label="Enviar mensaje a Orvi"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M12 5l7 7-7 7" />
        </svg>
      </button>
    </form>
  </div>
</div>

<script>
  (function () {
    const root = document.getElementById('orvi-chat-root');
    if (!root) return;

    const panel = document.getElementById('orvi-panel');
    const toggle = document.getElementById('orvi-toggle');
    const closeBtn = document.getElementById('orvi-close');
    const form = document.getElementById('orvi-form');
    const input = document.getElementById('orvi-input');
    const messages = document.getElementById('orvi-messages');
    const sendBtn = document.getElementById('orvi-send');

    function openPanel() {
      if (!panel) return;
      panel.style.opacity = '1';
      panel.style.transform = 'translateY(0)';
      panel.style.pointerEvents = 'auto';
      if (input) {
        setTimeout(() => input.focus(), 200);
      }
    }

    function closePanel() {
      if (!panel) return;
      panel.style.opacity = '0';
      panel.style.transform = 'translateY(12px)';
      panel.style.pointerEvents = 'none';
    }

    function appendMessage(text, from) {
      if (!messages) return;
      const wrapper = document.createElement('div');
      wrapper.className = 'flex items-start gap-2 ' + (from === 'user' ? 'justify-end' : '');

      if (from === 'user') {
        const bubble = document.createElement('div');
        bubble.className =
          'max-w-[80%] rounded-2xl bg-gradient-to-r from-neon-cyan/80 to-neon-purple/80 px-3 py-2 text-sm text-white';
        bubble.textContent = text;
        wrapper.appendChild(bubble);
      } else {
        const avatar = document.createElement('div');
        avatar.className =
          'w-7 h-7 rounded-full bg-gradient-to-br from-neon-cyan to-neon-purple flex items-center justify-center text-xs font-bold text-white';
        avatar.textContent = 'O';

        const bubble = document.createElement('div');
        bubble.className =
          'max-w-[80%] rounded-2xl bg-gray-800/90 border border-neon-cyan/40 px-3 py-2 text-sm text-gray-100 whitespace-pre-wrap';
        bubble.textContent = text;

        wrapper.appendChild(avatar);
        wrapper.appendChild(bubble);
      }

      messages.appendChild(wrapper);
      messages.scrollTop = messages.scrollHeight;
    }

    async function sendMessage(message: string) {
      if (!sendBtn || !messages) return;
      sendBtn.disabled = true;
      const typingId = 'orvi-typing';

      const typing = document.createElement('div');
      typing.id = typingId;
      typing.className = 'flex items-start gap-2';
      typing.innerHTML = `
        <div class="w-7 h-7 rounded-full bg-gradient-to-br from-neon-cyan to-neon-purple flex items-center justify-center text-xs font-bold text-white">O</div>
        <div class="max-w-[80%] rounded-2xl bg-gray-800/90 border border-neon-cyan/40 px-3 py-2 text-sm text-gray-300">
          <span class="inline-flex gap-1 items-center">
            <span class="w-1.5 h-1.5 rounded-full bg-neon-cyan animate-pulse"></span>
            <span class="w-1.5 h-1.5 rounded-full bg-neon-cyan/70 animate-pulse" style="animation-delay: 0.15s;"></span>
            <span class="w-1.5 h-1.5 rounded-full bg-neon-cyan/50 animate-pulse" style="animation-delay: 0.3s;"></span>
          </span>
        </div>
      `;
      messages.appendChild(typing);
      messages.scrollTop = messages.scrollHeight;

      try {
        const lang = (localStorage.getItem('language') || 'es');
        console.log('[Orvi] Enviando mensaje al backend...', {
          message,
          pageUrl: window.location.pathname,
        });

        const res = await fetch('/api/orvi', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            message,
            pageUrl: window.location.pathname,
            language: lang,
          }),
        });

        let data = {};
        try {
          data = await res.json();
        } catch (err) {
          console.error('[Orvi] No se pudo parsear la respuesta JSON de /api/orvi:', err);
        }

        console.log('[Orvi] Respuesta de /api/orvi:', {
          ok: res.ok,
          status: res.status,
          data,
        });

        const typingEl = document.getElementById(typingId);
        if (typingEl) typingEl.remove();

        if (!res.ok || !data?.reply) {
          let errorText =
            (data && data.error) ||
            'Ahora mismo no puedo responder correctamente. Intenta de nuevo en unos segundos o contáctanos por la página de contacto.';

          if (data && data.providerMessage) {
            errorText += '\n\nDetalle técnico:\n' + data.providerMessage;
          }

          appendMessage(errorText, 'orvi');
        } else {
          appendMessage(data.reply, 'orvi');
        }
      } catch (e) {
        console.error('Orvi client error', e);
        document.getElementById(typingId)?.remove();
        appendMessage(
          'Hubo un problema al conectar con Orvi. Por favor, intenta de nuevo más tarde o usa el formulario de contacto.',
          'orvi'
        );
      } finally {
        sendBtn.disabled = false;
      }
    }

    toggle?.addEventListener('click', () => {
      if (!panel) return;
      const isOpen = panel.style.opacity === '1';
      if (isOpen) {
        closePanel();
      } else {
        openPanel();
      }
    });

    closeBtn?.addEventListener('click', () => {
      closePanel();
    });

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!input) return;
      const value = input.value.trim();
      if (!value) return;

      appendMessage(value, 'user');
      input.value = '';
      sendMessage(value);
    });
  })();
</script>


